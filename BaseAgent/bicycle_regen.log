[round 6] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Box,\n    Cylinder,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    TireGeometry,\n    TireSidewall,\n    TireTread,\n    WheelBore,\n    WheelFace,\n    WheelGeometry,\n    WheelHub,\n    WheelRim,\n    WheelSpokes,\n    mesh_from_geometry,\n    tube_from_spline_points,\n)\n\n# ---------------------------------------------------------------------------\n# Global placement: author the bicycle at natural size in y-up / +z-forward,\n# then shift the whole assembly so its box centre lands on the layout target.\n# Only ROOT-part visuals and depth-1 articulation origins carry the offset;\n# child parts are authored in their parent-local frames.\n# ---------------------------------------------------------------------------\nOX, OY, OZ = 4.8, 0.0, 2.495\n\n# ---- key design points (metres, y-up / +z forward) -------------------------\nR_TIRE = 0.34\nTIRE_W = 0.038\n\nFRONT_AXLE = (0.0, 0.34, 0.53)\nREAR_AXLE = (0.0, 0.34, -0.52)\nBB = (0.0, 0.27, -0.09)           # bottom bracket centre\nCLUSTER = (0.0, 0.76, -0.25)      # seat tube top / seat cluster\nHEAD_BOT = (0.0, 0.56, 0.40)\nHEAD_TOP = (0.0, 0.78, 0.34)\nSTEER_TOP = (0.0, 0.86, 0.30)\n\nP_STEER = HEAD_BOT                # frame->fork pivot on the steering axis\nDS = (0.0, 0.22, -0.06)           # steering axis direction (up, tilted back)\nDS_SEAT = (CLUSTER[0] - BB[0], CLUSTER[1] - BB[1], CLUSTER[2] - BB[2])\n\n\ndef _norm(v):\n    l = math.sqrt(v[0] ** 2 + v[1] ** 2 + v[2] ** 2)\n    return (v[0] / l, v[1] / l, v[2] / l)\n\n\ndef _sub(a, b):\n    return (a[0] - b[0], a[1] - b[1], a[2] - b[2])\n\n\nDS_N = _norm(DS)\nDS_SEAT_N = _norm(DS_SEAT)\n\n\ndef _mesh(name, geom):\n    return mesh_from_geometry(geom, name)\n\n\ndef _tube(name, points, radius, offset=False, closed=False, sps=10, rs=14):\n    if offset:\n        points = [(p[0] + OX, p[1] + OY, p[2] + OZ) for p in points]\n    return _mesh(\n        name,\n        tube_from_spline_points(\n            points,\n            radius=radius,\n            samples_per_segment=sps,\n            radial_segments=rs,\n            closed_spline=closed,\n            cap_ends=not closed,\n        ),\n    )\n\n\ndef _cyl_x(radius, length):\n    return Cylinder(radius=radius, length=length)\n\n\ndef _add_wheel_visuals(part, prefix, steel, rubber, with_cog=False):\n    part.visual(\n        _mesh(\n            prefix + \"_rim\",\n            WheelGeometry(\n                0.300,\n                0.050,\n                rim=WheelRim(inner_radius=0.240, flange_height=0.008, flange_thickness=0.003),\n                hub=WheelHub(radius=0.028, width=0.050, cap_style=\"domed\"),\n                face=WheelFace(dish_depth=0.004),\n                spokes=WheelSpokes(style=\"straight\", count=24, thickness=0.002, window_radius=0.004),\n                bore=WheelBore(style=\"round\", diameter=0.012),\n            ),\n        ),\n        material=steel,\n        name=\"rim\",\n    )\n    part.visual(\n        _mesh(\n            prefix + \"_tire\",\n            TireGeometry(\n                R_TIRE,\n                TIRE_W,\n                inner_radius=0.300,\n                tread=TireTread(style=\"circumferential\", depth=0.003, count=6),\n                sidewall=TireSidewall(style=\"rounded\", bulge=0.05),\n            ),\n        ),\n        material=rubber,\n        name=\"tire\",\n    )\n    # through-axle stub reaching the dropouts at x = +/-0.045\n    part.visual(_cyl_x(0.006, 0.090), origin=Origin(rpy=(0.0, math.pi / 2.0, 0.0)), material=steel, name=\"axle\")\n    if with_cog:\n        # rear freewheel body + drive cog on the drive side (+x)\n        part.visual(_cyl_x(0.020, 0.060), origin=Origin(xyz=(0.050, 0.0, 0.0), rpy=(0.0, math.pi / 2.0, 0.0)), material=steel, name=\"freewheel\")\n        part.visual(_cyl_x(0.045, 0.004), origin=Origin(xyz=(0.065, 0.0, 0.0), rpy=(0.0, math.pi / 2.0, 0.0)), material=steel, name=\"cog\")\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"bicycle\")\n\n    frame_paint = model.material(\"frame_paint\", rgba=(0.09, 0.20, 0.42, 1.0))\n    steel = model.material(\"steel\", rgba=(0.72, 0.74, 0.78, 1.0))\n    rubber = model.material(\"rubber\", rgba=(0.05, 0.05, 0.06, 1.0))\n    saddle_vinyl = model.material(\"saddle_vinyl\", rgba=(0.10, 0.10, 0.11, 1.0))\n    chain_steel = model.material(\"chain_steel\", rgba=(0.22, 0.23, 0.25, 1.0))\n\n    # =====================================================================\n    # FRAME (root)\n    # =====================================================================\n    frame = model.part(\"frame\")\n    FR = True  # offset flag for root visuals\n\n    frame.visual(_tube(\"frame_down_tube\", [BB, HEAD_BOT], 0.017, offset=FR), material=frame_paint, name=\"down_tube\")\n    frame.visual(_tube(\"frame_seat_tube\", [BB, CLUSTER], 0.016, offset=FR), material=frame_paint, name=\"seat_tube\")\n    frame.visual(_tube(\"frame_top_tube\", [(0.0, 0.72, -0.24), (0.0, 0.76, 0.36)], 0.016, offset=FR), material=frame_paint, name=\"top_tube\")\n    frame.visual(_tube(\"frame_head_tube\", [HEAD_BOT, HEAD_TOP], 0.021, offset=FR), material=frame_paint, name=\"head_tube\")\n    # chainstays\n    frame.visual(_tube(\"frame_chainstay_l\", [(0.02, 0.27, -0.10), (0.045, 0.34, -0.52)], 0.011, offset=FR), material=frame_paint, name=\"chainstay_l\")\n    frame.visual(_tube(\"frame_chainstay_r\", [(-0.02, 0.27, -0.10), (-0.045, 0.34, -0.52)], 0.011, offset=FR), material=frame_paint, name=\"chainstay_r\")\n    # seatstays\n    frame.visual(_tube(\"frame_seatstay_l\", [(0.012, 0.74, -0.25), (0.045, 0.34, -0.52)], 0.010, offset=FR), material=frame_paint, name=\"seatstay_l\")\n    frame.visual(_tube(\"frame_seatstay_r\", [(-0.012, 0.74, -0.25), (-0.045, 0.34, -0.52)], 0.010, offset=FR), material=frame_paint, name=\"seatstay_r\")\n    # bottom bracket shell (axis X)\n    frame.visual(_cyl_x(0.024, 0.090), origin=Origin(xyz=(BB[0] + OX, BB[1] + OY, BB[2] + OZ), rpy=(0.0, math.pi / 2.0, 0.0)), material=frame_paint, name=\"bb_shell\")\n    # rear dropouts\n    frame.visual(Box((0.012, 0.055, 0.055)), origin=Origin(xyz=(0.051 + OX, 0.34 + OY, -0.52 + OZ)), material=frame_paint, name=\"rear_dropout_l\")\n    frame.visual(Box((0.012, 0.055, 0.055)), origin=Origin(xyz=(-0.051 + OX, 0.34 + OY, -0.52 + OZ)), material=frame_paint, name=\"rear_dropout_r\")\n\n    # =====================================================================\n    # FORK  (child of frame, steers about head-tube axis)\n    # =====================================================================\n    fork = model.part(\"fork\")\n    FL = False\n\n    def fp(p):\n        return _sub(p, P_STEER)\n\n    # steerer tube running up through the head tube and above it\n    frame_c = fp((0.0, 0.53, 0.404))\n    steer_top_l = fp(STEER_TOP)\n    fork.visual(_tube(\"fork_steerer\", [frame_c, steer_top_l], 0.014, offset=FL), material=steel, name=\"steerer\")\n    # crown\n    fork.visual(Box((0.100, 0.034, 0.05)), origin=Origin(xyz=(0.0, -0.01, 0.004)), material=frame_paint, name=\"crown\")\n    # blades (curving forward then down to the dropouts)\n    blade_l = [fp(p) for p in [\n        (0.032, 0.545, 0.402),\n        (0.048, 0.500, 0.415),\n        (0.052, 0.440, 0.455),\n        (0.050, 0.380, 0.505),\n        (0.045, 0.340, 0.530),\n    ]]\n    fork.visual(_tube(\"fork_blade_l\", blade_l, 0.012, offset=FL, sps=10), material=frame_paint, name=\"blade_l\")\n    blade_r = [fp(p) for p in [\n        (-0.032, 0.545, 0.402),\n        (-0.048, 0.500, 0.415),\n        (-0.052, 0.440, 0.455),\n        (-0.050, 0.380, 0.505),\n        (-0.045, 0.340, 0.530),\n    ]]\n    fork.visual(_tube(\"fork_blade_r\", blade_r, 0.012, offset=FL, sps=10), material=frame_paint, name=\"blade_r\")\n    # front dropouts\n    fork.visual(Box((0.012, 0.05, 0.05)), origin=Origin(xyz=tuple(x for x in fp((0.051, 0.34, 0.53)))), material=frame_paint, name=\"front_dropout_l\")\n    fork.visual(Box((0.012, 0.05, 0.05)), origin=Origin(xyz=tuple(x for x in fp((-0.051, 0.34, 0.53)))), material=frame_paint, name=\"front_dropout_r\")\n\n    # =====================================================================\n    # HANDLEBAR  (child of fork, fixed; steers with the fork)\n    # =====================================================================\n    handlebar = model.part(\"handlebar\")\n\n    def hp(p):\n        return _sub(p, STEER_TOP)\n\n    stem_top = hp((0.0, 0.91, 0.36))\n    handlebar.visual(_tube(\"hb_stem\", [(0.0, 0.0, 0.0), stem_top], 0.016, offset=False), material=steel, name=\"stem\")\n    bar_pts = [hp(p) for p in [\n        (-0.26, 0.905, 0.345),\n        (-0.18, 0.913, 0.360),\n        (-0.06, 0.917, 0.370),\n        (0.06, 0.917, 0.370),\n        (0.18, 0.913, 0.360),\n        (0.26, 0.905, 0.345),\n    ]]\n    handlebar.visual(_tube(\"hb_bar\", bar_pts, 0.012, offset=False, sps=8, rs=16), material=steel, name=\"bar\")\n    grip_l = hp((-0.225, 0.906, 0.350))\n    grip_r = hp((0.225, 0.906, 0.350))\n    handlebar.visual(_cyl_x(0.015, 0.075), origin=Origin(xyz=grip_l, rpy=(0.0, math.pi / 2.0, 0.0)), material=rubber, name=\"grip_l\")\n    handlebar.visual(_cyl_x(0.015, 0.075), origin=Origin(xyz=grip_r, rpy=(0.0, math.pi / 2.0, 0.0)), material=rubber, name=\"grip_r\")\n\n    # =====================================================================\n    # FRONT WHEEL (child of fork)\n    # =====================================================================\n    front_wheel = model.part(\"front_wheel\")\n    _add_wheel_visuals(front_wheel, \"front\", steel, rubber, with_cog=False)\n\n    # =====================================================================\n    # REAR WHEEL (child of frame)\n    # =====================================================================\n    rear_wheel = model.part(\"rear_wheel\")\n    _add_wheel_visuals(rear_wheel, \"rear\", steel, rubber, with_cog=True)\n\n    # =====================================================================\n    # SEATPOST (child of frame, prismatic up the seat tube) + SADDLE\n    # =====================================================================\n    seatpost = model.part(\"seatpost\")\n    sp_bottom = (-0.07 * DS_SEAT_N[0], -0.07 * DS_SEAT_N[1], -0.07 * DS_SEAT_N[2])\n    sp_top = (0.18 * DS_SEAT_N[0], 0.18 * DS_SEAT_N[1], 0.18 * DS_SEAT_N[2])\n    seatpost.visual(_tube(\"seatpost_tube\", [sp_bottom, sp_top], 0.0135, offset=False, sps=6), material=steel, name=\"post\")\n\n    saddle = model.part(\"saddle\")\n    # clamp sits on the seatpost top plane (y_local = 0)\n    saddle.visual(Box((0.032, 0.032, 0.060)), origin=Origin(xyz=(0.0, 0.016, 0.0)), material=saddle_vinyl, name=\"clamp\")\n    # rails\n    saddle.visual(_tube(\"saddle_rail_l\", [(0.026, 0.012, -0.05), (0.050, 0.040, 0.08)], 0.005, offset=False, sps=6, rs=10), material=steel, name=\"rail_l\")\n    saddle.visual(_tube(\"saddle_rail_r\", [(-0.026, 0.012, -0.05), (-0.050, 0.040, 0.08)], 0.005, offset=False, sps=6, rs=10), material=steel, name=\"rail_r\")\n    # seat body (rear) + nose (front, +z)\n    saddle.visual(Box((0.135, 0.040, 0.150)), origin=Origin(xyz=(0.0, 0.052, -0.03)), material=saddle_vinyl, name=\"seat_body\")\n    saddle.visual(Box((0.070, 0.032, 0.130)), origin=Origin(xyz=(0.0, 0.046, 0.10)), material=saddle_vinyl, name=\"seat_nose\")\n\n    # =====================================================================\n    # CRANKSET (child of frame, continuous about BB) + PEDALS\n    # =====================================================================\n    crankset = model.part(\"crankset\")\n    # BB spindle passes through the shell\n    crankset.visual(_cyl_x(0.013, 0.140), origin=Origin(xyz=(BB[0] + OX, BB[1] + OY, BB[2] + OZ), rpy=(0.0, math.pi / 2.0, 0.0)), material=steel, name=\"spindle\")\n    # left crank arm (points forward +z)\n    crankset.visual(Box((0.013, 0.030, 0.170)), origin=Origin(xyz=(-0.0515 + OX, BB[1] + OY, -0.005 + OZ)), material=steel, name=\"crank_arm_l\")\n    # right crank arm (points backward -z)\n    crankset.visual(Box((0.013, 0.030, 0.170)), origin=Origin(xyz=(0.0515 + OX, BB[1] + OY, -0.175 + OZ)), material=steel, name=\"crank_arm_r\")\n    # chainring on the drive side (+x)\n    crankset.visual(_cyl_x(0.100, 0.006), origin=Origin(xyz=(0.065 + OX, BB[1] + OY, BB[2] + OZ), rpy=(0.0, math.pi / 2.0, 0.0)), material=steel, name=\"chainring\")\n\n    pedal_left = model.part(\"pedal_left\")\n    pedal_left.visual(_cyl_x(0.006, 0.055), origin=Origin(xyz=(-0.0275, 0.0, 0.0), rpy=(0.0, math.pi / 2.0, 0.0)), material=steel, name=\"spindle\")\n    pedal_left.visual(Box((0.060, 0.020, 0.090)), origin=Origin(xyz=(-0.060, 0.0, 0.0)), material=rubber, name=\"platform\")\n\n    pedal_right = model.part(\"pedal_right\")\n    pedal_right.visual(_cyl_x(0.006, 0.055), origin=Origin(xyz=(0.0275, 0.0, 0.0), rpy=(0.0, math.pi / 2.0, 0.0)), material=steel, name=\"spindle\")\n    pedal_right.visual(Box((0.060, 0.020, 0.090)), origin=Origin(xyz=(0.060, 0.0, 0.0)), material=rubber, name=\"platform\")\n\n    # =====================================================================\n    # CHAIN (fixed accessory loop around chainring + rear cog)\n    # =====================================================================\n    chain = model.part(\"chain\")\n    chain_pts = [\n        (0.065, 0.106, 0.0),\n        (0.065, 0.121, -0.43),\n        (0.065, 0.019, -0.43),\n        (0.065, -0.106, 0.0),\n    ]\n    chain.visual(_tube(\"chain_loop\", chain_pts, 0.006, offset=False, closed=True, sps=10, rs=8), material=chain_steel, name=\"loop\")\n\n    # =====================================================================\n    # ARTICULATIONS\n    # =====================================================================\n    fork_pivot = (P_STEER[0] + OX, P_STEER[1] + OY, P_STEER[2] + OZ)\n    model.articulation(\n        \"frame_to_fork\",\n        ArticulationType.REVOLUTE,\n        parent=frame,\n        child=fork,\n        origin=Origin(xyz=fork_pivot),\n        axis=DS_N,\n        motion_limits=MotionLimits(effort=10.0, velocity=3.0, lower=-0.5, upper=0.5),\n    )\n    model.articulation(\n        \"fork_to_front_wheel\",\n        ArticulationType.CONTINUOUS,\n        parent=fork,\n        child=front_wheel,\n        origin=Origin(xyz=fp(FRONT_AXLE)),\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=6.0, velocity=30.0),\n    )\n    model.articulation(\n        \"fork_to_handlebar\",\n        ArticulationType.FIXED,\n        parent=fork,\n        child=handlebar,\n        origin=Origin(xyz=hp(STEER_TOP)),\n    )\n    model.articulation(\n        \"frame_to_rear_wheel\",\n        ArticulationType.CONTINUOUS,\n        parent=frame,\n        child=rear_wheel,\n        origin=Origin(xyz=(REAR_AXLE[0] + OX, REAR_AXLE[1] + OY, REAR_AXLE[2] + OZ)),\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=6.0, velocity=30.0),\n    )\n    model.articulation(\n        \"frame_to_seatpost\",\n        ArticulationType.PRISMATIC,\n        parent=frame,\n        child=seatpost,\n        origin=Origin(xyz=(CLUSTER[0] + OX, CLUSTER[1] + OY, CLUSTER[2] + OZ)),\n        axis=DS_SEAT_N,\n        motion_limits=MotionLimits(effort=60.0, velocity=0.10, lower=0.0, upper=0.09),\n    )\n    model.articulation(\n        \"seatpost_to_saddle\",\n        ArticulationType.FIXED,\n        parent=seatpost,\n        child=saddle,\n        origin=Origin(xyz=sp_top),\n    )\n    model.articulation(\n        \"frame_to_crankset\",\n        ArticulationType.CONTINUOUS,\n        parent=frame,\n        child=crankset,\n        origin=Origin(xyz=(BB[0] + OX, BB[1] + OY, BB[2] + OZ)),\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=15.0, velocity=20.0),\n    )\n    model.articulation(\n        \"crankset_to_pedal_left\",\n        ArticulationType.CONTINUOUS,\n        parent=crankset,\n        child=pedal_left,\n        origin=Origin(xyz=(-0.058, 0.0, 0.17)),\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=3.0, velocity=20.0),\n    )\n    model.articulation(\n        \"crankset_to_pedal_right\",\n        ArticulationType.CONTINUOUS,\n        parent=crankset,\n        child=pedal_right,\n        origin=Origin(xyz=(0.058, 0.0, -0.17)),\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=3.0, velocity=20.0),\n    )\n    model.articulation(\n        \"frame_to_chain\",\n        ArticulationType.FIXED,\n        parent=frame,\n        child=chain,\n        origin=Origin(xyz=(0.0 + OX, 0.27 + OY, -0.09 + OZ)),\n    )\n\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    frame = object_model.get_part(\"frame\")\n    fork = object_model.get_part(\"fork\")\n    handlebar = object_model.get_part(\"handlebar\")\n    front_wheel = object_model.get_part(\"front_wheel\")\n    rear_wheel = object_model.get_part(\"rear_wheel\")\n    seatpost = object_model.get_part(\"seatpost\")\n    saddle = object_model.get_part(\"saddle\")\n    crankset = object_model.get_part(\"crankset\")\n    chain = object_model.get_part(\"chain\")\n\n    # ---- intentional nested / wrapped fits --------------------------------\n    ctx.allow_overlap(fork, frame, reason=\"fork steerer runs inside the frame head tube on the steering axis\")\n    ctx.allow_overlap(seatpost, frame, reason=\"seatpost is inserted into the seat tube bore\")\n    ctx.allow_overlap(crankset, frame, reason=\"bottom-bracket spindle passes through the BB shell\")\n    ctx.allow_overlap(chain, crankset, reason=\"chain wraps around the chainring\")\n    ctx.allow_overlap(chain, rear_wheel, reason=\"chain wraps around the rear cog\")\n\n    # ---- support / connectivity proofs ------------------------------------\n    ctx.expect_contact(fork, frame, name=\"fork supported at head tube\")\n    ctx.expect_contact(seatpost, frame, name=\"seatpost inserted in seat tube\")\n    ctx.expect_contact(crankset, frame, name=\"crankset mounted at bottom bracket\")\n    ctx.expect_contact(front_wheel, fork, name=\"front wheel mounted in fork dropouts\")\n    ctx.expect_contact(rear_wheel, frame, name=\"rear wheel mounted in rear dropouts\")\n    ctx.expect_contact(handlebar, fork, name=\"handlebar clamped to steerer\")\n    ctx.expect_contact(saddle, seatpost, name=\"saddle mounted on seatpost\")\n    ctx.expect_contact(chain, crankset, name=\"chain engaged on chainring\")\n\n    # ---- steering works ---------------------------------------------------\n    rest = ctx.part_world_position(front_wheel)\n    with ctx.pose({\"frame_to_fork\": 0.4}):\n        steered = ctx.part_world_position(front_wheel)\n    ctx.check(\n        \"steering turns front wheel\",\n        rest is not None and steered is not None and abs(steered[0] - rest[0]) > 0.02,\n        details=f\"rest={rest}, steered={steered}\",\n    )\n\n    # ---- seatpost raises the saddle --------------------------------------\n    with ctx.pose({\"frame_to_seatpost\": 0.0}):\n        lo = ctx.part_world_position(saddle)\n    with ctx.pose({\"frame_to_seatpost\": 0.08}):\n        hi = ctx.part_world_position(saddle)\n    ctx.check(\n        \"seatpost lifts saddle\",\n        lo is not None and hi is not None and hi[1] - lo[1] > 0.05,\n        details=f\"lo={lo}, hi={hi}\",\n    )\n\n    # ---- overall proportions ---------------------------------------------\n    aabb = ctx.part_world_aabb(front_wheel)\n    if aabb is not None:\n        mins, maxs = aabb\n        dia = max(maxs[1] - mins[1], maxs[2] - mins[2])\n        ctx.check(\"front wheel diameter\", 0.66 <= dia <= 0.70, f\"dia={dia}\")\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
