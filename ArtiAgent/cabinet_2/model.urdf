    <visual name="door_pull">
      <geometry>
        <mesh filename="assets/meshes/door_pull.obj" />
        </geometry>
      <material name="dark_metal">
        <color rgba="0.1 0.1 0.11 1" />
        </material>
      </visual>
    <collision name="door_leaf">
      <geometry>
        <mesh filename="assets/meshes/door_leaf.obj" />
        </geometry>
      </collision>
    <collision name="door_pull">
      <geometry>
        <mesh filename="assets/meshes/door_pull.obj" />
        </geometry>
      </collision>
    </link>
  <link name="top_drawer">
