<robot name="wooden_cabinet_with_drawers">
  <material name="oak_carcass">
    <color rgba="0.46 0.3 0.16 1" />
    </material>
  <material name="oak_door">
    <color rgba="0.52 0.35 0.19 1" />
    </material>
  <material name="oak_drawer">
    <color rgba="0.56 0.38 0.21 1" />
    </material>
  <material name="light_top">
    <color rgba="0.74 0.65 0.48 1" />
    </material>
  <material name="dark_metal">
    <color rgba="0.1 0.1 0.11 1" />
    </material>
  <link name="carcass">
    <visual name="carcass_body">
      <geometry>
        <mesh filename="assets/meshes/carcass_body.obj" />
        </geometry>
      <material name="oak_carcass">
        <color rgba="0.46 0.3 0.16 1" />
        </material>
      </visual>
    <visual name="countertop">
      <geometry>
        <mesh filename="assets/meshes/countertop.obj" />
        </geometry>
