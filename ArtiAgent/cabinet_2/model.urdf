  <joint name="carcass_to_door" type="revolute">
    <origin xyz="0.298 0.2895 0.058" rpy="0 0 0" />
    <parent link="carcass" />
    <child link="door" />
    <axis xyz="0 0 -1" />
    <limit effort="25" velocity="1.5" lower="0" upper="1.55" />
    </joint>
  <joint name="carcass_to_top_drawer" type="prismatic">
    <origin xyz="-0.1875 0.2895 0.70975" rpy="0 0 0" />
    <parent link="carcass" />
    <child link="top_drawer" />
    <axis xyz="0 1 0" />
    <limit effort="120" velocity="0.3" lower="0" upper="0.32" />
    </joint>
  <joint name="carcass_to_upper_drawer" type="prismatic">
