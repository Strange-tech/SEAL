        <color rgba="0.74 0.65 0.48 1" />
        </material>
      </visual>
    <collision name="carcass_body">
      <geometry>
        <mesh filename="assets/meshes/carcass_body.obj" />
        </geometry>
      </collision>
    <collision name="countertop">
      <geometry>
