[round 3] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport cadquery as cq\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Material,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    mesh_from_cadquery,\n)\n\nV = cq.Vector\n\n# ---------------------------------------------------------------------------\n# vertical layout (world y, metres).  Floor at -0.83, shade top crown at 0.83\n# ---------------------------------------------------------------------------\nFLOOR = -0.830\nBASE_BOTTOM = -0.828          # cast base underside (sits on a 2 mm rubber ring)\nBASE_TOP = -0.800             # disc top before the hub cone\nHUB_TOP = -0.783              # hub cone top == lower stem seat\nCOLLAR_TOP = 0.112            # threaded collar top == upper stem seat\nSTEM_TOP = 0.660              # upper stem top == socket housing seat\nSHOULDER_TOP = 0.736          # housing flange top == shade fitter seat\nNECK_TOP = 0.788              # socket neck top == finial seat\nFINIAL_TOP = 0.830            # crown of the finial (== 1.66 m overall)\nSHADE_BOTTOM = 0.490\nSHADE_TOP = 0.790\nKNOB_Y = 0.400                # pole dimmer switch\n\nSHADE_R_BOT = 0.200\nSHADE_R_TOP = 0.150\nSHADE_H = SHADE_TOP - SHADE_BOTTOM\nSHADE_T = 0.0034\n\n\n# ---------------------------------------------------------------------------\n# small cadquery helpers (all shapes authored z-up, then converted by SDK)\n# ---------------------------------------------------------------------------\ndef _cyl(radius: float, height: float, z0: float = 0.0):\n    return cq.Solid.makeCylinder(radius, height, V(0.0, 0.0, z0), V(0.0, 0.0, 1.0))\n\n\ndef _ring(r_out: float, r_in: float, z0: float, height: float):\n    return _cyl(r_out, height, z0).cut(_cyl(r_in, height + 0.02, z0 - 0.01))\n\n\ndef _mesh(shape, name: str):\n    return mesh_from_cadquery(shape, name, tolerance=0.0004, angular_tolerance=0.06)\n\n\ndef _base_solid():\n    disc = (\n        cq.Workplane(\"XY\")\n        .circle(0.150)\n        .extrude(BASE_TOP - BASE_BOTTOM)\n        .edges(\">Z\")\n        .fillet(0.008)\n        .val()\n    )\n    hub = cq.Solid.makeCone(\n        0.058, 0.018, HUB_TOP - BASE_TOP, V(0.0, 0.0, BASE_TOP - BASE_BOTTOM), V(0.0, 0.0, 1.0)\n    )\n    return disc.fuse(hub)\n\n\ndef _lower_stem_solid():\n    stem = _cyl(0.011, COLLAR_TOP - HUB_TOP, 0.0)\n    collar = _cyl(0.0145, 0.030, COLLAR_TOP - HUB_TOP - 0.030)\n    return stem.fuse(collar)\n\n\ndef _housing_solid():\n    body = _cyl(0.020, SHOULDER_TOP - STEM_TOP - 0.006, 0.0)\n    flange = _cyl(0.0175, 0.006, SHOULDER_TOP - STEM_TOP - 0.006)\n    neck = _cyl(0.0125, NECK_TOP - SHOULDER_TOP, SHOULDER_TOP - STEM_TOP)\n    # flat rating label pad on the front face (front = cq -y)\n    boss = cq.Solid.makeBox(0.028, 0.007, 0.030, V(-0.014, -0.025, 0.020))\n    solid = body.fuse(flange).fuse(neck).fuse(boss)\n    for text, zc in ((\"MAX 60W\", 0.0405), (\"E26\", 0.0295)):\n        try:\n            label = (\n                cq.Workplane(\"XZ\")\n                .text(text, fontsize=0.0042, distance=0.0018, combine=True)\n                .val()\n                .translate(V(0.0, -0.0232, zc))\n            )\n            solid = solid.cut(label)\n        except Exception:\n            pass\n    return solid\n\n\ndef _shade_solid():\n    local_bottom = SHADE_BOTTOM - SHADE_BOTTOM  # geometry z = 0 at shade bottom\n    slope = (SHADE_R_BOT - SHADE_R_TOP) / SHADE_H\n    outer = cq.Solid.makeCone(\n        SHADE_R_BOT, SHADE_R_TOP, SHADE_H, V(0.0, 0.0, local_bottom), V(0.0, 0.0, 1.0)\n    )\n    inner = cq.Solid.makeCone(\n        SHADE_R_BOT + slope * 0.02 - SHADE_T,\n        SHADE_R_TOP - slope * 0.02 - SHADE_T,\n        SHADE_H + 0.04,\n        V(0.0, 0.0, local_bottom - 0.02),\n        V(0.0, 0.0, 1.0),\n    )\n    shell = outer.cut(inner)\n\n    ring_z0 = SHOULDER_TOP - SHADE_BOTTOM\n    fitter = _ring(0.019, 0.0128, ring_z0, 0.022)\n\n    arm_z = ring_z0 + 0.016\n    arm_len = 0.1545 - 0.016\n    arms = None\n    for ang in (0.0, 120.0, 240.0):\n        arm = (\n            cq.Workplane(\"XY\")\n            .box(arm_len, 0.006, 0.0035)\n            .translate(V(0.016 + arm_len / 2.0, 0.0, arm_z))\n            .val()\n            .rotate(V(0.0, 0.0, 0.0), V(0.0, 0.0, 1.0), ang)\n        )\n        arms = arm if arms is None else arms.fuse(arm)\n\n    return shell.fuse(fitter).fuse(arms)\n\n\ndef _finial_solid():\n    body = _cyl(0.0155, 0.030, 0.0)\n    cap = cq.Solid.makeCone(0.0155, 0.0045, FINIAL_TOP - NECK_TOP - 0.030,\n                            V(0.0, 0.0, 0.030), V(0.0, 0.0, 1.0)).fuse(_cyl(0.0045, 0.006, 0.036))\n    return body.fuse(cap)\n\n\ndef _knob_solid():\n    # switch axis points toward the front (+world z == cq -y)\n    wheel = cq.Solid.makeCylinder(0.0115, 0.013, V(0.0, -0.008, 0.0), V(0.0, -1.0, 0.0))\n    wheel = wheel.fuse(_cyl(0.0095, 0.004, 0.0).cut(_cyl(0.0, 0.0, 0.0)) if False else wheel)\n    pointer = cq.Solid.makeBox(0.006, 0.009, 0.004, V(0.008, -0.019, -0.002))\n    rim = cq.Solid.makeCylinder(0.0135, 0.003, V(0.0, -0.010, 0.0), V(0.0, -1.0, 0.0))\n    return wheel.fuse(pointer).fuse(rim)\n\n\n# ---------------------------------------------------------------------------\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"floor_lamp\")\n\n    steel = Material(name=\"matte_black_steel\", rgba=(0.045, 0.045, 0.050, 1.0))\n    plastic = Material(name=\"molded_dark_plastic\", rgba=(0.070, 0.068, 0.064, 1.0))\n    rubber = Material(name=\"black_rubber\", rgba=(0.022, 0.022, 0.024, 1.0))\n    fabric = Material(name=\"off_white_shade_fabric\", rgba=(0.930, 0.905, 0.845, 1.0))\n\n    # --- root: weighted base ------------------------------------------------\n    base = model.part(\"base\")\n    base.visual(\n        _mesh(_base_solid(), \"base_body\"),\n        origin=Origin(xyz=(0.0, BASE_BOTTOM, 0.0)),\n        material=steel,\n        name=\"base_body\",\n    )\n\n    pad = model.part(\"base_pad\")\n    pad.visual(\n        _mesh(_ring(0.140, 0.108, FLOOR - BASE_BOTTOM, 0.002), \"base_pad_ring\"),\n        origin=Origin(xyz=(0.0, BASE_BOTTOM, 0.0)),\n        material=rubber,\n        name=\"base_pad_ring\",\n    )\n\n    lower = model.part(\"lower_stem\")\n    lower.visual(\n        _mesh(_lower_stem_solid(), \"lower_stem_body\"),\n        origin=Origin(xyz=(0.0, HUB_TOP, 0.0)),\n        material=steel,\n        name=\"lower_stem_body\",\n    )\n\n    upper = model.part(\"upper_stem\")\n    upper.visual(\n        _mesh(_cyl(0.010, STEM_TOP - COLLAR_TOP), \"upper_stem_body\"),\n        origin=Origin(xyz=(0.0, COLLAR_TOP, 0.0)),\n        material=steel,\n        name=\"upper_stem_body\",\n    )\n\n    knob = model.part(\"dimmer_knob\")\n    knob.visual(\n        _mesh(_knob_solid(), \"dimmer_knob_body\"),\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        material=plastic,\n        name=\"dimmer_knob_body\",\n    )\n\n    housing = model.part(\"socket_housing\")\n    housing.visual(\n        _mesh(_housing_solid(), \"socket_housing_body\"),\n        origin=Origin(xyz=(0.0, STEM_TOP, 0.0)),\n        material=plastic,\n        name=\"socket_housing_body\",\n    )\n\n    shade = model.part(\"shade\")\n    shade.visual(\n        _mesh(_shade_solid(), \"shade_shell\"),\n        origin=Origin(xyz=(0.0, SHADE_BOTTOM - SHOULDER_TOP, 0.0)),\n        material=fabric,\n        name=\"shade_shell\",\n    )\n\n    finial = model.part(\"finial\")\n    finial.visual(\n        _mesh(_finial_solid(), \"finial_cap\"),\n        origin=Origin(xyz=(0.0, NECK_TOP, 0.0)),\n        material=steel,\n        name=\"finial_cap\",\n    )\n\n    # --- fixed structural chain --------------------------------------------\n    model.articulation(\n        \"base_to_base_pad\",\n        ArticulationType.FIXED,\n        parent=base,\n        child=pad,\n        origin=Origin(xyz=(0.0, BASE_BOTTOM, 0.0)),\n    )\n    model.articulation(\n        \"base_to_lower_stem\",\n        ArticulationType.FIXED,\n        parent=base,\n        child=lower,\n        origin=Origin(xyz=(0.0, HUB_TOP, 0.0)),\n    )\n    model.articulation(\n        \"lower_stem_to_upper_stem\",\n        ArticulationType.FIXED,\n        parent=lower,\n        child=upper,\n        origin=Origin(xyz=(0.0, COLLAR_TOP - HUB_TOP, 0.0)),\n    )\n    model.articulation(\n        \"upper_stem_to_socket_housing\",\n        ArticulationType.FIXED,\n        parent=upper,\n        child=housing,\n        origin=Origin(xyz=(0.0, STEM_TOP - COLLAR_TOP, 0.0)),\n    )\n    model.articulation(\n        \"socket_housing_to_shade\",\n        ArticulationType.FIXED,\n        parent=housing,\n        child=shade,\n        origin=Origin(xyz=(0.0, SHOULDER_TOP - STEM_TOP, 0.0)),\n    )\n    model.articulation(\n        \"socket_housing_to_finial\",\n        ArticulationType.FIXED,\n        parent=housing,\n        child=finial,\n        origin=Origin(xyz=(0.0, NECK_TOP - STEM_TOP, 0.0)),\n    )\n\n    # --- the one user control: pole dimmer / rotary switch ------------------\n    model.articulation(\n        \"upper_stem_to_dimmer_knob\",\n        ArticulationType.REVOLUTE,\n        parent=upper,\n        child=knob,\n        origin=Origin(xyz=(0.0, KNOB_Y - COLLAR_TOP, 0.0)),\n        axis=(0.0, 0.0, 1.0),\n        motion_limits=MotionLimits(effort=0.6, velocity=3.0, lower=0.0, upper=4.71),\n    )\n\n    return model\n\n\n# ---------------------------------------------------------------------------\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    base = object_model.get_part(\"base\")\n    pad = object_model.get_part(\"base_pad\")\n    lower = object_model.get_part(\"lower_stem\")\n    upper = object_model.get_part(\"upper_stem\")\n    housing = object_model.get_part(\"socket_housing\")\n    shade = object_model.get_part(\"shade\")\n    finial = object_model.get_part(\"finial\")\n    knob = object_model.get_part(\"dimmer_knob\")\n    knob_joint = object_model.get_articulation(\"upper_stem_to_dimmer_knob\")\n\n    # support chain: every part seats on the one below it\n    ctx.expect_contact(pad, base, name=\"rubber pad seats under the base\")\n    ctx.expect_contact(lower, base, name=\"lower stem seats in the base hub\")\n    ctx.expect_contact(upper, lower, name=\"upper stem seats on the threaded collar\")\n    ctx.expect_contact(housing, upper, name=\"socket housing seats on the stem top\")\n    ctx.expect_contact(shade, housing, name=\"shade fitter ring seats on the socket shoulder\")\n    ctx.expect_contact(finial, housing, name=\"finial screws onto the socket neck\")\n    ctx.expect_contact(knob, upper, name=\"dimmer knob is mounted through the stem wall\")\n\n    ctx.allow_overlap(\n        upper,\n        knob,\n        elem_a=\"upper_stem_body\",\n        elem_b=\"dimmer_knob_body\",\n        reason=\"Switch knob hub is pressed 2 mm into the stem wall so the dimmer reads as mounted.\",\n    )\n\n    # overall proportions\n    pad_aabb = ctx.part_world_aabb(pad)\n    finial_aabb = ctx.part_world_aabb(finial)\n    shade_aabb = ctx.part_world_aabb(shade)\n    base_aabb = ctx.part_world_aabb(base)\n\n    height = finial_aabb[1][1] - pad_aabb[0][1]\n    ctx.check(\"overall height about 1.66 m\", 1.60 <= height <= 1.70, details=f\"height={height:.4f}\")\n\n    shade_w = shade_aabb[1][0] - shade_aabb[0][0]\n    shade_h = shade_aabb[1][1] - shade_aabb[0][1]\n    ctx.check(\"shade is about 0.40 m across\", 0.38 <= shade_w <= 0.42, details=f\"width={shade_w:.4f}\")\n    ctx.check(\"shade is about 0.30 m tall\", 0.28 <= shade_h <= 0.32, details=f\"height={shade_h:.4f}\")\n\n    base_w = base_aabb[1][0] - base_aabb[0][0]\n    ctx.check(\"base is about 0.30 m across\", 0.28 <= base_w <= 0.32, details=f\"width={base_w:.4f}\")\n\n    shade_cx = 0.5 * (shade_aabb[0][0] + shade_aabb[1][0])\n    shade_cz = 0.5 * (shade_aabb[0][2] + shade_aabb[1][2])\n    base_cx = 0.5 * (base_aabb[0][0] + base_aabb[1][0])\n    base_cz = 0.5 * (base_aabb[0][2] + base_aabb[1][2])\n    ctx.check(\n        \"shade stays coaxial with the base\",\n        abs(shade_cx - base_cx) < 0.003 and abs(shade_cz - base_cz) < 0.003,\n        details=f\"shade=({shade_cx:.4f},{shade_cz:.4f}) base=({base_cx:.4f},{base_cz:.4f})\",\n    )\n\n    # the shade hangs above the stem, clear of the base\n    ctx.expect_gap(shade, base, axis=\"y\", min_gap=0.5, name=\"shade sits high above the base\")\n\n    # dimmer switch actually turns\n    rest_aabb = ctx.part_world_aabb(knob)\n    with ctx.pose({knob_joint: 1.5708}):\n        turned_aabb = ctx.part_world_aabb(knob)\n        ctx.expect_contact(knob, upper, name=\"turned knob stays mounted on the stem\")\n    moved = abs((rest_aabb[1][0] - rest_aabb[0][0]) - (turned_aabb[1][0] - turned_aabb[0][0]))\n    ctx.check(\n        \"rotating the dimmer swings its pointer\",\n        moved > 0.002,\n        details=f\"rest_dx={rest_aabb[1][0] - rest_aabb[0][0]:.4f} turned_dx={turned_aabb[1][0] - turned_aabb[0][0]:.4f}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
