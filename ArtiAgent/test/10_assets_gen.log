[round 7] write_file({"content": "from __future__ import annotations\n\nimport cadquery as cq\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Box,\n    Material,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    mesh_from_cadquery,\n)\n\n# ---------------------------------------------------------------------------\n# Hardcover book, closed ~ 0.240 m (tall, +Y) x 0.160 m (wide, +X) x 0.030 m (thick, Z)\n# Frame: +Y up, +Z front.  Spine on the -X edge.\n# CadQuery -> world mapping in this build:  world = (-cq_x, cq_z, cq_y)\n# ---------------------------------------------------------------------------\n\nH = 0.240            # book height (Y)\nW = 0.160            # book width (X)\nT = 0.030            # total thickness (Z)\n\nBOARD = 0.0025       # board thickness\nSPINE_X_OUT = -0.080\nSPINE_X_IN = SPINE_X_OUT + BOARD      # -0.0775\nFRONT_Z = T / 2                       # 0.015 front outer face\nBACK_Z = -T / 2\nCOVER_Z_C = FRONT_Z - BOARD / 2       # 0.01375\nTB_THK = T - 2 * BOARD                # text block thickness 0.025\n\nCLOTH = (0.16, 0.17, 0.20, 1.0)\nPAPER = (0.93, 0.90, 0.80, 1.0)\n\n\ndef _text_wp(txt: str, fontsize: float, depth: float, mode: str, L) -> cq.Workplane:\n    \"\"\"Build extruded text positioned so its world centre is at local point L.\"\"\"\n    wp = (\n        cq.Workplane(\"XY\")\n        .text(txt, fontsize=fontsize, distance=depth, combine=False,\n              halign=\"center\", valign=\"center\")\n    )\n    if mode == \"front\":\n        # advance -> world +x, up -> world +y, normal(out) -> world +z\n        wp = wp.rotate((0, 0, 0), (0, 1, 1), 180)\n    else:  # spine : advance -> world -y, up -> world +z, normal(out) -> world -x\n        wp = wp.rotate((0, 0, 0), (0, 1, 0), 90)\n    bb = wp.val().BoundingBox()\n    cx = (bb.xmin + bb.xmax) / 2\n    cy = (bb.ymin + bb.ymax) / 2\n    cz = (bb.zmin + bb.zmax) / 2\n    # local point -> cq point\n    tgt = (-L[0], L[2], L[1])\n    return wp.translate((tgt[0] - cx, tgt[1] - cy, tgt[2] - cz))\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"hardcover_book\")\n\n    cloth = Material(name=\"bookcloth\", rgba=CLOTH)\n    paper = Material(name=\"paper\", rgba=PAPER)\n\n    # ---- Spine board (root) ------------------------------------------------\n    spine = model.part(\"spine\")\n    spine_board = (\n        cq.Workplane(\"XY\")\n        .box(BOARD, T, H)                 # cq dims = (Dx, Dz, Dy)\n        .translate((0.07875, 0.0, 0.0))   # cq centre = (-worldx, worldz, worldy)\n    )\n    sp_title = _text_wp(\"TITLE\", 0.020, 0.0012, \"spine\", (-0.0799, 0.045, 0.0))\n    sp_author = _text_wp(\"AUTHOR NAME\", 0.011, 0.0012, \"spine\", (-0.0799, -0.030, 0.0))\n    sp_pub = _text_wp(\"PUBLISHER\", 0.007, 0.0012, \"spine\", (-0.0799, -0.095, 0.0))\n    spine_solid = (\n        spine_board\n        .union(sp_title.val())\n        .union(sp_author.val())\n        .union(sp_pub.val())\n    )\n    spine.visual(mesh_from_cadquery(spine_solid, \"spine_board\"),\n                 material=cloth, name=\"spine_board\")\n\n    # ---- Front cover -------------------------------------------------------\n    front_cover = model.part(\"front_cover\")\n    fc_board = (\n        cq.Workplane(\"XY\")\n        .box(W - 0.0025, BOARD, H)        # width from spine inner face to fore-edge\n        .translate((-0.07875, 0.0, 0.0))\n    )\n    fc_title = _text_wp(\"TITLE\", 0.030, 0.0012, \"front\", (0.07875, 0.050, 0.00115))\n    fc_author = _text_wp(\"AUTHOR NAME\", 0.016, 0.0012, \"front\", (0.07875, 0.018, 0.00115))\n    front_solid = fc_board.union(fc_title.val()).union(fc_author.val())\n    front_cover.visual(mesh_from_cadquery(front_solid, \"front_cover\"),\n                       material=cloth, name=\"front_board\")\n\n    # ---- Back cover --------------------------------------------------------\n    back_cover = model.part(\"back_cover\")\n    bc_board = (\n        cq.Workplane(\"XY\")\n        .box(W - 0.0025, BOARD, H)\n        .translate((-0.07875, 0.0, 0.0))\n    )\n    back_cover.visual(mesh_from_cadquery(bc_board, \"back_cover\"),\n                      material=cloth, name=\"back_board\")\n\n    # ---- Text block (page stack) ------------------------------------------\n    text_block = model.part(\"text_block\")\n    text_block.visual(\n        Box((0.072 - SPINE_X_IN, 0.228, TB_THK)),\n        origin=Origin(xyz=((0.072 + SPINE_X_IN) / 2, 0.0, 0.0)),\n        material=paper,\n        name=\"page_block\",\n    )\n\n    # ---- Articulations -----------------------------------------------------\n    model.articulation(\n        \"spine_to_front_cover\", ArticulationType.REVOLUTE,\n        parent=spine, child=front_cover,\n        origin=Origin(xyz=(SPINE_X_IN, 0.0, COVER_Z_C)),\n        axis=(0.0, -1.0, 0.0),\n        motion_limits=MotionLimits(effort=2.0, velocity=1.0, lower=0.0, upper=3.05),\n    )\n    model.articulation(\n        \"spine_to_back_cover\", ArticulationType.REVOLUTE,\n        parent=spine, child=back_cover,\n        origin=Origin(xyz=(SPINE_X_IN, 0.0, -COVER_Z_C)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(effort=2.0, velocity=1.0, lower=0.0, upper=3.05),\n    )\n    model.articulation(\n        \"spine_to_text_block\", ArticulationType.FIXED,\n        parent=spine, child=text_block,\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n    )\n\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    spine = object_model.get_part(\"spine\")\n    front_cover = object_model.get_part(\"front_cover\")\n    back_cover = object_model.get_part(\"back_cover\")\n    text_block = object_model.get_part(\"text_block\")\n    front_hinge = object_model.get_articulation(\"spine_to_front_cover\")\n    back_hinge = object_model.get_articulation(\"spine_to_back_cover\")\n\n    # Closed: front/back covers seat against the text block page stack.\n    ctx.expect_gap(front_cover, text_block, axis=\"z\",\n                   max_gap=0.0005, max_penetration=0.0,\n                   name=\"front cover seats on page stack\")\n    ctx.expect_gap(text_block, back_cover, axis=\"z\",\n                   max_gap=0.0005, max_penetration=0.0,\n                   name=\"back cover seats on page stack\")\n\n    # Covers are hinged to the spine (supported along the spine edge).\n    ctx.expect_contact(front_cover, spine, contact_tol=0.001,\n                       name=\"front cover meets spine\")\n    ctx.expect_contact(back_cover, spine, contact_tol=0.001,\n                       name=\"back cover meets spine\")\n    ctx.expect_contact(text_block, spine, contact_tol=0.001,\n                       name=\"page stack meets spine\")\n\n    # Opening the front cover swings it forward/outward (world +z grows).\n    rest_front = ctx.part_world_aabb(front_cover)\n    with ctx.pose({front_hinge: 1.2}):\n        open_front = ctx.part_world_aabb(front_cover)\n    ctx.check(\n        \"front cover opens outward\",\n        rest_front is not None and open_front is not None\n        and open_front[1][2] > rest_front[1][2] + 0.02,\n        details=f\"rest={rest_front}, open={open_front}\",\n    )\n\n    # Opening the back cover swings it backward/outward (world -z shrinks).\n    rest_back = ctx.part_world_aabb(back_cover)\n    with ctx.pose({back_hinge: 1.2}):\n        open_back = ctx.part_world_aabb(back_cover)\n    ctx.check(\n        \"back cover opens outward\",\n        rest_back is not None and open_back is not None\n        and open_back[0][2] < rest_back[0][2] - 0.02,\n        details=f\"rest={rest_back}, open={open_back}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n", "path": "model.py"})
