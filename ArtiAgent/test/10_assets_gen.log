0.018\nRUNNER_Z_FRONT = 0.220\nRUNNER_Z_BACK = -0.200\n\nBOX_HALF_W = 0.468                    # drawer box outer half width\nBOX_T = 0.012\nBOX_H = 0.188                         # bottom face to top edge of box walls\nBOX_DEPTH = 0.420\nBOX_Z_FRONT = FRONT_BACK_Z            # box front edge meets the front panel\nBOX_Z_BACK = BOX_Z_FRONT - BOX_DEPTH\n\nHANDLE_X = 0.130                      # half spacing of the two posts\nPOST_R = 0.006\nPOST_LEN = 0.023\nBAR_R = 0.007\nBAR_LEN = 0.300\nBAR_Z = FRONT_FACE_Z + POST_LEN       # 0.271\n\nDRAWER_TRAVEL = 0.320\n\n\ndef _y(yf: float) -> float:\n    \"\"\"Floor-based Y (0 at the floor) -> centred world Y.\"\"\"\n    return yf - YC\n\n\ndef _bay_floor_yf(i: int) -> float:\n    \"\"\"Top of the runners' substrate (cavity floor or rail top) for bay i.\"\"\"\n    if i == 0:\n        return BASE_0\n    return BASE_0 + i * PITCH + RAIL_H / 2.0\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"chest_of_drawers\")\n\n    model.material(\"carcass_paint\", rgba=(0.855, 0.838, 0.792, 1.0))\n    model.material(\"drawer_paint\", rgba=(0.838, 0.820, 0.772, 1.0))\n    model.material(\"plywood\", rgba=(0.788, 0.663, 0.470, 1.0))\n    model.material(\"satin_metal\", rgba=(0.720, 0.730, 0.748, 1.0))\n    model.material(\"cavity_shadow\", rgba=(0.360, 0.340, 0.318, 1.0))\n\n    # ---------------- carcass (root) -------------------------------------\n    carcass = model.part(\"carcass\")\n\n    for s in (-1.0, 1.0):\n        carcass.visual(\n            Box((T_SIDE, H, D)),\n            origin=Origin(xyz=(s * (W / 2.0 - T_SIDE / 2.0), 0.0, 0.0)),\n            material=\"carcass_paint\",\n            name=f\"side_panel_{0 if s < 0 else 1}\",\n        )\n\n    carcass.visual(\n        Box((W, T_TOP, D)),\n        origin=Origin(xyz=(0.0, _y(H - T_TOP / 2.0), 0.0)),\n        material=\"carcass_paint\",\n        name=\"top_panel\",\n    )\n\n    carcass.visual(\n        Box((2.0 * INNER_X, T_FLOOR, 0.474)),\n        origin=Origin(xyz=(0.0, _y((FLOOR_Y0 + FLOOR_Y1) / 2.0), 0.003)),\n        material=\"carcass_paint\",\n        name=\"cavity_floor\",\n    )\n\n    carcass.visual(\n        Box((2.0 * INNER_X, TOP_Y0 - FLOOR_Y0, T_BACK)),\n        origin=Origin(\n            xyz=(0.0, _y((FLOOR_Y0 + TOP_Y0) / 2.0), -D / 2.0 + T_BACK / 2.0)\n        ),\n        material=\"carcass_paint\",\n        name=\"back_panel\",\n    )\n\n    # recessed toe-kick / plinth board\n    carcass.visual(\n        Box((2.0 * INNER_X, FLOOR_Y0, 0.020)),\n        origin=Origin(xyz=(0.0, _y(FLOOR_Y0 / 2.0), 0.200)),\n        material=\"carcass_paint\",\n        name=\"plinth_board\",\n    )\n\n    # horizontal rails behind each gap between drawer fronts\n    rail_cz = (RAIL_BACK_Z + RAIL_FRONT_Z) / 2.0\n    rail_d = RAIL_FRONT_Z - RAIL_BACK_Z\n    for i in range(1, N_DRAWERS):\n        carcass.visual(\n            Box((2.0 * INNER_X, RAIL_H, rail_d)),\n            origin=Origin(xyz=(0.0, _y(BASE_0 + i * PITCH), rail_cz)),\n            material=\"cavity_shadow\",\n            name=f\"rail_{i}\",\n        )\n\n    # side runners (drawer supports) inside each bay\n    runner_cz = (RUNNER_Z_BACK + RUNNER_Z_FRONT) / 2.0\n    runner_d = RUNNER_Z_FRONT - RUNNER_Z_BACK\n    for i in range(N_DRAWERS):\n        yf = _bay_floor_yf(i) + RUNNER_H / 2.0\n        for k, s in enumerate((-1.0, 1.0)):\n            carcass.visual(\n                Box((RUNNER_W, RUNNER_H, runner_d)),\n                origin=Origin(xyz=(s * (INNER_X - RUNNER_W / 2.0), _y(yf), runner_cz)),\n                material=\"plywood\",\n                name=f\"runner_{i}_{k}\",\n            )\n\n    # ---------------- drawers --------------------------------------------\n    for i in range(N_DRAWERS):\n        base_yf = BASE_0 + i * PITCH\n        box_bottom_yf = _bay_floor_yf(i) + RUNNER_H\n        joint_origin = Origin(xyz=(0.0, _y(box_bottom_yf), 0.0))\n\n        drawer = model.part(f\"drawer_{i}\")\n\n        # decorative front panel: local y measured from the box bottom face\n        ly_front = (base_yf + REVEAL + FRONT_H / 2.0) - box_bottom_yf\n        drawer.visual(\n            Box((FRONT_W, FRONT_H, FRONT_T)),\n            origin=Origin(xyz=(0.0, ly_front, (FRONT_FACE_Z + FRONT_BACK_Z) / 2.0)),\n            material=\"drawer_paint\",\n            name=\"front_panel\",\n        )\n\n        # box bottom panel\n        drawer.visual(\n            Box((2.0 * BOX_HALF_W, BOX_T, BOX_DEPTH)),\n            origin=Origin(xyz=(0.0, BOX_T / 2.0, (BOX_Z_FRONT + BOX_Z_BACK) / 2.0)),\n            material=\"plywood\",\n            name=\"box_bottom\",\n        )\n\n        # box side walls (1 mm joint embed into the bottom panel)\n        wall_h = BOX_H - BOX_T + 0.001\n        wall_cy = (BOX_T - 0.001 + BOX_H) / 2.0\n        for k, s in enumerate((-1.0, 1.0)):\n            drawer.visual(\n                Box((BOX_T, wall_h, BOX_DEPTH + 0.002)),\n                origin=Origin(\n                    xyz=(s * (BOX_HALF_W - BOX_T / 2.0), wall_cy, (BOX_Z_FRONT + BOX_Z_BACK) / 2.0 + 0.001)\n                ),\n                material=\"plywood\",\n                name=f\"box_side_{k}\",\n            )\n\n        # box back wall\n        drawer.visual(\n            Box((2.0 * BOX_HALF_W - 2.0 * BOX_T + 0.002, wall_h, BOX_T)),\n            origin=Origin(xyz=(0.0, wall_cy, BOX_Z_BACK + BOX_T / 2.0)),\n            material=\"plywood\",\n            name=\"box_back\",\n        )\n\n        # bar pull: two posts + cross bar, fixed to the front panel\n        ly_handle = ly_front + FRONT_H / 2.0 - 0.052\n        for k, s in enumerate((-1.0, 1.0)):\n            drawer.visual(\n                Cylinder(radius=POST_R, length=POST_LEN),\n                origin=Origin(\n                    xyz=(s * HANDLE_X, ly_handle, FRONT_FACE_Z - 0.001 + POST_LEN / 2.0)\n                ),\n                material=\"satin_metal\",\n                name=f\"handle_post_{k}\",\n            )\n        drawer.visual(\n            Cylinder(radius=BAR_R, length=BAR_LEN),\n            origin=Origin(\n                xyz=(0.0, ly_handle, BAR_Z), rpy=(0.0, math.pi / 2.0, 0.0)\n            ),\n            material=\"satin_metal\",\n            name=\"handle_bar\",\n        )\n\n        model.articulation(\n            f\"carcass_to_drawer_{i}\",\n            ArticulationType.PRISMATIC,\n            parent=carcass,\n            child=drawer,\n            origin=joint_origin,\n            axis=(0.0, 0.0, 1.0),\n            motion_limits=MotionLimits(\n                lower=0.0, upper=DRAWER_TRAVEL, effort=120.0, velocity=0.35\n            ),\n        )\n\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    carcass = object_model.get_part(\"carcass\")\n\n    for i in range(N_DRAWERS):\n        drawer = object_model.get_part(f\"drawer_{i}\")\n        joint = object_model.get_articulation(f\"carcass_to_drawer_{i}\")\n\n        # drawer box rests exactly on the carcass runner (real support path)\n        ctx.expect_contact(\n            drawer,\n            carcass,\n            elem_a=\"box_bottom\",\n            elem_b=f\"runner_{i}_0\",\n            name=f\"drawer_{i}_rides_on_runner\",\n        )\n\n        # front panel inset inside the carcass opening\n        ctx.expect_within(\n            drawer,\n            carcass,\n            axes=\"x\",\n            inner_elem=\"front_panel\",\n            margin=0.0,\n            name=f\"drawer_{i}_front_inside_carcass_width\",\n        )\n\n        # front panel sits just behind the carcass front plane\n        box = ctx.part_element_world_aabb(drawer, elem=\"front_panel\")\n        front_z = box[1][2] if box is not None else None\n        ctx.check(\n            f\"drawer_{i}_front_near_front_plane\",\n            front_z is not None and 0.240 <= front_z <= 0.250,\n            details=f\"front_z={front_z}\",\n        )\n\n        # handles are part of the drawer and stand proud of the front\n        handle = ctx.part_element_world_aabb(drawer, elem=\"handle_bar\")\n        handle_z = handle[1][2] if handle is not None else None\n        ctx.check(\n            f\"drawer_{i}_handle_proud_of_front\",\n            front_z is not None\n            and handle_z is not None\n            and handle_z > front_z + 0.015,\n            details=f\"front_z={front_z}, handle_z={handle_z}\",\n        )\n\n        # the drawer actually slides forward along +Z\n        with ctx.pose({joint: DRAWER_TRAVEL}):\n            ext = ctx.part_element_world_aabb(drawer, elem=\"front_panel\")\n        ext_z = ext[1][2] if ext is not None else None\n        ctx.check(\n            f\"drawer_{i}_slides_forward\",\n            front_z is not None\n            and ext_z is not None\n            and ext_z - front_z > 0.90 * DRAWER_TRAVEL,\n            details=f\"rest_z={front_z}, extended_z={ext_z}\",\n        )\n\n    # narrow reveals between stacked fronts\n    for i in range(1, N_DRAWERS):\n        below = object_model.get_part(f\"drawer_{i - 1}\")\n        above = object_model.get_part(f\"drawer_{i}\")\n        ctx.expect_gap(\n            above,\n            below,\n            axis=\"y\",\n            min_gap=0.005,\n            max_gap=0.012,\n            name=f\"reveal_between_drawer_{i - 1}_and_{i}\",\n        )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
