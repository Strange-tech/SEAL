[round 4] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    LatheGeometry,\n    MeshGeometry,\n    Origin,\n    TestContext,\n    TestReport,\n    mesh_from_geometry,\n)\n\n\n# ---------------------------------------------------------------------------\n# Geometry helpers\n# ---------------------------------------------------------------------------\ndef _arc(cx: float, cz: float, r: float, a0: float, a1: float, n: int):\n    \"\"\"Sample a circular arc in the (radius, height) profile plane.\"\"\"\n    return [\n        (cx + r * math.cos(a0 + (a1 - a0) * i / n),\n         cz + r * math.sin(a0 + (a1 - a0) * i / n))\n        for i in range(n + 1)\n    ]\n\n\ndef _revolve_yup(profile, name: str, segments: int = 112):\n    \"\"\"Revolve a closed (radius, height) profile and bake it into y-up space.\"\"\"\n    geom = LatheGeometry(profile, segments=segments, closed=True)\n    out = MeshGeometry()\n    # LatheGeometry is built z-up (radius in the XY plane, profile height = z).\n    # Map to the world y-up frame: (x, y, z) -> (x, z, -y)  (det = +1).\n    for (x, y, z) in geom.vertices:\n        out.add_vertex(x, z, -y)\n    for f in geom.faces:\n        out.add_face(f[0], f[1], f[2])\n    return mesh_from_geometry(out, name)\n\n\n# ---------------------------------------------------------------------------\n# Cross-section profiles (radius, height) in metres\n# ---------------------------------------------------------------------------\ndef _base_profile():\n    Rb = 0.225\n    t = 0.030\n    e = 0.008\n    pts = [(0.0, 0.0), (Rb, 0.0), (Rb, t - e)]\n    pts += _arc(Rb - e, t - e, e, 0.0, math.pi / 2.0, 10)[1:]\n    pts += [(0.0, t)]\n    return pts\n\n\ndef _pedestal_profile():\n    H = 0.360\n    pts = [\n        (0.0, 0.0),\n        (0.076, 0.0),      # base flange outer\n        (0.078, 0.006),    # flange slight chamfer\n        (0.078, 0.014),\n        (0.050, 0.030),    # neck rising off the flange\n        (0.045, 0.330),    # gently tapered shaft\n        (0.052, 0.342),    # flare into the top collar\n        (0.070, 0.344),\n        (0.072, 0.350),\n        (0.072, H),        # top collar meets the tabletop underside\n        (0.0, H),\n    ]\n    return pts\n\n\ndef _top_profile():\n    R = 0.450\n    t = 0.030\n    e = 0.008\n    pts = [(0.0, 0.0), (R - e, 0.0)]\n    pts += _arc(R - e, e, e, -math.pi / 2.0, 0.0, 9)[1:]\n    pts += [(R, t - e)]\n    pts += _arc(R - e, t - e, e, 0.0, math.pi / 2.0, 9)[1:]\n    pts += [(0.0, t)]\n    return pts\n\n\n# ---------------------------------------------------------------------------\n# Model\n# ---------------------------------------------------------------------------\nBASE_TOP = 0.030\nTOP_BOTTOM = 0.390\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"round_coffee_table\")\n\n    oak = model.material(\"oak\", rgba=(0.62, 0.42, 0.24, 1.0))\n    oak_end = model.material(\"oak_end\", rgba=(0.55, 0.36, 0.20, 1.0))\n    steel = model.material(\"powder_coated_steel\", rgba=(0.15, 0.16, 0.17, 1.0))\n    steel_dark = model.material(\"steel_shadow\", rgba=(0.10, 0.11, 0.12, 1.0))\n\n    # Root: the floor base disc.\n    base = model.part(\"base\")\n    base.visual(\n        _revolve_yup(_base_profile(), \"base_shell\"),\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        material=steel,\n        name=\"base_shell\",\n    )\n    # A thin rubber-ish foot ring proud under the rim for grip/realism.\n    base.visual(\n        _revolve_yup(\n            [(0.210, -0.002), (0.222, -0.002), (0.222, 0.004), (0.210, 0.004)],\n            \"base_foot\",\n        ),\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        material=steel_dark,\n        name=\"base_foot\",\n    )\n\n    # Pedestal column, fixed to the base.\n    pedestal = model.part(\"pedestal\")\n    pedestal.visual(\n        _revolve_yup(_pedestal_profile(), \"pedestal_column\"),\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        material=steel,\n        name=\"pedestal_column\",\n    )\n\n    # Circular oak tabletop, fixed to the base at its underside centre.\n    top = model.part(\"tabletop\")\n    top.visual(\n        _revolve_yup(_top_profile(), \"tabletop_disc\"),\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        material=oak,\n        name=\"tabletop_disc\",\n    )\n    # A slightly darker inlaid edge band reads as end-grain on the rim.\n    top.visual(\n        _revolve_yup(\n            [(0.4485, 0.010), (0.4505, 0.010), (0.4505, 0.020), (0.4485, 0.020)],\n            \"tabletop_edge_band\",\n        ),\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        material=oak_end,\n        name=\"tabletop_edge_band\",\n    )\n\n    model.articulation(\n        \"base_to_pedestal\",\n        ArticulationType.FIXED,\n        parent=base,\n        child=pedestal,\n        origin=Origin(xyz=(0.0, BASE_TOP, 0.0)),\n    )\n    model.articulation(\n        \"base_to_tabletop\",\n        ArticulationType.FIXED,\n        parent=base,\n        child=top,\n        origin=Origin(xyz=(0.0, TOP_BOTTOM, 0.0)),\n    )\n\n    return model\n\n\n# ---------------------------------------------------------------------------\n# Tests\n# ---------------------------------------------------------------------------\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    base = object_model.get_part(\"base\")\n    pedestal = object_model.get_part(\"pedestal\")\n    top = object_model.get_part(\"tabletop\")\n\n    base_aabb = ctx.part_world_aabb(base)\n    top_aabb = ctx.part_world_aabb(top)\n    ped_aabb = ctx.part_world_aabb(pedestal)\n\n    if base_aabb is not None:\n        bmin, bmax = base_aabb\n        ctx.check(\n            \"base diameter ~0.45 m\",\n            abs((bmax[0] - bmin[0]) - 0.45) < 0.01\n            and abs((bmax[2] - bmin[2]) - 0.45) < 0.01,\n            details=f\"base dims={[bmax[i]-bmin[i] for i in range(3)]}\",\n        )\n        ctx.check(\n            \"base sits on the floor\",\n            abs(bmin[1]) < 0.004,\n            details=f\"base min y={bmin[1]}\",\n        )\n\n    if top_aabb is not None:\n        tmin, tmax = top_aabb\n        ctx.check(\n            \"tabletop diameter ~0.90 m\",\n            abs((tmax[0] - tmin[0]) - 0.90) < 0.015\n            and abs((tmax[2] - tmin[2]) - 0.90) < 0.015,\n            details=f\"top dims={[tmax[i]-tmin[i] for i in range(3)]}\",\n        )\n        ctx.check(\n            \"tabletop thickness ~0.03 m\",\n            abs((tmax[1] - tmin[1]) - 0.06) < 0.005,\n            details=f\"top thickness profile={tmax[1]-tmin[1]}\",\n        )\n        ctx.check(\n            \"overall height ~0.42 m\",\n            abs(tmax[1] - 0.42) < 0.006,\n            details=f\"top surface y={tmax[1]}\",\n        )\n\n    if ped_aabb is not None:\n        pmin, pmax = ped_aabb\n        ctx.check(\n            \"pedestal shaft narrow vs top\",\n            (pmax[0] - pmin[0]) < 0.20,\n            details=f\"pedestal dims={[pmax[i]-pmin[i] for i in range(3)]}\",\n        )\n\n    # Physical support: column seats on the base, tabletop seats on the column.\n    ctx.expect_contact(base, pedestal, contact_tol=1e-4,\n                       name=\"pedestal seated on base\")\n    ctx.expect_contact(pedestal, top, contact_tol=1e-4,\n                       name=\"tabletop seated on pedestal\")\n    ctx.expect_overlap(base, pedestal, axes=\"xz\", min_overlap=0.05,\n                       name=\"pedestal centred over base\")\n    ctx.expect_overlap(pedestal, top, axes=\"xz\", min_overlap=0.05,\n                       name=\"tabletop centred over pedestal\")\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
