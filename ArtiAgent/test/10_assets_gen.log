[round 17] bash({"command": "python3 -c \"\nimport math\nvs=[];fs=[]\nfor line in open('.compile_tmp/assets/meshes/body_lettering.obj'):\n    a=line.split()\n    if not a: continue\n    if a[0]=='v': vs.append((float(a[1]),float(a[2]),float(a[3])))\n    elif a[0]=='f': fs.append([int(t.split('/')[0])-1 for t in a[1:]])\n# project to (arc angle, y): use x as horizontal\nP=[(v[0],v[1]) for v in vs]\nxs=[p[0] for p in P]; ys=[p[1] for p in P]\nW,H=120,26\ng=[[' ']*W for _ in range(H)]\ndef cmap(x,y): return ((x-min(xs))/(max(xs)-min(xs))*(W-1), (y-min(ys))/(max(ys)-min(ys))*(H-1))\ntris=[]\nfor f in fs:\n    for i in range(1,len(f)-1): tris.append((f[0],f[i],f[i+1]))\nfor t in tris:\n    a,b,c=[cmap(*P[k]) for k in t]\n    minx=max(0,int(math.floor(min(a[0],b[0],c[0])))); maxx=min(W-1,int(math.ceil(max(a[0],b[0],c[0]))))\n    miny=max(0,int(math.floor(min(a[1],b[1],c[1])))); maxy=min(H-1,int(math.ceil(max(a[1],b[1],c[1]))))\n    d=(b[1]-c[1])*(a[0]-c[0])+(c[0]-b[0])*(a[1]-c[1])\n    if abs(d)<1e-12: continue\n    for px in range(minx,maxx+1):\n        for py in range(miny,maxy+1):\n            l1=((b[1]-c[1])*(px-c[0])+(c[0]-b[0])*(py-c[1]))/d\n            l2=((c[1]-a[1])*(px-c[0])+(a[0]-c[0])*(py-c[1]))/d\n            l3=1-l1-l2\n            if -0.02<=l1<=1.02 and -0.02<=l2<=1.02 and -0.02<=l3<=1.02:\n                g[H-1-py][px]='#'\nprint('\\n'.join(''.join(r) for r in g))\n\""})
