[round 7] write_file({"content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Cylinder,\n    MeshGeometry,\n    Origin,\n    TestContext,\n    TestReport,\n    mesh_from_geometry,\n)\n\n# ---------------------------------------------------------------------------\n# Dimensions (metres).  World frame: +Y = up, +Z = front (toward the sitter),\n# +X = the sitter's left as seen from the front.  The chair spans y in\n# [-0.45, +0.45] so its geometric centre sits on the world origin.\n# ---------------------------------------------------------------------------\n\nFLOOR = -0.45\nSEAT_TOP = 0.0\nSEAT_T = 0.035\nSEAT_W = 0.45\nSEAT_D = 0.47\nSEAT_RC = 0.035  # plan-view corner radius\nSEAT_RE = 0.008  # rounded rim radius (top and bottom edges)\nSEAT_BOT = SEAT_TOP - SEAT_T\n\nLEG_X = 0.19\nFRONT_LEG_Z = 0.19\nREAR_LEG_Z = -0.15\nRAKE = 0.05  # back posts lean back by this angle (rad)\nLEG_SEC = 0.046\nLEG_FOOT_SEC = 0.033\nLEG_KNEE_Y = -0.27  # section is constant above this, tapered below\n\nLEG_TOP_Y = SEAT_BOT + 0.0015  # small embed into the seat underside\nLEG_LEN = LEG_TOP_Y - FLOOR\n\nPOST_Z = -0.155  # back-post axis at the seat surface\nPOST_BOT_Y = SEAT_TOP - 0.002\nPOST_TOP_Y = 0.45\nPOST_LEN = (POST_TOP_Y - POST_BOT_Y) / math.cos(RAKE)\n\nSTRETCHER_Y = -0.27\nSTRETCHER_R = 0.011\nEMBED = 0.0015\n\nPANEL_BOT_Y = 0.12\nPANEL_TOP_Y = 0.44\nPANEL_H = PANEL_TOP_Y - PANEL_BOT_Y\nPANEL_T = 0.022\nPANEL_RC = 0.03\nPANEL_RE = 0.006\n\n\ndef _post_axis_z(y: float) -> float:\n    return POST_Z - (y - POST_BOT_Y) * math.tan(RAKE)\n\n\n# Panel is jointed into the inner faces of the two back posts.\nPANEL_HW = LEG_X - LEG_SEC / 2.0 + 0.001\n\n\n# ---------------------------------------------------------------------------\n# Small mesh toolkit: build a solid by stacking equal-count loops along a\n# local w axis and mapping every vertex into the final world frame.\n# Loops are counter-clockwise in the local (u, v) plane, so the canonical\n# winding below produces outward normals for a right-handed (u, v, w) triple;\n# every map used here has determinant +1, so orientation is preserved.\n# ---------------------------------------------------------------------------\n\n\ndef _loop_rrect(hw: float, hh: float, r: float, seg: int = 6):\n    \"\"\"Counter-clockwise rounded rectangle loop centred on the local origin.\"\"\"\n    hw = max(hw, 2e-4)\n    hh = max(hh, 2e-4)\n    r = max(2e-4, min(r, hw * 0.98, hh * 0.98))\n    cx, cy = hw - r, hh - r\n    corners = (\n        (cx, cy, 0.0),\n        (-cx, cy, math.pi / 2.0),\n        (-cx, -cy, math.pi),\n        (cx, -cy, 1.5 * math.pi),\n    )\n    pts = []\n    for k, (ox, oy, a0) in enumerate(corners):\n        for i in range(seg + 1):\n            if k > 0 and i == 0:\n                continue\n            a = a0 + (math.pi / 2.0) * i / seg\n            pts.append((ox + r * math.cos(a), oy + r * math.sin(a)))\n    return pts\n\n\ndef _build_mesh(sections, to_world):\n    \"\"\"sections: [(w, [(u, v), ...]), ...]; to_world(u, v, w) -> (x, y, z).\"\"\"\n    geom = MeshGeometry()\n    rows = []\n    for w, loop in sections:\n        rows.append([geom.add_vertex(*to_world(u, v, w)) for (u, v) in loop])\n    n = len(rows[0])\n    for k in range(len(rows) - 1):\n        a, b = rows[k], rows[k + 1]\n        for j in range(n):\n            j2 = (j + 1) % n\n            geom.add_face(a[j], a[j2], b[j2])\n            geom.add_face(a[j], b[j2], b[j])\n\n    def _centre(w, loop):\n        cu = sum(p[0] for p in loop) / len(loop)\n        cv = sum(p[1] for p in loop) / len(loop)\n        return geom.add_vertex(*to_world(cu, cv, w))\n\n    c0 = _centre(*sections[0])\n    for j in range(n):\n        geom.add_face(c0, rows[0][(j + 1) % n], rows[0][j])\n    c1 = _centre(*sections[-1])\n    for j in range(n):\n        geom.add_face(c1, rows[-1][j], rows[-1][(j + 1) % n])\n    return geom\n\n\ndef _rim_profile(thickness: float, rim_r: float, seg: int = 4):\n    \"\"\"(w, inset) stations for a slab with rounded top and bottom rims.\"\"\"\n    stations = [(0.0, rim_r)]\n    for i in range(1, seg + 1):\n        a = (math.pi / 2.0) * i / seg\n        stations.append((rim_r * (1.0 - math.cos(a)), rim_r * (1.0 - math.sin(a))))\n    for i in range(seg, -1, -1):\n        a = (math.pi / 2.0) * i / seg\n        stations.append(\n            (thickness - rim_r * (1.0 - math.cos(a)), rim_r * (1.0 - math.sin(a)))\n        )\n    return stations\n\n\ndef _seat_mesh(name: str):\n    hw, hd = SEAT_W / 2.0, SEAT_D / 2.0\n\n    def to_world(u, v, w):\n        # local (u, v) -> world (x, -z); local w -> world height above the floor\n        return (u, w + SEAT_BOT, -v)\n\n    sections = [\n        (w, _loop_rrect(hw - e, hd - e, SEAT_RC - e, 7))\n        for w, e in _rim_profile(SEAT_T, SEAT_RE)\n    ]\n    return mesh_from_geometry(_build_mesh(sections, to_world), name)\n\n\ndef _leg_mesh(name: str, translate):\n    def to_world(u, v, w):\n        return (u + translate[0], w + translate[1], -v + translate[2])\n\n    stations = [(0.0, LEG_FOOT_SEC), (LEG_KNEE_Y - FLOOR, LEG_SEC), (LEG_LEN, LEG_SEC)]\n    sections = []\n    for w, sec in stations:\n        sections.append((w, _loop_rrect(sec / 2.0, sec / 2.0, 0.006, 4)))\n    return mesh_from_geometry(_build_mesh(sections, to_world), name)\n\n\ndef _post_mesh(name: str, translate_x: float):\n    def to_world(u, v, w):\n        c, s = math.cos(-RAKE), math.sin(-RAKE)\n        x, y, z = u, w, -v\n        y2 = y * c - z * s\n        z2 = y * s + z * c\n        return (x + translate_x, y2 + POST_BOT_Y, z2 + POST_Z)\n\n    sections = [\n        (0.0, _loop_rrect(LEG_SEC / 2.0, LEG_SEC / 2.0, 0.006, 4)),\n        (POST_LEN, _loop_rrect(LEG_SEC / 2.0, LEG_SEC / 2.0, 0.006, 4)),\n    ]\n    return mesh_from_geometry(_build_mesh(sections, to_world), name)\n\n\ndef _panel_mesh(name: str):\n    hh = PANEL_H / 2.0\n    y_mid = 0.5 * (PANEL_BOT_Y + PANEL_TOP_Y)\n    centre = (0.0, y_mid, _post_axis_z(y_mid))\n\n    def to_world(u, v, w):\n        c, s = math.cos(-RAKE), math.sin(-RAKE)\n        y2 = v * c - w * s\n        z2 = v * s + w * c\n        return (u + centre[0], y2 + centre[1], z2 + centre[2])\n\n    sections = []\n    for w, e in _rim_profile(PANEL_T, PANEL_RE, 3):\n        sections.append(\n            (w - PANEL_T / 2.0, _loop_rrect(PANEL_HW - e, hh - e, PANEL_RC - e, 7))\n        )\n    return mesh_from_geometry(_build_mesh(sections, to_world), name)\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"wooden_chair\")\n    model.material(\"oak_frame\", rgba=(0.52, 0.35, 0.21, 1.0))\n    model.material(\"oak_seat\", rgba=(0.60, 0.42, 0.26, 1.0))\n\n    seat = model.part(\"seat\")\n    seat.visual(\n        _seat_mesh(\"seat_slab_mesh\"),\n        origin=Origin(),\n        material=\"oak_seat\",\n        name=\"seat_slab\",\n    )\n\n    # ---- legs (four identical tapered posts under the seat) ---------------\n    leg_specs = [\n        (\"leg_front_left\", -LEG_X, FRONT_LEG_Z),\n        (\"leg_front_right\", LEG_X, FRONT_LEG_Z),\n        (\"leg_rear_left\", -LEG_X, REAR_LEG_Z),\n        (\"leg_rear_right\", LEG_X, REAR_LEG_Z),\n    ]\n    legs = {}\n    for part_name, x, z in leg_specs:\n        leg = model.part(part_name)\n        leg.visual(\n            _leg_mesh(f\"{part_name}_mesh\", (x, FLOOR, z)),\n            origin=Origin(),\n            material=\"oak_frame\",\n            name=\"leg_post\",\n        )\n        legs[part_name] = leg\n        model.articulation(\n            f\"seat_to_{part_name}\",\n            ArticulationType.FIXED,\n            parent=seat,\n            child=leg,\n            origin=Origin(),\n        )\n\n    # ---- stretchers -------------------------------------------------------\n    half = LEG_SEC / 2.0\n    inner_z_front = FRONT_LEG_Z - half\n    inner_z_rear = REAR_LEG_Z + half\n    side_len = (inner_z_front - inner_z_rear) + 2.0 * EMBED\n    side_center_z = 0.5 * (inner_z_front + inner_z_rear)\n    cross_span = 2.0 * (LEG_X - half + EMBED)\n\n    stretcher_specs = [\n        (\"stretcher_side_left\", side_len, (-LEG_X, STRETCHER_Y, side_center_z), None),\n        (\"stretcher_side_right\", side_len, (LEG_X, STRETCHER_Y, side_center_z), None),\n        (\"stretcher_front\", cross_span, (0.0, STRETCHER_Y, FRONT_LEG_Z), (0.0, math.pi / 2.0, 0.0)),\n        (\"stretcher_rear\", cross_span, (0.0, STRETCHER_Y, REAR_LEG_Z), (0.0, math.pi / 2.0, 0.0)),\n    ]\n    stretchers = {}\n    for part_name, length, xyz, rpy in stretcher_specs:\n        rail = model.part(part_name)\n        rail.visual(\n            Cylinder(radius=STRETCHER_R, length=length),\n            origin=Origin(xyz=xyz, rpy=rpy or (0.0, 0.0, 0.0)),\n            material=\"oak_frame\",\n            name=\"stretcher_rail\",\n        )\n        stretchers[part_name] = rail\n        model.articulation(\n            f\"seat_to_{part_name}\",\n            ArticulationType.FIXED,\n            parent=seat,\n            child=rail,\n            origin=Origin(),\n        )\n\n    # ---- back posts -------------------------------------------------------\n    posts = {}\n    for part_name, x in ((\"back_post_left\", -LEG_X), (\"back_post_right\", LEG_X)):\n        post = model.part(part_name)\n        post.visual(\n            _post_mesh(f\"{part_name}_mesh\", x),\n            origin=Origin(),\n            material=\"oak_frame\",\n            name=\"back_post\",\n        )\n        posts[part_name] = post\n        model.articulation(\n            f\"seat_to_{part_name}\",\n            ArticulationType.FIXED,\n            parent=seat,\n            child=post,\n            origin=Origin(),\n        )\n\n    # ---- back panel -------------------------------------------------------\n    backrest = model.part(\"backrest\")\n    backrest.visual(\n        _panel_mesh(\"backrest_panel_mesh\"),\n        origin=Origin(),\n        material=\"oak_frame\",\n        name=\"back_panel\",\n    )\n    model.articulation(\n        \"seat_to_backrest\",\n        ArticulationType.FIXED,\n        parent=seat,\n        child=backrest,\n        origin=Origin(),\n    )\n\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    seat = object_model.get_part(\"seat\")\n    backrest = object_model.get_part(\"backrest\")\n    legs = {\n        name: object_model.get_part(name)\n        for name in (\n            \"leg_front_left\",\n            \"leg_front_right\",\n            \"leg_rear_left\",\n            \"leg_rear_right\",\n        )\n    }\n    posts = {\n        name: object_model.get_part(name)\n        for name in (\"back_post_left\", \"back_post_right\")\n    }\n    stretchers = {\n        name: object_model.get_part(name)\n        for name in (\n            \"stretcher_side_left\",\n            \"stretcher_side_right\",\n            \"stretcher_front\",\n            \"stretcher_rear\",\n        )\n    }\n\n    # --- overall envelope ---------------------------------------------------\n    mins = [1e9, 1e9, 1e9]\n    maxs = [-1e9, -1e9, -1e9]\n    for part in object_model.parts:\n        box = ctx.part_world_aabb(part)\n        if box is None:\n            continue\n        for axis in range(3):\n            mins[axis] = min(mins[axis], box[0][axis])\n            maxs[axis] = max(maxs[axis], box[1][axis])\n    dims = [maxs[i] - mins[i] for i in range(3)]\n\n    ctx.check(\n        \"chair_is_grounded\",\n        abs(mins[1] - FLOOR) < 0.002,\n        f\"lowest point {mins[1]:.4f} should sit on the floor {FLOOR:.4f}\",\n    )\n    ctx.check(\"overall_height_near_0_90m\", 0.87 < dims[1] < 0.93, f\"height {dims[1]:.3f}\")\n    ctx.check(\"overall_width_near_0_45m\", 0.42 < dims[0] < 0.50, f\"width {dims[0]:.3f}\")\n    ctx.check(\"overall_depth_near_0_50m\", 0.43 < dims[2] < 0.52, f\"depth {dims[2]:.3f}\")\n    ctx.check(\n        \"upper_frame_centred_on_origin\",\n        abs(mins[0] + maxs[0]) < 0.01,\n        f\"x [{mins[0]:.3f},{maxs[0]:.3f}]\",\n    )\n\n    # --- seat height --------------------------------------------------------\n    seat_box = ctx.part_world_aabb(seat)\n    ctx.check(\n        \"seat_top_height_about_0_45m\",\n        abs(seat_box[1][1] - (FLOOR + 0.45)) < 0.003,\n        f\"seat top {seat_box[1][1]:.4f} vs floor+0.45 {FLOOR + 0.45:.4f}\",\n    )\n    ctx.check(\n        \"seat_thickness_about_35mm\",\n        0.030 < (seat_box[1][1] - seat_box[0][1]) < 0.040,\n        f\"seat thickness {seat_box[1][1] - seat_box[0][1]:.4f}\",\n    )\n\n    # --- legs carry the seat ------------------------------------------------\n    for name, leg in legs.items():\n        ctx.expect_contact(\n            leg,\n            seat,\n            elem_a=\"leg_post\",\n            elem_b=\"seat_slab\",\n            name=f\"{name} meets the seat\",\n        )\n\n    # --- stretchers are carried by their legs ------------------------------\n    ctx.expect_contact(\n        stretchers[\"stretcher_front\"],\n        legs[\"leg_front_left\"],\n        elem_a=\"stretcher_rail\",\n        elem_b=\"leg_post\",\n        name=\"front stretcher meets left front leg\",\n    )\n    ctx.expect_contact(\n        stretchers[\"stretcher_front\"],\n        legs[\"leg_front_right\"],\n        elem_a=\"stretcher_rail\",\n        elem_b=\"leg_post\",\n        name=\"front stretcher meets right front leg\",\n    )\n    ctx.expect_contact(\n        stretchers[\"stretcher_rear\"],\n        legs[\"leg_rear_left\"],\n        elem_a=\"stretcher_rail\",\n        elem_b=\"leg_post\",\n        name=\"rear stretcher meets left rear leg\",\n    )\n    ctx.expect_contact(\n        stretchers[\"stretcher_rear\"],\n        legs[\"leg_rear_right\"],\n        elem_a=\"stretcher_rail\",\n        elem_b=\"leg_post\",\n        name=\"rear stretcher meets right rear leg\",\n    )\n    for side in (\"left\", \"right\"):\n        stretcher = stretchers[f\"stretcher_side_{side}\"]\n        ctx.expect_contact(\n            stretcher,\n            legs[f\"leg_front_{side}\"],\n            elem_a=\"stretcher_rail\",\n            elem_b=\"leg_post\",\n            name=f\"{side} stretcher meets front leg\",\n        )\n        ctx.expect_contact(\n            stretcher,\n            legs[f\"leg_rear_{side}\"],\n            elem_a=\"stretcher_rail\",\n            elem_b=\"leg_post\",\n            name=f\"{side} stretcher meets rear leg\",\n        )\n\n    # --- back posts sit on the seat and carry the panel --------------------\n    for side in (\"left\", \"right\"):\n        post = posts[f\"back_post_{side}\"]\n        ctx.expect_contact(\n            post,\n            seat,\n            elem_a=\"back_post\",\n            elem_b=\"seat_slab\",\n            name=f\"{side} back post stands on the seat\",\n        )\n        ctx.expect_contact(\n            backrest,\n            post,\n            elem_a=\"back_panel\",\n            elem_b=\"back_post\",\n            name=f\"back panel is jointed into the {side} post\",\n        )\n    ctx.expect_within(\n        backrest,\n        seat,\n        axes=\"x\",\n        inner_elem=\"back_panel\",\n        outer_elem=\"seat_slab\",\n        margin=1e-6,\n        name=\"panel fits between the posts within the seat width\",\n    )\n    ctx.expect_within(\n        backrest,\n        seat,\n        axes=\"z\",\n        inner_elem=\"back_panel\",\n        outer_elem=\"seat_slab\",\n        margin=1e-6,\n        name=\"panel sits over the seat depth\",\n    )\n\n    back_box = ctx.part_world_aabb(backrest)\n    ctx.check(\n        \"back_panel_above_seat\",\n        back_box[0][1] > SEAT_TOP + 0.09,\n        f\"back panel bottom {back_box[0][1]:.3f}\",\n    )\n    ctx.check(\n        \"back_panel_height_about_0_32m\",\n        0.28 < (back_box[1][1] - back_box[0][1]) < 0.36,\n        f\"panel height {back_box[1][1] - back_box[0][1]:.3f}\",\n    )\n    ctx.check(\n        \"back_panel_ends_span_the_posts\",\n        (back_box[1][0] - back_box[0][0]) > 0.30,\n        f\"panel width {back_box[1][0] - back_box[0][0]:.3f}\",\n    )\n    ctx.check(\n        \"back_panel_top_level_with_posts\",\n        abs(back_box[1][1] - maxs[1]) < 0.02,\n        f\"panel top {back_box[1][1]:.3f} vs post top {maxs[1]:.3f}\",\n    )\n\n    # --- back posts lean back ----------------------------------------------\n    for side in (\"left\", \"right\"):\n        post = posts[f\"back_post_{side}\"]\n        post_box = ctx.part_world_aabb(post)\n        ctx.check(\n            f\"{side} back post leans backwards\",\n            post_box[0][2] < -0.19,\n            f\"post rear extent {post_box[0][2]:.3f} should pass behind the seat edge\",\n        )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n", "path": "model.py"})
