[round 16] bash({"command": "cat > /tmp/render_top.py << 'EOF'\npath=\".compile_tmp/assets/meshes/dial_face.obj\"\nverts=[]; faces=[]\nfor line in open(path):\n    p=line.split()\n    if not p: continue\n    if p[0]=='v': verts.append(tuple(map(float,p[1:4])))\n    elif p[0]=='f':\n        idx=[int(t.split('/')[0])-1 for t in p[1:]]\n        for k in range(1,len(idx)-1): faces.append((idx[0],idx[k],idx[k+1]))\n# crop window around top numeral (x in [-0.03,0.03], y in [0.075,0.115])\nxmin,xmax,ymin,ymax=-0.035,0.035,0.070,0.120\nW=70;H=30\ngrid=[[None]*W for _ in range(H)]\ndef bary(px,py,a,b,c):\n    d=(b[1]-c[1])*(a[0]-c[0])+(c[0]-b[0])*(a[1]-c[1])\n    if abs(d)<1e-14: return None\n    u=((b[1]-c[1])*(px-c[0])+(c[0]-b[0])*(py-c[1]))/d\n    v=((c[1]-a[1])*(px-c[0])+(a[0]-c[0])*(py-c[1]))/d\n    w=1-u-v\n    if u<-1e-6 or v<-1e-6 or w<-1e-6: return None\n    return (u,v,w)\nfor a,b,c in faces:\n    A=verts[a];B=verts[b];C=verts[c]\n    if max(A[2],B[2],C[2])<0.005: continue\n    xs=[A[0],B[0],C[0]];ys=[A[1],B[1],C[1]]\n    if max(xs)<xmin or min(xs)>xmax or max(ys)<ymin or min(ys)>ymax: continue\n    for r in range(H):\n        py=ymax-(r+0.5)*(ymax-ymin)/H\n        for col in range(W):\n            px=xmin+(col+0.5)*(xmax-xmin)/W\n            w=bary(px,py,A,B,C)\n            if w is None: continue\n            z=w[0]*A[2]+w[1]*B[2]+w[2]*C[2]\n            if grid[r][col] is None or z>grid[r][col]: grid[r][col]=z\nfor r in range(H):\n    line=\"\"\n    for col in range(W):\n        z=grid[r][col]\n        if z is None: line+=\" \"\n        elif z>0.0095: line+=\".\"   # front face\n        else: line+=\"#\"            # engraved pocket\n    print(line)\nEOF\npython3 /tmp/render_top.py"})
