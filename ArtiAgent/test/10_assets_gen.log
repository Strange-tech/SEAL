[round 6] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    Material,\n    MeshGeometry,\n    Origin,\n    TestContext,\n    TestReport,\n    mesh_from_geometry,\n)\n\n# ----------------------------------------------------------------------------\n# A glazed ceramic flower vase.\n#\n# The whole object is one rigid part: a single closed shell of revolution with a\n# real wall thickness, a recessed underside with a foot ring, a rounded bulbous\n# body, a tapered neck and a gently flared rim.  It is modelled from an explicit\n# (radius, height) cross-section revolved about the vertical axis so the bore and\n# the rim opening are genuine openings rather than capped placeholders.\n# ----------------------------------------------------------------------------\n\n# Overall target dimensions (metres).\nH = 0.250          # total height\nR_BODY = 0.060     # maximum body radius (120 mm diameter)\nR_BASE = 0.035     # foot radius\nR_NECK = 0.0395    # neck radius\nR_LIP = 0.050      # flared lip radius\nWALL = 0.005       # nominal wall thickness\nFLOOR_Y = 0.014    # inner floor height above the foot plane (thick base)\n\n# Cross-section as a closed CCW loop in the (radius, height) half plane.\n# Traversed: underside centre -> foot ring -> outer wall up -> rim -> inner\n# wall down -> inner floor -> back to the axis.\nPROFILE = [\n    (0.0000, 0.0035),   # 0  recessed underside centre\n    (0.0200, 0.0035),   # 1  flat recess floor\n    (0.0258, 0.0000),   # 2  foot ring inner contact edge\n    (0.0332, 0.0000),   # 3  foot ring flat bottom\n    (0.0350, 0.0045),   # 4  chamfer to the outer wall\n    (0.0356, 0.0120),   # 5  lower body\n    (0.0415, 0.0185),   # 6\n    (0.0510, 0.0300),   # 7  body bulge begins\n    (0.0575, 0.0450),   # 8\n    (0.0600, 0.0600),   # 9  widest point\n    (0.0595, 0.0780),   # 10\n    (0.0560, 0.1000),   # 11\n    (0.0500, 0.1250),   # 12\n    (0.0442, 0.1500),   # 13 shoulder towards neck\n    (0.0406, 0.1750),   # 14\n    (0.0395, 0.1980),   # 15 neck\n    (0.0400, 0.2180),   # 16\n    (0.0432, 0.2350),   # 17 lip flare\n    (0.0482, 0.2460),   # 18\n    (0.0500, 0.2500),   # 19 rim outer top\n    (0.0456, 0.2500),   # 20 rim inner top\n    (0.0432, 0.2380),   # 21 inner lip\n    (0.0382, 0.2200),   # 22 inner neck\n    (0.0352, 0.2000),   # 23\n    (0.0356, 0.1750),   # 24\n    (0.0392, 0.1500),   # 25 inner shoulder\n    (0.0450, 0.1250),   # 26\n    (0.0510, 0.1000),   # 27\n    (0.0545, 0.0780),   # 28\n    (0.0552, 0.0600),   # 29 inner body (wall ~4.8 mm)\n    (0.0528, 0.0450),   # 30\n    (0.0466, 0.0300),   # 31\n    (0.0362, 0.0185),   # 32\n    (0.0300, 0.0140),   # 33 inner floor edge\n    (0.0000, 0.0140),   # 34 inner floor centre (axis)\n]\n\nSEGMENTS = 96\n\n\ndef _revolve(profile, segments):\n    \"\"\"Revolve a closed (radius, height) loop about the +Y axis (y-up frame).\n\n    Winding: lateral quads are emitted as (a_j, a_j2, b_j2, b_j) so the surface\n    normals point out of the material.  Points on the axis collapse to a single\n    apex vertex and become triangle fans.\n    \"\"\"\n    verts = []\n    rings = []\n    for r, y in profile:\n        if r <= 1e-9:\n            apex = len(verts)\n            verts.append((0.0, y, 0.0))\n            rings.append([apex] * segments)\n        else:\n            ring = []\n            for j in range(segments):\n                theta = 2.0 * math.pi * j / segments\n                ring.append(len(verts))\n                verts.append((r * math.sin(theta), y, r * math.cos(theta)))\n            rings.append(ring)\n\n    faces = []\n    n = len(profile)\n    for i in range(n):\n        i2 = (i + 1) % n\n        ra_r = profile[i][0]\n        rb_r = profile[i2][0]\n        if ra_r <= 1e-9 and rb_r <= 1e-9:\n            continue\n        ra = rings[i]\n        rb = rings[i2]\n        for j in range(segments):\n            j2 = (j + 1) % segments\n            if ra_r <= 1e-9:\n                faces.append((ra[0], rb[j2], rb[j]))\n            elif rb_r <= 1e-9:\n                faces.append((ra[j], ra[j2], rb[0]))\n            else:\n                faces.append((ra[j], ra[j2], rb[j2], rb[j]))\n    return verts, faces\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"flower_vase\")\n\n    # Centre the vase vertically on the world origin, keeping +Y up.\n    y_shift = -H / 2.0\n\n    verts, faces = _revolve(PROFILE, SEGMENTS)\n    geom = MeshGeometry()\n    for (x, y, z) in verts:\n        geom.add_vertex((x, y + y_shift, z))\n    for f in faces:\n        geom.add_face(f)\n\n    glaze = Material(name=\"celadon_glaze\", rgba=(0.745, 0.808, 0.766, 1.0))\n\n    vase = model.part(\"vase\")\n    vase.visual(\n        mesh_from_geometry(geom, \"vase_shell\"),\n        origin=Origin(),\n        material=glaze,\n        name=\"vase_shell\",\n    )\n\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    vase = object_model.get_part(\"vase\")\n\n    aabb = ctx.part_element_world_aabb(vase, elem=\"vase_shell\")\n    if aabb is not None:\n        (xmin, ymin, zmin), (xmax, ymax, zmax) = aabb\n        dx = xmax - xmin\n        dy = ymax - ymin\n        dz = zmax - zmin\n        cx = 0.5 * (xmin + xmax)\n        cy = 0.5 * (ymin + ymax)\n        cz = 0.5 * (zmin + zmax)\n\n        ctx.check(\n            \"vase overall height ~0.25 m\",\n            0.235 <= dy <= 0.265,\n            details=f\"height={dy:.4f}\",\n        )\n        ctx.check(\n            \"vase maximum body diameter ~0.12 m\",\n            0.110 <= dx <= 0.130 and 0.110 <= dz <= 0.130,\n            details=f\"width={dx:.4f} depth={dz:.4f}\",\n        )\n        ctx.check(\n            \"vase roughly circular in plan\",\n            abs(dx - dz) <= 0.004,\n            details=f\"width={dx:.4f} depth={dz:.4f}\",\n        )\n        ctx.check(\n            \"vase centred on the world origin\",\n            abs(cx) <= 0.002 and abs(cy) <= 0.01 and abs(cz) <= 0.002,\n            details=f\"centre=({cx:.4f},{cy:.4f},{cz:.4f})\",\n        )\n\n    # The shell must be hollow: the inner floor sits above the foot plane and\n    # the widest interior radius is meaningfully smaller than the exterior.\n    ctx.check(\n        \"wall thickness leaves a real bore\",\n        FLOOR_Y >= 0.010 and (R_BODY - 0.0552) >= 0.0035,\n        details=f\"floor={FLOOR_Y}, body wall={R_BODY - 0.0552:.4f}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
