[round 5] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Cylinder,\n    MeshGeometry,\n    Origin,\n    TestContext,\n    TestReport,\n    mesh_from_geometry,\n)\n\n# ---------------------------------------------------------------------------\n# Dimensions (metres).  World frame: +Y = up, +Z = front (toward the sitter),\n# +X = the sitter's right-hand side as seen from the front.  The chair spans\n# y in [-0.45, +0.45] so its geometric centre sits on the world origin.\n# ---------------------------------------------------------------------------\n\nFLOOR = -0.45\nSEAT_TOP = 0.0\nSEAT_T = 0.035\nSEAT_W = 0.45\nSEAT_D = 0.47\nSEAT_RC = 0.035  # plan-view corner radius\nSEAT_RE = 0.008  # rounded rim radius (top and bottom edges)\nSEAT_BOT = SEAT_TOP - SEAT_T\n\nLEG_X = 0.19\nFRONT_LEG_Z = 0.19\nREAR_LEG_Z_BOT = -0.15\nRAKE = 0.05  # rear posts lean back by this angle (rad)\nLEG_BOT_SEC = 0.034\nLEG_TOP_SEC = 0.046\n\nFRONT_LEG_TOP = SEAT_BOT + 0.0015  # small embed into the seat underside\nFRONT_LEG_LEN = FRONT_LEG_TOP - FLOOR\n\nREAR_LEG_LEN = (0.45 - FLOOR) / math.cos(RAKE)\n\nSTRETCHER_Y = -0.27\nSTRETCHER_R = 0.011\nSTRETCHER_EMBED = 0.002\n\nPANEL_BOT_Y = 0.12\nPANEL_TOP_Y = 0.44\nPANEL_H = PANEL_TOP_Y - PANEL_BOT_Y\nPANEL_TOP_W = 0.40\nPANEL_BOT_W = 0.355\nPANEL_T = 0.022\nPANEL_RC = 0.03\nPANEL_RE = 0.006\nPANEL_EMBED = 0.0015\n\n\n# ---------------------------------------------------------------------------\n# Small mesh toolkit: build a solid by stacking equal-count loops along a\n# local w axis and mapping every vertex into the final world frame.\n# Loops are counter-clockwise in the local (u, v) plane, so the canonical\n# winding below produces outward normals for a right-handed (u, v, w) triple;\n# every map used here has determinant +1, so orientation is preserved.\n# ---------------------------------------------------------------------------\n\n\ndef _loop_rrect(hw: float, hh: float, r: float, seg: int = 6):\n    \"\"\"Counter-clockwise rounded rectangle loop centred on the local origin.\"\"\"\n    hw = max(hw, 2e-4)\n    hh = max(hh, 2e-4)\n    r = max(2e-4, min(r, hw * 0.98, hh * 0.98))\n    cx, cy = hw - r, hh - r\n    corners = (\n        (cx, cy, 0.0),\n        (-cx, cy, math.pi / 2.0),\n        (-cx, -cy, math.pi),\n        (cx, -cy, 1.5 * math.pi),\n    )\n    pts = []\n    for k, (ox, oy, a0) in enumerate(corners):\n        for i in range(seg + 1):\n            if k > 0 and i == 0:\n                continue\n            a = a0 + (math.pi / 2.0) * i / seg\n            pts.append((ox + r * math.cos(a), oy + r * math.sin(a)))\n    return pts\n\n\ndef _build_mesh(sections, to_world):\n    \"\"\"sections: [(w, [(u, v), ...]), ...]; to_world(u, v, w) -> (x, y, z).\"\"\"\n    geom = MeshGeometry()\n    rows = []\n    for w, loop in sections:\n        rows.append([geom.add_vertex(*to_world(u, v, w)) for (u, v) in loop])\n    n = len(rows[0])\n    for k in range(len(rows) - 1):\n        a, b = rows[k], rows[k + 1]\n        for j in range(n):\n            j2 = (j + 1) % n\n            geom.add_face(a[j], a[j2], b[j2])\n            geom.add_face(a[j], b[j2], b[j])\n\n    def _center(w, loop):\n        cu = sum(p[0] for p in loop) / len(loop)\n        cv = sum(p[1] for p in loop) / len(loop)\n        return geom.add_vertex(*to_world(cu, cv, w))\n\n    c0 = _center(*sections[0])\n    for j in range(n):\n        geom.add_face(c0, rows[0][(j + 1) % n], rows[0][j])\n    c1 = _center(*sections[-1])\n    for j in range(n):\n        geom.add_face(c1, rows[-1][j], rows[-1][(j + 1) % n])\n    return geom\n\n\ndef _rim_profile(thickness: float, rim_r: float, seg: int = 4):\n    \"\"\"(w, inset) stations for a slab with rounded top and bottom rims.\"\"\"\n    stations = [(0.0, rim_r)]\n    for i in range(1, seg + 1):\n        a = (math.pi / 2.0) * i / seg\n        stations.append((rim_r * (1.0 - math.cos(a)), rim_r * (1.0 - math.sin(a))))\n    for i in range(seg, -1, -1):\n        a = (math.pi / 2.0) * i / seg\n        stations.append(\n            (thickness - rim_r * (1.0 - math.cos(a)), rim_r * (1.0 - math.sin(a)))\n        )\n    return stations\n\n\ndef _seat_visual(name: str):\n    hw, hd = SEAT_W / 2.0, SEAT_D / 2.0\n\n    def to_world(u, v, w):\n        # local (u, v) -> world (x, -z); local w -> world height above the floor\n        return (u, w + SEAT_BOT, -v)\n\n    sections = []\n    for w, e in _rim_profile(SEAT_T, SEAT_RE):\n        sections.append((w, _loop_rrect(hw - e, hd - e, SEAT_RC - e, 7)))\n    geom = _build_mesh(sections, to_world)\n    return mesh_from_geometry(geom, name)\n\n\ndef _front_leg_half(y: float) -> float:\n    f = min(1.0, max(0.0, (y - FLOOR) / FRONT_LEG_LEN))\n    return 0.5 * (LEG_BOT_SEC + (LEG_TOP_SEC - LEG_BOT_SEC) * f)\n\n\ndef _rear_post_axis_z(y: float) -> float:\n    return REAR_LEG_Z_BOT - (y - FLOOR) * math.tan(RAKE)\n\n\ndef _rear_leg_half(y: float) -> float:\n    axial = (y - FLOOR) / math.cos(RAKE)\n    f = min(1.0, max(0.0, axial / REAR_LEG_LEN))\n    return 0.5 * (LEG_BOT_SEC + (LEG_TOP_SEC - LEG_BOT_SEC) * f)\n\n\ndef _post_visual(name: str, length: float, rake: float, translate):\n    def to_world(u, v, w):\n        c, s = math.cos(rake), math.sin(rake)\n        x, y, z = u, w, -v\n        y2 = y * c - z * s\n        z2 = y * s + z * c\n        return (x + translate[0], y2 + translate[1], z2 + translate[2])\n\n    sections = []\n    for step in range(3):\n        w = length * step / 2.0\n        f = step / 2.0\n        sec = LEG_BOT_SEC + (LEG_TOP_SEC - LEG_BOT_SEC) * f\n        sections.append((w, _loop_rrect(sec / 2.0, sec / 2.0, 0.006, 4)))\n    geom = _build_mesh(sections, to_world)\n    return mesh_from_geometry(geom, name)\n\n\ndef _backrest_visual(name: str):\n    hh = PANEL_H / 2.0\n    hw = PANEL_TOP_W / 2.0\n    n_front = (0.0, math.sin(RAKE), math.cos(RAKE))\n\n    # Seat the panel 1.5 mm into the front faces of both rear posts so the\n    # mounting reads as a real joint (a tiny, hidden embed).\n    y_ref = 0.5 * (PANEL_BOT_Y + PANEL_TOP_Y)\n    axis_pt = (0.0, y_ref, _rear_post_axis_z(y_ref))\n    half = _rear_leg_half(y_ref)\n    face_pt = tuple(axis_pt[i] + half * n_front[i] for i in range(3))\n    back_pt = tuple(face_pt[i] - PANEL_EMBED * n_front[i] for i in range(3))\n    center = tuple(back_pt[i] + 0.5 * PANEL_T * n_front[i] for i in range(3))\n\n    def taper(y: float) -> float:\n        t = (y + hh) / (2.0 * hh)\n        width = PANEL_BOT_W + (PANEL_TOP_W - PANEL_BOT_W) * t\n        return width / PANEL_TOP_W\n\n    def to_world(u, v, w):\n        c, s = math.cos(-RAKE), math.sin(-RAKE)\n        y2 = v * c - w * s\n        z2 = v * s + w * c\n        return (u + center[0], y2 + center[1], z2 + center[2])\n\n    sections = []\n    for w, e in _rim_profile(PANEL_T, PANEL_RE, 3):\n        loop = _loop_rrect(hw - e, hh - e, PANEL_RC - e, 7)\n        sections.append(\n            (w - PANEL_T / 2.0, [(x * taper(y), y) for (x, y) in loop])\n        )\n    geom = _build_mesh(sections, to_world)\n    return mesh_from_geometry(geom, name)\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"wooden_chair\")\n    model.material(\"oak_wood\", rgba=(0.56, 0.38, 0.23, 1.0))\n    model.material(\"oak_wood_seat\", rgba=(0.60, 0.42, 0.26, 1.0))\n\n    seat = model.part(\"seat\")\n    seat.visual(\n        _seat_visual(\"seat_slab_mesh\"),\n        origin=Origin(),\n        material=\"oak_wood_seat\",\n        name=\"seat_slab\",\n    )\n\n    # ---- front legs -------------------------------------------------------\n    leg_specs = [\n        (\"leg_front_left\", -LEG_X, FRONT_LEG_Z, 0.0, FRONT_LEG_LEN, \"leg_post\"),\n        (\"leg_front_right\", LEG_X, FRONT_LEG_Z, 0.0, FRONT_LEG_LEN, \"leg_post\"),\n        (\"leg_rear_left\", -LEG_X, REAR_LEG_Z_BOT, -RAKE, REAR_LEG_LEN, \"rear_post\"),\n        (\"leg_rear_right\", LEG_X, REAR_LEG_Z_BOT, -RAKE, REAR_LEG_LEN, \"rear_post\"),\n    ]\n    legs = {}\n    for order, (part_name, x, z, rake, length, elem) in enumerate(leg_specs):\n        leg = model.part(part_name)\n        leg.visual(\n            _post_visual(f\"{part_name}_mesh\", length, rake, (x, FLOOR, z)),\n            origin=Origin(),\n            material=\"oak_wood\",\n            name=elem,\n        )\n        legs[part_name] = leg\n        model.articulation(\n            f\"seat_to_{part_name}\",\n            ArticulationType.FIXED,\n            parent=seat,\n            child=leg,\n            origin=Origin(),\n        )\n\n    # ---- stretchers -------------------------------------------------------\n    z_front_face = FRONT_LEG_Z - _front_leg_half(STRETCHER_Y)\n    z_rear_face = _rear_post_axis_z(STRETCHER_Y) + _rear_leg_half(STRETCHER_Y) * math.cos(\n        RAKE\n    )\n    side_len = (z_front_face - z_rear_face) + 2.0 * STRETCHER_EMBED\n    side_center_z = 0.5 * (z_front_face + z_rear_face)\n\n    front_span = 2.0 * (LEG_X - _front_leg_half(STRETCHER_Y) + STRETCHER_EMBED)\n    rear_span = 2.0 * (LEG_X - _rear_leg_half(STRETCHER_Y) + STRETCHER_EMBED)\n\n    stretcher_specs = [\n        (\"stretcher_side_left\", side_len, (-LEG_X, STRETCHER_Y, side_center_z), None),\n        (\"stretcher_side_right\", side_len, (LEG_X, STRETCHER_Y, side_center_z), None),\n        (\"stretcher_front\", front_span, (0.0, STRETCHER_Y, FRONT_LEG_Z), (0.0, math.pi / 2.0, 0.0)),\n        (\n            \"stretcher_rear\",\n            rear_span,\n            (0.0, STRETCHER_Y, _rear_post_axis_z(STRETCHER_Y)),\n            (0.0, math.pi / 2.0, 0.0),\n        ),\n    ]\n    stretchers = {}\n    for part_name, length, xyz, rpy in stretcher_specs:\n        rail = model.part(part_name)\n        rail.visual(\n            Cylinder(radius=STRETCHER_R, length=length),\n            origin=Origin(xyz=xyz, rpy=rpy or (0.0, 0.0, 0.0)),\n            material=\"oak_wood\",\n            name=\"stretcher_rail\",\n        )\n        stretchers[part_name] = rail\n        model.articulation(\n            f\"seat_to_{part_name}\",\n            ArticulationType.FIXED,\n            parent=seat,\n            child=rail,\n            origin=Origin(),\n        )\n\n    # ---- backrest ---------------------------------------------------------\n    backrest = model.part(\"backrest\")\n    backrest.visual(\n        _backrest_visual(\"backrest_panel_mesh\"),\n        origin=Origin(),\n        material=\"oak_wood\",\n        name=\"back_panel\",\n    )\n    model.articulation(\n        \"seat_to_backrest\",\n        ArticulationType.FIXED,\n        parent=seat,\n        child=backrest,\n        origin=Origin(),\n    )\n\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    seat = object_model.get_part(\"seat\")\n    backrest = object_model.get_part(\"backrest\")\n    leg_names = (\n        \"leg_front_left\",\n        \"leg_front_right\",\n        \"leg_rear_left\",\n        \"leg_rear_right\",\n    )\n    legs = {name: object_model.get_part(name) for name in leg_names}\n    stretchers = {\n        name: object_model.get_part(name)\n        for name in (\n            \"stretcher_side_left\",\n            \"stretcher_side_right\",\n            \"stretcher_front\",\n            \"stretcher_rear\",\n        )\n    }\n\n    # --- overall envelope ---------------------------------------------------\n    mins = [1e9, 1e9, 1e9]\n    maxs = [-1e9, -1e9, -1e9]\n    for part in object_model.parts:\n        box = ctx.part_world_aabb(part)\n        if box is None:\n            continue\n        for axis in range(3):\n            mins[axis] = min(mins[axis], box[0][axis])\n            maxs[axis] = max(maxs[axis], box[1][axis])\n    dims = [maxs[i] - mins[i] for i in range(3)]\n\n    ctx.check(\n        \"chair_is_upright_and_grounded\",\n        abs(mins[1] - FLOOR) < 0.002,\n        f\"lowest point {mins[1]:.4f} should sit on the floor {FLOOR:.4f}\",\n    )\n    ctx.check(\n        \"overall_height_near_0_90m\",\n        0.86 < dims[1] < 0.94,\n        f\"height {dims[1]:.3f}\",\n    )\n    ctx.check(\n        \"overall_width_near_0_45m\",\n        0.42 < dims[0] < 0.50,\n        f\"width {dims[0]:.3f}\",\n    )\n    ctx.check(\n        \"overall_depth_near_0_50m\",\n        0.42 < dims[2] < 0.52,\n        f\"depth {dims[2]:.3f}\",\n    )\n    ctx.check(\n        \"footprint_centred_on_origin\",\n        abs(mins[0] + maxs[0]) < 0.01 and abs(mins[2] + maxs[2]) < 0.02,\n        f\"x [{mins[0]:.3f},{maxs[0]:.3f}] z [{mins[2]:.3f},{maxs[2]:.3f}]\",\n    )\n\n    # --- seat height --------------------------------------------------------\n    seat_box = ctx.part_world_aabb(seat)\n    ctx.check(\n        \"seat_top_height_about_0_45m\",\n        abs(seat_box[1][1] - (FLOOR + 0.45)) < 0.003,\n        f\"seat top {seat_box[1][1]:.4f} vs floor+0.45 {FLOOR + 0.45:.4f}\",\n    )\n\n    # --- legs are carried by the seat --------------------------------------\n    for name, leg in legs.items():\n        elem = \"rear_post\" if \"rear\" in name else \"leg_post\"\n        ctx.expect_contact(\n            leg,\n            seat,\n            elem_a=elem,\n            elem_b=\"seat_slab\",\n            name=f\"{name} meets the seat\",\n        )\n\n    # --- stretchers are carried by their legs ------------------------------\n    ctx.expect_contact(\n        stretchers[\"stretcher_front\"],\n        legs[\"leg_front_left\"],\n        elem_a=\"stretcher_rail\",\n        elem_b=\"leg_post\",\n        name=\"front stretcher meets left front leg\",\n    )\n    ctx.expect_contact(\n        stretchers[\"stretcher_front\"],\n        legs[\"leg_front_right\"],\n        elem_a=\"stretcher_rail\",\n        elem_b=\"leg_post\",\n        name=\"front stretcher meets right front leg\",\n    )\n    ctx.expect_contact(\n        stretchers[\"stretcher_rear\"],\n        legs[\"leg_rear_left\"],\n        elem_a=\"stretcher_rail\",\n        elem_b=\"rear_post\",\n        name=\"rear stretcher meets left rear leg\",\n    )\n    ctx.expect_contact(\n        stretchers[\"stretcher_rear\"],\n        legs[\"leg_rear_right\"],\n        elem_a=\"stretcher_rail\",\n        elem_b=\"rear_post\",\n        name=\"rear stretcher meets right rear leg\",\n    )\n    for side in (\"left\", \"right\"):\n        stretcher = stretchers[f\"stretcher_side_{side}\"]\n        ctx.expect_contact(\n            stretcher,\n            legs[f\"leg_front_{side}\"],\n            elem_a=\"stretcher_rail\",\n            elem_b=\"leg_post\",\n            name=f\"{side} stretcher meets front leg\",\n        )\n        ctx.expect_contact(\n            stretcher,\n            legs[f\"leg_rear_{side}\"],\n            elem_a=\"stretcher_rail\",\n            elem_b=\"rear_post\",\n            name=f\"{side} stretcher meets rear leg\",\n        )\n\n    # --- backrest is carried by the two rear posts -------------------------\n    ctx.expect_contact(\n        backrest,\n        legs[\"leg_rear_left\"],\n        elem_a=\"back_panel\",\n        elem_b=\"rear_post\",\n        name=\"backrest meets left rear post\",\n    )\n    ctx.expect_contact(\n        backrest,\n        legs[\"leg_rear_right\"],\n        elem_a=\"back_panel\",\n        elem_b=\"rear_post\",\n        name=\"backrest meets right rear post\",\n    )\n    ctx.expect_within(\n        backrest,\n        seat,\n        axes=\"x\",\n        inner_elem=\"back_panel\",\n        outer_elem=\"seat_slab\",\n        margin=1e-6,\n        name=\"backrest is no wider than the seat\",\n    )\n    back_box = ctx.part_world_aabb(backrest)\n    ctx.check(\n        \"back_panel_above_seat\",\n        back_box[0][1] > SEAT_TOP + 0.09,\n        f\"back panel bottom {back_box[0][1]:.3f}\",\n    )\n    ctx.check(\n        \"back_panel_height_about_0_32m\",\n        0.28 < (back_box[1][1] - back_box[0][1]) < 0.36,\n        f\"panel height {back_box[1][1] - back_box[0][1]:.3f}\",\n    )\n    ctx.check(\n        \"back_panel_top_level_with_posts\",\n        abs(back_box[1][1] - maxs[1]) < 0.02,\n        f\"panel top {back_box[1][1]:.3f} vs post top {maxs[1]:.3f}\",\n    )\n\n    # --- rear posts pass through mortises in the seat ----------------------\n    for side in (\"left\", \"right\"):\n        leg = legs[f\"leg_rear_{side}\"]\n        ctx.allow_overlap(\n            seat,\n            leg,\n            elem_a=\"seat_slab\",\n            elem_b=\"rear_post\",\n            reason=(\n                \"The rear post continues through a mortise in the seat slab; the \"\n                \"post is a single continuous member from floor to backrest.\"\n            ),\n        )\n        ctx.expect_overlap(\n            leg,\n            seat,\n            axes=\"x\",\n            elem_a=\"rear_post\",\n            elem_b=\"seat_slab\",\n            min_overlap=0.02,\n            name=f\"{side} rear post stays inside the seat footprint\",\n        )\n        leg_box = ctx.part_world_aabb(leg)\n        ctx.check(\n            f\"{side} rear post rises above the seat\",\n            leg_box[1][1] > SEAT_TOP + 0.35,\n            f\"post top {leg_box[1][1]:.3f}\",\n        )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
