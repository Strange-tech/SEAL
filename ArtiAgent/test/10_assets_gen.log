[round 4] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Box,\n    Cylinder,\n    Sphere,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    LatheGeometry,\n    CylinderGeometry,\n    SphereGeometry,\n    mesh_from_geometry,\n)\n\nPI = math.pi\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"desk_lamp\")\n\n    # ---- materials -------------------------------------------------------\n    m_steel = model.material(\"powder_steel\", color=(0.14, 0.15, 0.16))\n    m_alu = model.material(\"aluminum\", color=(0.72, 0.73, 0.75))\n    m_alu_in = model.material(\"aluminum_inner\", color=(0.86, 0.86, 0.84))\n    m_black = model.material(\"black_plastic\", color=(0.03, 0.03, 0.04))\n    m_rubber = model.material(\"rubber\", color=(0.02, 0.02, 0.02))\n    m_silver = model.material(\"hinge_silver\", color=(0.36, 0.37, 0.42))\n    m_label = model.material(\"label\", color=(0.85, 0.85, 0.82))\n    m_bulb = model.material(\"bulb\", color=(1.0, 0.96, 0.82))\n\n    # ---- kinematic layout (world: +Y up, +Z front, +X width) -------------\n    S = (0.0, 0.056, 0.0)  # shoulder pivot on top of the base post\n\n    a1 = math.radians(-22.0)  # lower arm leans back over the base\n    d1 = (0.0, math.cos(a1), math.sin(a1))\n    L1 = 0.28\n    E = (S[0] + L1 * d1[0], S[1] + L1 * d1[1], S[2] + L1 * d1[2])  # elbow\n\n    a2 = math.radians(50.0)  # upper arm leans forward\n    d2 = (0.0, math.cos(a2), math.sin(a2))\n    L2 = 0.26\n    Head = (E[0] + L2 * d2[0], E[1] + L2 * d2[1], E[2] + L2 * d2[2])\n\n    def add_hinge(part, J, cover_name):\n        jx, jy, jz = J\n        part.visual(\n            Cylinder(radius=0.016, length=0.032),\n            origin=Origin(xyz=J, rpy=(0.0, PI / 2, 0.0)),\n            material=m_black,\n            name=cover_name,\n        )\n        # friction knob on the outboard (+X) side\n        part.visual(\n            Cylinder(radius=0.013, length=0.010),\n            origin=Origin(xyz=(jx + 0.020, jy, jz), rpy=(0.0, PI / 2, 0.0)),\n            material=m_silver,\n            name=cover_name + \"_knob\",\n        )\n        # small bolt cap on the inboard (-X) side\n        part.visual(\n            Cylinder(radius=0.009, length=0.006),\n            origin=Origin(xyz=(jx - 0.019, jy, jz), rpy=(0.0, PI / 2, 0.0)),\n            material=m_silver,\n            name=cover_name + \"_bolt\",\n        )\n\n    # ---- base (root) -----------------------------------------------------\n    base = model.part(\"base\")\n    base.visual(\n        Cylinder(radius=0.090, length=0.026),\n        origin=Origin(xyz=(0.0, 0.023, 0.0), rpy=(-PI / 2, 0.0, 0.0)),\n        material=m_steel,\n        name=\"base_disc\",\n    )\n    base.visual(\n        Cylinder(radius=0.065, length=0.012),\n        origin=Origin(xyz=(0.0, 0.042, 0.0), rpy=(-PI / 2, 0.0, 0.0)),\n        material=m_steel,\n        name=\"base_dome\",\n    )\n    base.visual(\n        Cylinder(radius=0.020, length=0.014),\n        origin=Origin(xyz=(0.0, 0.049, 0.0), rpy=(-PI / 2, 0.0, 0.0)),\n        material=m_steel,\n        name=\"base_post\",\n    )\n    for i, (fx, fz) in enumerate(\n        [(0.055, 0.055), (-0.055, 0.055), (0.055, -0.055), (-0.055, -0.055)]\n    ):\n        base.visual(\n            Cylinder(radius=0.013, length=0.010),\n            origin=Origin(xyz=(fx, 0.005, fz), rpy=(-PI / 2, 0.0, 0.0)),\n            material=m_rubber,\n            name=f\"foot_{i}\",\n        )\n    # rocker switch on the base top, near the front\n    base.visual(\n        Box((0.036, 0.006, 0.020)),\n        origin=Origin(xyz=(0.0, 0.050, 0.032)),\n        material=m_black,\n        name=\"switch_plate\",\n    )\n    base.visual(\n        Box((0.028, 0.010, 0.012)),\n        origin=Origin(xyz=(0.0, 0.055, 0.032), rpy=(0.18, 0.0, 0.0)),\n        material=m_black,\n        name=\"switch_rocker\",\n    )\n    # recessed underside rating label\n    base.visual(\n        Cylinder(radius=0.045, length=0.002),\n        origin=Origin(xyz=(0.0, 0.009, 0.0), rpy=(-PI / 2, 0.0, 0.0)),\n        material=m_label,\n        name=\"underside_label\",\n    )\n\n    # ---- lower arm -------------------------------------------------------\n    lower = model.part(\"lower_arm\")\n    c1 = ((E[0] - S[0]) / 2, (E[1] - S[1]) / 2, (E[2] - S[2]) / 2)\n    lower.visual(\n        Box((0.022, L1, 0.014)),\n        origin=Origin(xyz=c1, rpy=(a1, 0.0, 0.0)),\n        material=m_steel,\n        name=\"lower_tube\",\n    )\n    add_hinge(lower, (0.0, 0.0, 0.0), \"shoulder_cover\")\n\n    # ---- upper arm -------------------------------------------------------\n    upper = model.part(\"upper_arm\")\n    c2 = ((Head[0] - E[0]) / 2, (Head[1] - E[1]) / 2, (Head[2] - E[2]) / 2)\n    upper.visual(\n        Box((0.022, L2, 0.014)),\n        origin=Origin(xyz=c2, rpy=(a2, 0.0, 0.0)),\n        material=m_steel,\n        name=\"upper_tube\",\n    )\n    add_hinge(upper, (0.0, 0.0, 0.0), \"elbow_cover\")\n    add_hinge(upper, (Head[0] - E[0], Head[1] - E[1], Head[2] - E[2]), \"head_cover\")\n\n    # ---- shade (conical, open front, internal socket) --------------------\n    shade = model.part(\"shade\")\n    # local +Z is the shade axis; rotate so it points forward/down from the head\n    alpha = math.asin(0.45)\n    rpy_s = (alpha, 0.0, 0.0)\n\n    cone = LatheGeometry.from_shell_profiles(\n        [(0.022, 0.0), (0.070, 0.20)],\n        [(0.018, 0.0), (0.066, 0.20)],\n        segments=48,\n        start_cap=\"flat\",\n        end_cap=\"flat\",\n    )\n    shade.visual(\n        mesh_from_geometry(cone, \"shade_cone\"),\n        origin=Origin(rpy=rpy_s),\n        material=m_alu,\n        name=\"shade_cone\",\n    )\n\n    capc = CylinderGeometry(0.021, 0.006)\n    capc.translate(0.0, 0.0, 0.003)\n    shade.visual(\n        mesh_from_geometry(capc, \"shade_back\"),\n        origin=Origin(rpy=rpy_s),\n        material=m_alu_in,\n        name=\"shade_back\",\n    )\n\n    sock = CylinderGeometry(0.014, 0.036)\n    sock.translate(0.0, 0.0, 0.024)\n    shade.visual(\n        mesh_from_geometry(sock, \"shade_socket\"),\n        origin=Origin(rpy=rpy_s),\n        material=m_black,\n        name=\"shade_socket\",\n    )\n\n    bulb = SphereGeometry(0.020)\n    bulb.translate(0.0, 0.0, 0.062)\n    shade.visual(\n        mesh_from_geometry(bulb, \"shade_bulb\"),\n        origin=Origin(rpy=rpy_s),\n        material=m_bulb,\n        name=\"shade_bulb\",\n    )\n\n    # ---- articulations ---------------------------------------------------\n    model.articulation(\n        \"base_to_lower_arm\",\n        ArticulationType.REVOLUTE,\n        parent=base,\n        child=lower,\n        origin=Origin(xyz=S),\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=6.0, velocity=2.0, lower=-0.55, upper=0.45),\n    )\n    model.articulation(\n        \"lower_arm_to_upper_arm\",\n        ArticulationType.REVOLUTE,\n        parent=lower,\n        child=upper,\n        origin=Origin(xyz=(E[0] - S[0], E[1] - S[1], E[2] - S[2])),\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=6.0, velocity=2.0, lower=-0.35, upper=1.2),\n    )\n    model.articulation(\n        \"upper_arm_to_shade\",\n        ArticulationType.REVOLUTE,\n        parent=upper,\n        child=shade,\n        origin=Origin(xyz=(Head[0] - E[0], Head[1] - E[1], Head[2] - E[2])),\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=3.0, velocity=2.0, lower=-0.8, upper=0.6),\n    )\n\n    return model\n\n\ndef _ecenter(ctx: TestContext, part, elem):\n    bb = ctx.part_element_world_aabb(part, elem=elem)\n    if bb is None:\n        return None\n    lo, hi = bb\n    return tuple((lo[i] + hi[i]) / 2.0 for i in range(3))\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    base = object_model.get_part(\"base\")\n    lower = object_model.get_part(\"lower_arm\")\n    upper = object_model.get_part(\"upper_arm\")\n    shade = object_model.get_part(\"shade\")\n    j0 = object_model.get_articulation(\"base_to_lower_arm\")\n    j1 = object_model.get_articulation(\"lower_arm_to_upper_arm\")\n    j2 = object_model.get_articulation(\"upper_arm_to_shade\")\n\n    ctx.check(\n        \"three revolute joints\",\n        len(object_model.articulations) == 3,\n        f\"got {len(object_model.articulations)}\",\n    )\n    for j in (j0, j1, j2):\n        ctx.check(\n            f\"{j.name} is revolute\",\n            str(j.joint_type).upper().endswith(\"REVOLUTE\"),\n            str(j.joint_type),\n        )\n\n    # intentional hinge-cover overlaps (joint covers enclose the pivots)\n    ctx.allow_overlap(\n        lower,\n        base,\n        elem_a=\"shoulder_cover\",\n        elem_b=\"base_post\",\n        reason=\"shoulder hinge cover encloses the pivot post\",\n    )\n    ctx.allow_overlap(\n        upper,\n        lower,\n        elem_a=\"elbow_cover\",\n        elem_b=\"lower_tube\",\n        reason=\"elbow hinge cover encloses the lower arm end\",\n    )\n    ctx.allow_overlap(\n        upper,\n        shade,\n        elem_a=\"head_cover\",\n        elem_b=\"shade_back\",\n        reason=\"head hinge cover captures the shade back\",\n    )\n\n    # support proofs\n    ctx.expect_contact(\n        lower,\n        base,\n        elem_a=\"shoulder_cover\",\n        elem_b=\"base_post\",\n        name=\"shoulder hinge seated on base post\",\n    )\n    ctx.expect_contact(\n        upper,\n        shade,\n        elem_a=\"head_cover\",\n        elem_b=\"shade_back\",\n        name=\"shade attached to upper arm at head\",\n    )\n\n    # the base sits on its feet\n    foot_lo = ctx.part_element_world_aabb(base, elem=\"foot_0\")\n    ctx.check(\n        \"rubber feet reach the floor\",\n        foot_lo is not None and abs(foot_lo[0][1]) < 0.002,\n        f\"{foot_lo}\",\n    )\n\n    # pose: base hinge swings the whole arm chain\n    rest = ctx.part_world_position(upper)\n    with ctx.pose({j0: 0.35}):\n        moved = ctx.part_world_position(upper)\n    ctx.check(\n        \"base hinge swings the arms\",\n        rest is not None\n        and moved is not None\n        and (abs(moved[1] - rest[1]) + abs(moved[2] - rest[2])) > 0.02,\n        f\"{rest} -> {moved}\",\n    )\n\n    # pose: head hinge tilts the shade (its frame is on the pivot, so use geometry)\n    r2 = _ecenter(ctx, shade, \"shade_cone\")\n    with ctx.pose({j2: 0.4}):\n        m2 = _ecenter(ctx, shade, \"shade_cone\")\n    ctx.check(\n        \"head hinge tilts the shade\",\n        r2 is not None\n        and m2 is not None\n        and (abs(m2[1] - r2[1]) + abs(m2[2] - r2[2])) > 0.01,\n        f\"{r2} -> {m2}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
