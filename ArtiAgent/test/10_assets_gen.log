[round 3] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Material,\n    MeshGeometry,\n    Origin,\n    TestContext,\n    TestReport,\n    mesh_from_geometry,\n    sample_catmull_rom_spline_2d,\n)\n\n# ---------------------------------------------------------------------------\n# Small vector helpers (no numpy in the sandbox)\n# ---------------------------------------------------------------------------\n\n\ndef _sub(a, b):\n    return (a[0] - b[0], a[1] - b[1], a[2] - b[2])\n\n\ndef _add(a, b):\n    return (a[0] + b[0], a[1] + b[1], a[2] + b[2])\n\n\ndef _mul(a, s):\n    return (a[0] * s, a[1] * s, a[2] * s)\n\n\ndef _cross(a, b):\n    return (\n        a[1] * b[2] - a[2] * b[1],\n        a[2] * b[0] - a[0] * b[2],\n        a[0] * b[1] - a[1] * b[0],\n    )\n\n\ndef _dot(a, b):\n    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]\n\n\ndef _norm(a):\n    l = math.sqrt(_dot(a, a))\n    if l < 1e-12:\n        return (0.0, 1.0, 0.0)\n    return (a[0] / l, a[1] / l, a[2] / l)\n\n\n# ---------------------------------------------------------------------------\n# Mesh utilities\n# ---------------------------------------------------------------------------\n\n\ndef _signed_volume(geom):\n    V = geom.vertices\n    vol = 0.0\n    for (i, j, k) in geom.faces:\n        a = V[i]\n        b = V[j]\n        c = V[k]\n        vol += (\n            a[0] * (b[1] * c[2] - b[2] * c[1])\n            - a[1] * (b[0] * c[2] - b[2] * c[0])\n            + a[2] * (b[0] * c[1] - b[1] * c[0])\n        )\n    return vol / 6.0\n\n\ndef _fix_winding(geom):\n    \"\"\"Flip face winding if the closed mesh has inward-facing normals.\"\"\"\n    if _signed_volume(geom) < 0.0:\n        geom.faces = [(i, k, j) for (i, j, k) in geom.faces]\n    return geom\n\n\ndef _to_yup(geom):\n    \"\"\"Bake a z-up lathe into the world y-up frame (det=+1, normals preserved).\"\"\"\n    geom.vertices = [(x, z, -y) for (x, y, z) in geom.vertices]\n    return geom\n\n\ndef _revolve(profile, segments=96):\n    \"\"\"Revolve a closed (r, z) polygon around the z axis -> MeshGeometry (z-up).\"\"\"\n    geom = MeshGeometry()\n    rings = []\n    for (r, z) in profile:\n        if r <= 1e-9:\n            rings.append((\"apex\", geom.add_vertex(0.0, 0.0, z)))\n        else:\n            ring = []\n            for j in range(segments):\n                a = 2.0 * math.pi * j / segments\n                ring.append(geom.add_vertex(r * math.cos(a), r * math.sin(a), z))\n            rings.append((\"ring\", ring))\n\n    n = len(profile)\n    for i in range(n):\n        k0, a = rings[i]\n        k1, b = rings[(i + 1) % n]\n        if k0 == \"apex\" and k1 == \"apex\":\n            continue\n        if k0 == \"ring\" and k1 == \"ring\":\n            for j in range(segments):\n                j2 = (j + 1) % segments\n                geom.add_face(a[j], a[j2], b[j2])\n                geom.add_face(a[j], b[j2], b[j])\n        elif k0 == \"apex\":\n            apex = a\n            for j in range(segments):\n                j2 = (j + 1) % segments\n                geom.add_face(apex, b[j], b[j2])\n        else:  # k1 == \"apex\"\n            apex = b\n            for j in range(segments):\n                j2 = (j + 1) % segments\n                geom.add_face(apex, a[j2], a[j])\n\n    _fix_winding(geom)\n    return geom\n\n\ndef _tube(path, radius, segments=20):\n    \"\"\"Sweep a circular cross section along a 3D path (parallel-transport frame).\"\"\"\n    geom = MeshGeometry()\n    n = len(path)\n\n    tangents = []\n    for i in range(n):\n        if i == 0:\n            t = _sub(path[1], path[0])\n        elif i == n - 1:\n            t = _sub(path[-1], path[-2])\n        else:\n            t = _sub(path[i + 1], path[i - 1])\n        tangents.append(_norm(t))\n\n    ref = (0.0, 0.0, 1.0) if abs(_dot(tangents[0], (0.0, 0.0, 1.0))) < 0.9 else (1.0, 0.0, 0.0)\n    n0 = _norm(_cross(ref, tangents[0]))\n\n    normals = [n0]\n    for i in range(1, n):\n        prev = normals[i - 1]\n        proj = _sub(prev, _mul(tangents[i], _dot(prev, tangents[i])))\n        normals.append(_norm(proj))\n    binormals = [_cross(tangents[i], normals[i]) for i in range(n)]\n\n    ring_idx = []\n    for i in range(n):\n        ring = []\n        for j in range(segments):\n            a = 2.0 * math.pi * j / segments\n            off = _add(_mul(normals[i], radius * math.cos(a)), _mul(binormals[i], radius * math.sin(a)))\n            p = _add(path[i], off)\n            ring.append(geom.add_vertex(p[0], p[1], p[2]))\n        ring_idx.append(ring)\n\n    for i in range(n - 1):\n        a = ring_idx[i]\n        b = ring_idx[i + 1]\n        for j in range(segments):\n            j2 = (j + 1) % segments\n            geom.add_face(a[j], a[j2], b[j2])\n            geom.add_face(a[j], b[j2], b[j])\n\n    c0 = geom.add_vertex(path[0][0], path[0][1], path[0][2])\n    for j in range(segments):\n        j2 = (j + 1) % segments\n        geom.add_face(c0, ring_idx[0][j2], ring_idx[0][j])\n    cn = geom.add_vertex(path[-1][0], path[-1][1], path[-1][2])\n    for j in range(segments):\n        j2 = (j + 1) % segments\n        geom.add_face(cn, ring_idx[-1][j], ring_idx[-1][j2])\n\n    _fix_winding(geom)\n    return geom\n\n\n# ---------------------------------------------------------------------------\n# Mug body profile (r, z) closed polygon, z in metres, z-up\n# ---------------------------------------------------------------------------\n\n# Overall: ~9.55 cm tall, ~8.6 cm outer diameter, ~5 mm wall, foot ring.\n_BODY_PROFILE = [\n    (0.0000, 0.0050),   # underside centre (recessed)\n    (0.0300, 0.0050),   # underside flat\n    (0.0330, 0.0000),   # foot ring inner contact\n    (0.0400, 0.0000),   # foot ring outer contact (rests on ground)\n    (0.0410, 0.0100),   # outer wall base\n    (0.0425, 0.0500),   # outer wall mid\n    (0.0430, 0.0900),   # outer wall top\n    (0.0428, 0.0947),   # rounded lip\n    (0.0415, 0.0955),\n    (0.0400, 0.0955),\n    (0.0388, 0.0948),\n    (0.0386, 0.0935),   # lip inner edge\n    (0.0370, 0.0800),   # inner wall\n    (0.0350, 0.0500),\n    (0.0342, 0.0200),\n    (0.0340, 0.0120),\n    (0.0300, 0.0100),   # inner floor rim\n    (0.0000, 0.0100),   # inner floor centre\n]\n\n_HANDLE_RADIUS = 0.005\n\n\ndef _build_body_geometry():\n    geom = _revolve(_BODY_PROFILE, segments=96)\n    return _to_yup(geom)\n\n\ndef _build_handle_geometry():\n    # C-shaped loop in the world x-y plane (z = 0), attaching on the +x side.\n    control = [\n        (0.0450, 0.0280),\n        (0.0540, 0.0305),\n        (0.0670, 0.0405),\n        (0.0725, 0.0525),\n        (0.0680, 0.0645),\n        (0.0560, 0.0712),\n        (0.0450, 0.0740),\n    ]\n    uv = sample_catmull_rom_spline_2d(control, samples_per_segment=10, closed=False)\n    path = [(u, v, 0.0) for (u, v) in uv]\n    return _tube(path, _HANDLE_RADIUS, segments=20)\n\n\ndef _translate(geom, d):\n    geom.vertices = [(v[0] + d[0], v[1] + d[1], v[2] + d[2]) for v in geom.vertices]\n    return geom\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"ceramic_mug\")\n\n    body_geom = _build_body_geometry()\n    handle_geom = _build_handle_geometry()\n\n    # Centre the whole assembly on the world origin.\n    all_v = body_geom.vertices + handle_geom.vertices\n    xs = [v[0] for v in all_v]\n    ys = [v[1] for v in all_v]\n    zs = [v[2] for v in all_v]\n    center = (\n        0.5 * (min(xs) + max(xs)),\n        0.5 * (min(ys) + max(ys)),\n        0.5 * (min(zs) + max(zs)),\n    )\n    _translate(body_geom, (-center[0], -center[1], -center[2]))\n    _translate(handle_geom, (-center[0], -center[1], -center[2]))\n\n    glaze = Material(name=\"glaze\", rgba=(0.34, 0.50, 0.49, 1.0))\n    glaze_handle = Material(name=\"glaze_handle\", rgba=(0.32, 0.47, 0.46, 1.0))\n\n    body = model.part(\"mug_body\")\n    body.visual(\n        mesh_from_geometry(body_geom, \"mug_body_shell\"),\n        origin=Origin(),\n        material=glaze,\n        name=\"mug_body_shell\",\n    )\n\n    handle = model.part(\"handle\")\n    handle.visual(\n        mesh_from_geometry(handle_geom, \"mug_handle\"),\n        origin=Origin(),\n        material=glaze_handle,\n        name=\"mug_handle\",\n    )\n\n    model.articulation(\n        \"body_to_handle\",\n        ArticulationType.FIXED,\n        parent=body,\n        child=handle,\n        origin=Origin(),\n    )\n\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    body = object_model.get_part(\"mug_body\")\n    handle = object_model.get_part(\"handle\")\n\n    # Handle is a real, attached continuation of the body wall.\n    ctx.expect_contact(handle, body, contact_tol=0.004, name=\"handle attached to body\")\n\n    # The handle loop projects outward well beyond the body's outer radius on +x.\n    handle_aabb = ctx.part_world_aabb(handle)\n    body_aabb = ctx.part_world_aabb(body)\n    if handle_aabb is not None and body_aabb is not None:\n        ctx.check(\n            \"handle projects outward\",\n            handle_aabb[1][0] > body_aabb[1][0] + 0.02,\n            details=f\"handle_max_x={handle_aabb[1][0]:.4f} body_max_x={body_aabb[1][0]:.4f}\",\n        )\n        # Mug proportions: taller than it is wide, and a real (hollow) cup section.\n        body_h = body_aabb[1][1] - body_aabb[0][1]\n        body_w = body_aabb[1][0] - body_aabb[0][0]\n        ctx.check(\n            \"body proportions\",\n            0.088 < body_h < 0.100 and 0.080 < body_w < 0.092,\n            details=f\"h={body_h:.4f} w={body_w:.4f}\",\n        )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
