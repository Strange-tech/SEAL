[round 12] bash({"command": "cat > /tmp/render_dial.py << 'EOF'\nimport sys\nverts=[]; faces=[]\npath=\".compile_tmp/assets/meshes/dial_face.obj\"\nfor line in open(path):\n    p=line.split()\n    if not p: continue\n    if p[0]=='v':\n        verts.append((float(p[1]),float(p[2]),float(p[3])))\n    elif p[0]=='f':\n        idx=[int(t.split('/')[0])-1 for t in p[1:]]\n        for k in range(1,len(idx)-1):\n            faces.append((idx[0],idx[k],idx[k+1]))\n# front view: project (x,y), depth z\nW=88; H=44\nxmin=-0.14; xmax=0.14; ymin=-0.14; ymax=0.14\ngrid=[[None]*W for _ in range(H)]\ndef bary(px,py,a,b,c):\n    d=(b[1]-c[1])*(a[0]-c[0])+(c[0]-b[0])*(a[1]-c[1])\n    if abs(d)<1e-12: return None\n    u=((b[1]-c[1])*(px-c[0])+(c[0]-b[0])*(py-c[1]))/d\n    v=((c[1]-a[1])*(px-c[0])+(a[0]-c[0])*(py-c[1]))/d\n    w=1-u-v\n    if u<-1e-6 or v<-1e-6 or w<-1e-6: return None\n    return (u,v,w)\nfor a,b,c in faces:\n    A=verts[a];B=verts[b];C=verts[c]\n    xs=[A[0],B[0],C[0]];ys=[A[1],B[1],C[1]]\n    # only front-facing (normal z > 0)\n    nz=(B[0]-A[0])*(C[1]-A[1])-(B[1]-A[1])*(C[0]-A[0])\n    if nz<=0: continue\n    for r in range(H):\n        py=ymax-(r+0.5)*(ymax-ymin)/H\n        if py<min(ys) or py>max(ys): continue\n        for col in range(W):\n            px=xmin+(col+0.5)*(xmax-xmin)/W\n            if px<min(xs) or px>max(xs): continue\n            w=bary(px,py,A,B,C)\n            if w is None: continue\n            z=w[0]*A[2]+w[1]*B[2]+w[2]*C[2]\n            if grid[r][col] is None or z>grid[r][col]:\n                grid[r][col]=z\n# show all occupied (dial face ~0.010, engraving lower). map z to chars\nzs=[z for row in grid for z in row if z is not None]\nzmax=max(zs); zmin=min(zs)\nramp=\" .:-=+*#%@\"\nfor r in range(H):\n    line=\"\"\n    for col in range(W):\n        z=grid[r][col]\n        if z is None: line+=\" \"\n        else:\n            t=(z-zmin)/(zmax-zmin+1e-9)\n            # engraved (lower z) -> darker; invert so face light, engraving dark\n            ci=int((1-t)*(len(ramp)-1))\n            line+=ramp[ci]\n    print(line)\nEOF\npython3 /tmp/render_dial.py"})
