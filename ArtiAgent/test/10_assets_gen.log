[round 14] write_file({"path": "render_check.py", "content": "import glob, os, sys\n\ndef load(path):\n    vs, fs = [], []\n    for line in open(path):\n        t = line.split()\n        if not t:\n            continue\n        if t[0] == \"v\":\n            vs.append((float(t[1]), float(t[2]), float(t[3])))\n        elif t[0] == \"f\":\n            fs.append([int(x.split(\"/\")[0]) - 1 for x in t[1:]])\n    return vs, fs\n\ndef render(tris, uaxis, vaxis, W=90, H=42, title=\"\"):\n    # figure extents\n    us = [p[uaxis] for tri in tris for p in tri]\n    vs_ = [p[vaxis] for tri in tris for p in tri]\n    u0, u1 = min(us), max(us)\n    v0, v1 = min(vs_), max(vs_)\n    du = (u1 - u0) or 1e-6\n    dv = (v1 - v0) or 1e-6\n    s = min((W - 2) / du, (H - 1) / dv)\n    grid = [[\" \"] * W for _ in range(H)]\n    # painter: sort by depth along the axis we look down (the third axis)\n    depth_axis = 3 - uaxis - vaxis\n    tris = sorted(tris, key=lambda t: sum(p[depth_axis] for p in t) / 3.0)\n    for tri in tris:\n        pts = []\n        for p in tri:\n            x = (p[uaxis] - u0) * s + 1.0\n            y = (p[vaxis] - v0) * s\n            pts.append((x, y))\n        # normal shading\n        ax = [tri[1][i] - tri[0][i] for i in range(3)]\n        bx = [tri[2][i] - tri[0][i] for i in range(3)]\n        nx = ax[1] * bx[2] - ax[2] * bx[1]\n        ny = ax[2] * bx[0] - ax[0] * bx[2]\n        nz = ax[0] * bx[1] - ax[1] * bx[0]\n        ln = (nx * nx + ny * ny + nz * nz) ** 0.5 or 1.0\n        shade = abs(nz / ln)\n        ch = \"#\" if shade > 0.75 else (\"+\" if shade > 0.4 else \".\")\n        xs = [p[0] for p in pts]\n        ys = [p[1] for p in pts]\n        x0, x1 = int(min(xs)), int(max(xs)) + 1\n        y0, y1 = int(min(ys)), int(max(ys)) + 1\n        for yy in range(max(0, y0), min(H, y1 + 1)):\n            for xx in range(max(0, x0), min(W, x1 + 1)):\n                # barycentric inside test\n                px, py = xx + 0.5, yy + 0.5\n                (x1p, y1p), (x2p, y2p), (x3p, y3p) = pts\n                d = (y2p - y3p) * (x1p - x3p) + (x3p - x2p) * (y1p - y3p)\n                if abs(d) < 1e-12:\n                    continue\n                a = ((y2p - y3p) * (px - x3p) + (x3p - x2p) * (py - y3p)) / d\n                b = ((y3p - y1p) * (px - x3p) + (x1p - x3p) * (py - y3p)) / d\n                c = 1 - a - b\n                if a >= -0.001 and b >= -0.001 and c >= -0.001:\n                    grid[H - 1 - yy][xx] = ch\n    print(\"=== %s ===\" % title)\n    for row in grid:\n        print(\"\".join(row))\n    print()\n\ntris = []\nfor path in sorted(glob.glob(\".compile_tmp/assets/meshes/*.obj\")):\n    vs, fs = load(path)\n    for f in fs:\n        for k in range(1, len(f) - 1):\n            tris.append((vs[f[0]], vs[f[k]], vs[f[k + 1]]))\n\nprint(\"triangles:\", len(tris))\nrender(tris, 0, 1, title=\"FRONT view (x right, y up)\")\nrender(tris, 2, 1, title=\"SIDE view (z right, y up)\")\nrender(tris, 0, 2, title=\"TOP view (x right, z up)\")\n"})
