[round 4] write_file({"path": "model.py", "content": "\"\"\"A 500 mL glass bottle with a knurled screw cap.\n\nThe bottle is authored as a true hollow lathe shell (real wall thickness,\nrounded shoulder, thickened lip, punted base) with moulded lettering, and the\ncap is a separate knurled aluminium cup that spins on the neck thread.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    mesh_from_geometry,\n)\n\n# ---------------------------------------------------------------------------\n# Dimensions (metres, +Y up, +Z front)\n# ---------------------------------------------------------------------------\nBODY_R = 0.0325\nBODY_TOP = 0.1500\nNECK_R = 0.0130\nNECK_BORE_R = 0.0106\nSHOULDER_TOP = 0.1780\nLIP_R = 0.0146\nGLASS_TOP = 0.2185\n\nCAP_R_OUT = 0.0163\nCAP_R_IN = 0.0152\nCAP_BOT = 0.2020\nCAP_CEIL = GLASS_TOP\nCAP_TOP = 0.2200\nJOINT_Y = 0.2150\n\nCAP_FLUTES = 28\nCAP_SEGMENTS = 112\n\n\n# ---------------------------------------------------------------------------\n# Low level mesh helpers\n# ---------------------------------------------------------------------------\ndef _tri(geom: MeshGeometry, a: int, b: int, c: int) -> None:\n    geom.add_face(a, b, c)\n\n\ndef _quad(geom: MeshGeometry, a: int, b: int, c: int, d: int) -> None:\n    _tri(geom, a, b, c)\n    _tri(geom, a, c, d)\n\n\ndef _revolve(profile, segments=96, flute=None) -> MeshGeometry:\n    \"\"\"Revolve a closed (radius, y) profile about the world +Y axis.\n\n    The profile must be traversed counter-clockwise in the (r, y) plane\n    (material of the solid on the left) so the generated normals face out.\n    Points with r == 0 collapse onto the axis (single shared vertex).\n    \"\"\"\n    geom = MeshGeometry()\n    rings: list[list[int]] = []\n    for r, y in profile:\n        if abs(r) < 1e-9:\n            rings.append([geom.add_vertex(0.0, y, 0.0)])\n            continue\n        ring = []\n        for j in range(segments):\n            th = 2.0 * math.pi * j / segments\n            rr = r\n            if flute is not None:\n                r_min, amp, count = flute\n                if r >= r_min:\n                    rr = r + amp * math.cos(count * th)\n            ring.append(geom.add_vertex(rr * math.sin(th), y, rr * math.cos(th)))\n        rings.append(ring)\n\n    n = len(rings)\n    for i in range(n):\n        a = rings[i]\n        b = rings[(i + 1) % n]\n        apex_a = len(a) == 1\n        apex_b = len(b) == 1\n        if apex_a and apex_b:\n            continue\n        for j in range(segments):\n            j2 = (j + 1) % segments\n            if apex_a:\n                _tri(geom, a[0], b[j2], b[j])\n            elif apex_b:\n                _tri(geom, a[j], a[j2], b[0])\n            else:\n                _quad(geom, a[j], a[j2], b[j2], b[j])\n    return geom\n\n\ndef _stroke_prism(geom, p0, p1, half_w, map_out, map_in) -> None:\n    \"\"\"Extrude one rectangular stroke of a moulded-text glyph.\n\n    p0/p1 are (u, v) end points in the text plane; the stroke is widened by\n    half_w perpendicular to its direction and extruded between the two surface\n    layers supplied by map_out (proud layer) and map_in (embedded layer).\n    \"\"\"\n    du = p1[0] - p0[0]\n    dv = p1[1] - p0[1]\n    length = math.hypot(du, dv)\n    if length < 1e-9:\n        return\n    ux, uy = du / length, dv / length\n    nx, ny = -uy * half_w, ux * half_w\n    ex, ey = ux * half_w, uy * half_w\n\n    a0 = (p0[0] - ex, p0[1] - ey)\n    a1 = (p1[0] + ex, p1[1] + ey)\n    corners = [\n        (a0[0] - nx, a0[1] - ny),\n        (a1[0] - nx, a1[1] - ny),\n        (a1[0] + nx, a1[1] + ny),\n        (a0[0] + nx, a0[1] + ny),\n    ]\n    out_ids = [geom.add_vertex(*map_out(u, v)) for (u, v) in corners]\n    in_ids = [geom.add_vertex(*map_in(u, v)) for (u, v) in corners]\n    _quad(geom, out_ids[0], out_ids[1], out_ids[2], out_ids[3])\n    _quad(geom, in_ids[0], in_ids[3], in_ids[2], in_ids[1])\n    for k in range(4):\n        k2 = (k + 1) % 4\n        _quad(geom, out_ids[k2], out_ids[k], in_ids[k], in_ids[k2])\n\n\nGLYPHS = {\n    \"5\": [\n        [(0.86, 1.0), (0.16, 1.0), (0.16, 0.58), (0.54, 0.58)],\n        [(0.54, 0.58), (0.84, 0.47), (0.93, 0.26), (0.80, 0.07), (0.50, 0.0), (0.13, 0.06)],\n    ],\n    \"0\": [\n        [(0.16, 0.18), (0.16, 0.82), (0.32, 1.0), (0.68, 1.0), (0.84, 0.82),\n         (0.84, 0.18), (0.68, 0.0), (0.32, 0.0), (0.16, 0.18)],\n    ],\n    \"m\": [\n        [(0.10, 0.0), (0.10, 0.62)],\n        [(0.10, 0.54), (0.28, 0.64), (0.44, 0.52), (0.44, 0.0)],\n        [(0.44, 0.52), (0.60, 0.64), (0.78, 0.50), (0.78, 0.0)],\n    ],\n    \"L\": [[(0.16, 1.0), (0.16, 0.0), (0.86, 0.0)]],\n    \"G\": [\n        [(0.86, 0.84), (0.68, 1.0), (0.34, 1.0), (0.14, 0.80), (0.14, 0.20),\n         (0.34, 0.0), (0.68, 0.0), (0.87, 0.18), (0.87, 0.44), (0.56, 0.44)],\n    ],\n    \"A\": [[(0.06, 0.0), (0.50, 1.0), (0.94, 0.0)], [(0.24, 0.34), (0.76, 0.34)]],\n    \"S\": [\n        [(0.85, 0.84), (0.66, 1.0), (0.32, 1.0), (0.14, 0.83), (0.16, 0.62),\n         (0.36, 0.52), (0.66, 0.50), (0.86, 0.36), (0.85, 0.13), (0.65, 0.0),\n         (0.32, 0.0), (0.13, 0.13)],\n    ],\n    \"^\": [[(0.04, 0.0), (0.50, 1.0), (0.96, 0.0), (0.04, 0.0)]],\n    \" \": [],\n}\n\n\ndef _text_strokes(text, u_start, char_w, char_h, spacing):\n    \"\"\"Yield (u, v) stroke pairs for a string laid out from u_start.\"\"\"\n    advance = char_w + spacing\n    for i, ch in enumerate(text):\n        strokes = GLYPHS.get(ch)\n        if strokes is None:\n            continue\n        ux = u_start + i * advance\n        for poly in strokes:\n            for k in range(len(poly) - 1):\n                p0 = (ux + poly[k][0] * char_w, poly[k][1] * char_h)\n                p1 = (ux + poly[k + 1][0] * char_w, poly[k + 1][1] * char_h)\n                yield p0, p1\n\n\ndef _text_width(text, char_w, spacing):\n    n = len(text)\n    return n * char_w + (n - 1) * spacing\n\n\ndef _front_text(text, y_base, char_h, char_w, spacing, stroke_w, r_in, r_out):\n    \"\"\"Moulded relief lettering wrapped on the front of the bottle body.\"\"\"\n    geom = MeshGeometry()\n    u_start = -_text_width(text, char_w, spacing) / 2.0\n\n    def make_mapper(radius):\n        def mapper(u, v):\n            th = u / BODY_R\n            return (radius * math.sin(th), y_base + v, radius * math.cos(th))\n\n        return mapper\n\n    m_out = make_mapper(r_out)\n    m_in = make_mapper(r_in)\n    for p0, p1 in _text_strokes(text, u_start, char_w, char_h, spacing):\n        _stroke_prism(geom, p0, p1, stroke_w / 2.0, m_out, m_in)\n    return geom\n\n\ndef _base_text(text, r_mid, char_h, char_w, spacing, stroke_w, y_out, y_in):\n    \"\"\"Moulded lettering on the underside of the punted base.\"\"\"\n    geom = MeshGeometry()\n    u_start = -_text_width(text, char_w, spacing) / 2.0\n\n    def make_mapper(y_layer):\n        def mapper(u, v):\n            r = r_mid + v\n            th = math.pi + u / r_mid\n            return (r * math.sin(th), y_layer, r * math.cos(th))\n\n        return mapper\n\n    m_out = make_mapper(y_out)\n    m_in = make_mapper(y_in)\n    for p0, p1 in _text_strokes(text, u_start, char_w, char_h, spacing):\n        _stroke_prism(geom, p0, p1, stroke_w / 2.0, m_out, m_in)\n    return geom\n\n\n# ---------------------------------------------------------------------------\n# Profiles\n# ---------------------------------------------------------------------------\ndef _bottle_profile():\n    pts = []\n    # --- outer bottom (punt) ---\n    pts.append((0.0, 0.0060))\n    pts.append((0.0060, 0.0030))\n    pts.append((0.0120, 0.0000))\n    pts.append((0.0290, 0.0000))\n    pts.append((0.0318, 0.0012))\n    pts.append((BODY_R, 0.0045))\n    pts.append((BODY_R, BODY_TOP))\n    # --- ellipsoidal shoulder ---\n    for k in range(1, 9):\n        t = k / 8.0\n        y = BODY_TOP + (SHOULDER_TOP - BODY_TOP) * t\n        rr = NECK_R + (BODY_R - NECK_R) * math.sqrt(max(0.0, 1.0 - t * t))\n        pts.append((rr, y))\n    # --- neck ---\n    pts.append((NECK_R, 0.1900))\n    pts.append((NECK_R, 0.2110))\n    # --- thickened lip ring ---\n    pts.append((0.0138, 0.2120))\n    pts.append((LIP_R, 0.2135))\n    pts.append((LIP_R, 0.2170))\n    pts.append((0.0143, 0.2181))\n    pts.append((0.0130, GLASS_TOP))\n    # --- mouth face ---\n    pts.append((0.0108, GLASS_TOP))\n    # --- bore down the neck ---\n    pts.append((NECK_BORE_R, 0.2140))\n    pts.append((NECK_BORE_R, 0.1820))\n    # --- inner shoulder ---\n    for k in range(0, 11):\n        t = 1.0 - 0.98 * k / 10.0\n        y = BODY_TOP + (0.0300) * t\n        rr = NECK_BORE_R + (0.0300 - NECK_BORE_R) * math.sqrt(max(0.0, 1.0 - t * t))\n        pts.append((rr, y))\n    # --- inner wall and floor ---\n    pts.append((0.0300, 0.1450))\n    pts.append((0.0300, 0.0220))\n    pts.append((0.0286, 0.0140))\n    pts.append((0.0250, 0.0105))\n    pts.append((0.0170, 0.0092))\n    pts.append((0.0, 0.0092))\n    return pts\n\n\ndef _cap_profile():\n    return [\n        (CAP_R_IN, CAP_BOT),\n        (CAP_R_OUT, CAP_BOT),\n        (CAP_R_OUT, 0.2188),\n        (0.0151, 0.2196),\n        (0.0120, CAP_TOP),\n        (0.0, CAP_TOP),\n        (0.0, CAP_CEIL),\n        (CAP_R_IN, CAP_CEIL),\n    ]\n\n\n# ---------------------------------------------------------------------------\n# Model\n# ---------------------------------------------------------------------------\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"glass_bottle\")\n\n    glass = model.material(\"clear_soda_lime_glass\", rgba=(0.70, 0.86, 0.79, 0.55))\n    frosted = model.material(\"moulded_frosted_lettering\", rgba=(0.93, 0.97, 0.94, 0.90))\n    alu = model.material(\"brushed_aluminium\", rgba=(0.77, 0.78, 0.80, 1.0))\n\n    bottle = model.part(\"bottle\")\n    bottle.visual(\n        mesh_from_geometry(_revolve(_bottle_profile(), segments=96), \"bottle_body\"),\n        material=glass,\n        name=\"bottle_body\",\n    )\n    bottle.visual(\n        mesh_from_geometry(\n            _front_text(\n                \"500 mL\",\n                y_base=0.0280,\n                char_h=0.0072,\n                char_w=0.0042,\n                spacing=0.0012,\n                stroke_w=0.0011,\n                r_in=BODY_R - 0.0009,\n                r_out=BODY_R + 0.0005,\n            ),\n            \"body_lettering\",\n        ),\n        material=frosted,\n        name=\"body_lettering\",\n    )\n    bottle.visual(\n        mesh_from_geometry(\n            _base_text(\n                \"GLASS\",\n                r_mid=0.0205,\n                char_h=0.0030,\n                char_w=0.0028,\n                spacing=0.0010,\n                stroke_w=0.0009,\n                y_out=-0.0004,\n                y_in=0.0009,\n            ),\n            \"base_lettering\",\n        ),\n        material=frosted,\n        name=\"base_lettering\",\n    )\n\n    cap = model.part(\"screw_cap\")\n    cap_geom = _revolve(\n        _cap_profile(),\n        segments=CAP_SEGMENTS,\n        flute=(0.0159, 0.00030, CAP_FLUTES),\n    )\n    cap_geom.translate(0.0, -JOINT_Y, 0.0)\n    cap.visual(\n        mesh_from_geometry(cap_geom, \"cap_shell\"),\n        material=alu,\n        name=\"cap_shell\",\n    )\n\n    model.articulation(\n        \"bottle_to_cap\",\n        ArticulationType.REVOLUTE,\n        parent=bottle,\n        child=cap,\n        origin=Origin(xyz=(0.0, JOINT_Y, 0.0)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(\n            effort=2.0, velocity=4.0, lower=-0.20, upper=12.566\n        ),\n    )\n\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    bottle = object_model.get_part(\"bottle\")\n    cap = object_model.get_part(\"screw_cap\")\n    joint = object_model.get_articulation(\"bottle_to_cap\")\n\n    # The cap is attached to (not floating off) the bottle mouth.\n    ctx.expect_contact(cap, bottle, contact_tol=1e-4, name=\"cap seats on the bottle mouth\")\n    ctx.expect_overlap(\n        cap, bottle, axes=\"xz\", min_overlap=0.028, name=\"cap is concentric with the neck\"\n    )\n\n    body_bb = ctx.part_element_world_aabb(bottle, elem=\"bottle_body\")\n    cap_bb = ctx.part_element_world_aabb(cap, elem=\"cap_shell\")\n    ctx.check(\n        \"cap closes the bottle at the nominal overall height\",\n        body_bb is not None\n        and cap_bb is not None\n        and abs(cap_bb[1][1] - 0.2200) < 0.002\n        and cap_bb[1][1] > body_bb[1][1] + 0.0004,\n        details=f\"cap_top={None if cap_bb is None else cap_bb[1][1]}, \"\n        f\"glass_top={None if body_bb is None else body_bb[1][1]}\",\n    )\n    ctx.check(\n        \"bottle body is the tallest part of the assembly\",\n        body_bb is not None and (body_bb[1][1] - body_bb[0][1]) > 0.20,\n        details=f\"body_height={None if body_bb is None else body_bb[1][1] - body_bb[0][1]}\",\n    )\n    ctx.check(\n        \"cap diameter is larger than the bottle mouth lip\",\n        cap_bb is not None and body_bb is not None\n        and (cap_bb[1][0] - cap_bb[0][0]) < (body_bb[1][0] - body_bb[0][0])\n        and (cap_bb[1][0] - cap_bb[0][0]) > 2.0 * LIP_R,\n        details=f\"cap_dia={None if cap_bb is None else cap_bb[1][0] - cap_bb[0][0]}\",\n    )\n\n    # Screwing the cap keeps it centred on the neck axis and seated on the mouth.\n    limits = joint.motion_limits\n    upper = limits.upper if limits is not None and limits.upper is not None else 6.28\n    with ctx.pose({joint: upper * 0.5}):\n        ctx.expect_overlap(\n            cap,\n            bottle,\n            axes=\"xz\",\n            min_overlap=0.028,\n            name=\"cap stays concentric while unscrewing\",\n        )\n        ctx.expect_contact(\n            cap, bottle, contact_tol=1e-4, name=\"cap stays seated while unscrewing\"\n        )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
