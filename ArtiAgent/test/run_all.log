0.0012 + 0.0042 * tp + _wrinkle(x, z, _WR_BASE, 0.0)\n    if th < 0.0016:\n        th = 0.0016\n    # Rounded roll of the fold, peaking just inside the back edge.\n    ridge = 0.0072 * math.exp(-(((z + 0.066) / 0.030) ** 2)) * tp\n    return _base_bottom(x, z, s, t) + th + ridge\n\n\ndef _flap_bottom(x, z, s, t):\n    # The turned-over layer conforms to the lower fold: pressed together at the\n    # crease and at the free edge, puffed up in the middle of the fold.\n    d = (z + AZ_FLAP) / (2.0 * AZ_FLAP)\n    d = min(1.0, max(0.0, d))\n    gap = -0.0013 + 0.0026 * math.sin(math.pi * d)\n    return _base_top(x, z, s, t) + gap\n\n\ndef _flap_top(x, z, s, t):\n    tp = _taper(max(abs(s), abs(t)))\n    th = 0.0022 + 0.0030 * tp + _wrinkle(x, z, _WR_FLAP, 0.9)\n    if th < 0.0014:\n        th = 0.0014\n    # A couple of soft lumps so the fold reads as loose cloth.\n    lumps = (\n        0.0040 * math.exp(-(((x - 0.018) ** 2 + (z + 0.012) ** 2) / 0.0022))\n        + 0.0028 * math.exp(-(((x + 0.045) ** 2 + (z - 0.030) ** 2) / 0.0016))\n        + 0.0018 * math.exp(-(((x - 0.060) ** 2 + (z - 0.045) ** 2) / 0.0012))\n    )\n    return _flap_bottom(x, z, s, t) + th + lumps\n\n\ndef _sheet_geometry(ax, az, bottom_fn, top_fn, *, ns=NS, nt=NT) -> MeshGeometry:\n    \"\"\"Closed thin shell: top grid + bottom grid + selvedge rim.\"\"\"\n    geom = MeshGeometry()\n    pts = []\n    for i in range(ns):\n        s = -1.0 + 2.0 * i / (ns - 1)\n        row = []\n        for j in range(nt):\n            t = -1.0 + 2.0 * j / (nt - 1)\n            x = ax * s * math.sqrt(max(0.0, 1.0 - 0.5 * t * t))\n            z = az * t * math.sqrt(max(0.0, 1.0 - 0.5 * s * s))\n            row.append((x, z, s, t))\n        pts.append(row)\n\n    idx_top = [[0] * nt for _ in range(ns)]\n    idx_bot = [[0] * nt for _ in range(ns)]\n    for i in range(ns):\n        for j in range(nt):\n            x, z, s, t = pts[i][j]\n            idx_top[i][j] = geom.add_vertex(x, top_fn(x, z, s, t), z)\n    for i in range(ns):\n        for j in range(nt):\n            x, z, s, t = pts[i][j]\n            idx_bot[i][j] = geom.add_vertex(x, bottom_fn(x, z, s, t), z)\n\n    for i in range(ns - 1):\n        for j in range(nt - 1):\n            a, b = idx_top[i][j], idx_top[i + 1][j]\n            c, d = idx_top[i + 1][j + 1], idx_top[i][j + 1]\n            geom.add_face(a, d, c)\n            geom.add_face(a, c, b)\n            a, b = idx_bot[i][j], idx_bot[i + 1][j]\n            c, d = idx_bot[i + 1][j + 1], idx_bot[i][j + 1]\n            geom.add_face(a, b, c)\n            geom.add_face(a, c, d)\n\n    loop = []\n    for j in range(nt - 1):\n        loop.append((0, j))\n    for i in range(ns - 1):\n        loop.append((i, nt - 1))\n    for j in range(nt - 1, 0, -1):\n        loop.append((ns - 1, j))\n    for i in range(ns - 1, 0, -1):\n        loop.append((0 + i, 0))\n    n = len(loop)\n    for k in range(n):\n        i0, j0 = loop[k]\n        i1, j1 = loop[(k + 1) % n]\n        ta, tb = idx_top[i0][j0], idx_top[i1][j1]\n        ba, bb = idx_bot[i0][j0], idx_bot[i1][j1]\n        geom.add_face(ta, tb, bb)\n        geom.add_face(ta, bb, ba)\n    return geom\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"folded_cloth\")\n\n    linen = model.material(\"linen_cream\", rgba=(0.90, 0.88, 0.82, 1.0))\n    linen_under = model.material(\"linen_shadow\", rgba=(0.80, 0.78, 0.71, 1.0))\n\n    # ---- lower fold (root) -------------------------------------------------\n    lower = model.part(\"cloth_base\")\n    lower_mesh = mesh_from_geometry(\n        _sheet_geometry(AX_BASE, AZ_BASE, _base_bottom, _base_top),\n        \"lower_fold\",\n    )\n    lower.visual(lower_mesh, material=linen_under, name=\"lower_fold\")\n\n    # ---- upper fold (the turned-over flap) --------------------------------\n    flap = model.part(\"cloth_flap\")\n    pivot_y = _flap_bottom(0.0, -AZ_FLAP, 0.0, -1.0)\n    flap_mesh = _sheet_geometry(AX_FLAP, AZ_FLAP, _flap_bottom, _flap_top)\n    # Geometry is authored in world coordinates; express it in the hinge frame.\n    flap_mesh.translate(0.0, -pivot_y, AZ_FLAP)\n    flap.visual(mesh_from_geometry(flap_mesh, \"upper_fold\"), material=linen, name=\"upper_fold\")\n\n    model.articulation(\n        \"base_to_flap\",\n        ArticulationType.REVOLUTE,\n        parent=lower,\n        child=flap,\n        origin=Origin(xyz=(0.0, pivot_y, -AZ_FLAP)),\n        # Folded cloth opens by lifting the free (+z) edge: -X axis does that.\n        axis=(-1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=2.0, velocity=1.5, lower=0.0, upper=2.5),\n    )\n\n    model = fit_to_box(model, (0.78, 0.01, 0.62), (0.24, 0.03, 0.18))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    base = object_model.get_part(\"cloth_base\")\n    flap = object_model.get_part(\"cloth_flap\")\n    hinge = object_model.get_articulation(\"base_to_flap\")\n\n    # The two cloth layers are pressed together where the cloth folds back on\n    # itself; the interface is hidden inside the fold.\n    ctx.allow_overlap(\n        base,\n        flap,\n        elem_a=\"lower_fold\",\n        elem_b=\"upper_fold\",\n        reason=(\n            \"Upper folded layer is pressed onto the lower layer at the crease and at \"\n            \"the free edge; the few-millimetre embed is the hidden cloth interface.\"\n        ),\n    )\n\n    # Rest (folded) pose: the flap is seated on the lower fold.\n    ctx.expect_contact(flap, base, contact_tol=0.002, name=\"flap seats on the lower fold\")\n    ctx.expect_within(\n        flap, base, axes=\"xz\", margin=0.004, name=\"flap stays inside the lower fold footprint\"\n    )\n    ctx.expect_overlap(\n        flap, base, axes=\"xz\", min_overlap=0.14, name=\"flap covers the lower fold\"\n    )\n\n    closed = ctx.part_element_world_aabb(flap, elem=\"upper_fold\")\n    limits = hinge.motion_limits\n    upper = limits.upper if limits is not None and limits.upper is not None else 2.5\n    with ctx.pose({hinge: upper}):\n        opened = ctx.part_element_world_aabb(flap, elem=\"upper_fold\")\n        ctx.expect_contact(flap, base, contact_tol=0.002, name=\"crease stays attached when unfolded\")\n    ctx.check(\n        \"flap lifts when unfolded\",\n        closed is not None\n        and opened is not None\n        and opened[1][1] > closed[1][1] + 0.04,\n        details=f\"closed_max_y={None if closed is None else closed[1][1]}, \"\n        f\"opened_max_y={None if opened is None else opened[1][1]}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
