----------------------------\nBEAN_FLOOR_Y = 0.0060  # top of the solid glass base\nPILE_RADIUS = 0.0345\nBEAN_HALF_LEN = 0.0062\nBEAN_HALF_THICK = 0.0030\nBEAN_HALF_WIDE = 0.0044\n\n\ndef _pile_top(r: float) -> float:\n    # A gently mounded heap, higher in the middle.\n    ratio = min(1.0, (r / 0.040) ** 2)\n    return 0.068 + 0.028 * math.sqrt(max(0.0, 1.0 - ratio))\n\n\ndef _build_bean_piles() -> tuple[MeshGeometry, MeshGeometry]:\n    rng = random.Random(20240607)\n    base_bean = SphereGeometry(1.0, width_segments=8, height_segments=6)\n    dark = MeshGeometry()\n    light = MeshGeometry()\n\n    layer_y = BEAN_FLOOR_Y + 0.0028\n    spacing = 0.0118\n    layer_index = 0\n    while layer_y < 0.097:\n        stagger = 0.5 * spacing if layer_index % 2 else 0.0\n        x = -0.040 + stagger\n        while x <= 0.040:\n            z = -0.040 + stagger\n            while z <= 0.040:\n                px = x + rng.uniform(-0.0016, 0.0016)\n                pz = z + rng.uniform(-0.0016, 0.0016)\n                r = math.hypot(px, pz)\n                if r <= PILE_RADIUS and layer_y <= _pile_top(r) and rng.random() > 0.08:\n                    bean = base_bean.copy()\n                    jitter = rng.uniform(0.9, 1.1)\n                    bean.scale(\n                        BEAN_HALF_LEN * jitter,\n                        BEAN_HALF_THICK * rng.uniform(0.88, 1.12),\n                        BEAN_HALF_WIDE * jitter,\n                    )\n                    bean.rotate_y(rng.uniform(0.0, math.tau))\n                    bean.rotate_x(rng.uniform(-0.30, 0.30))\n                    bean.rotate_z(rng.uniform(-0.30, 0.30))\n                    bean.translate(\n                        px,\n                        layer_y + rng.uniform(-0.0010, 0.0010),\n                        pz,\n                    )\n                    if rng.random() < 0.30:\n                        light.merge(bean)\n                    else:\n                        dark.merge(bean)\n                z += spacing\n            x += spacing\n        layer_y += 0.0058\n        layer_index += 1\n\n    return dark, light\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"coffee_bean_jar\")\n\n    glass = model.material(\"jar_glass\", rgba=(0.83, 0.89, 0.90, 0.30))\n    bean_dark = model.material(\"bean_dark_roast\", rgba=(0.24, 0.13, 0.07, 1.0))\n    bean_light = model.material(\"bean_medium_roast\", rgba=(0.43, 0.25, 0.13, 1.0))\n    wood = model.material(\"walnut_lid\", rgba=(0.40, 0.26, 0.15, 1.0))\n    cork = model.material(\"cork_seal\", rgba=(0.62, 0.47, 0.30, 1.0))\n\n    # --- root: glass jar ---------------------------------------------------\n    jar = model.part(\"jar\")\n    jar_mesh = mesh_from_cadquery(_build_jar_shape(), \"jar_glass_shell\")\n    jar.visual(jar_mesh, material=glass, name=\"glass_shell\")\n\n    # --- coffee beans ------------------------------------------------------\n    beans = model.part(\"coffee_beans\")\n    dark_geom, light_geom = _build_bean_piles()\n    beans.visual(\n        mesh_from_geometry(dark_geom, \"coffee_bean_pile_dark\"),\n        material=bean_dark,\n        name=\"bean_pile_dark\",\n    )\n    beans.visual(\n        mesh_from_geometry(light_geom, \"coffee_bean_pile_light\"),\n        material=bean_light,\n        name=\"bean_pile_light\",\n    )\n\n    model.articulation(\n        \"jar_to_coffee_beans\",\n        ArticulationType.FIXED,\n        parent=jar,\n        child=beans,\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n    )\n\n    # --- wooden lid (lift-off) --------------------------------------------\n    lid = model.part(\"lid\")\n    lid.visual(\n        Cylinder(radius=0.0495, length=0.0080),\n        origin=Origin(xyz=(0.0, 0.0040, 0.0), rpy=(-math.pi / 2.0, 0.0, 0.0)),\n        material=wood,\n        name=\"lid_disc\",\n    )\n    lid.visual(\n        Cylinder(radius=0.0390, length=0.0160),\n        origin=Origin(xyz=(0.0, -0.0080, 0.0), rpy=(-math.pi / 2.0, 0.0, 0.0)),\n        material=cork,\n        name=\"lid_plug\",\n    )\n    lid.visual(\n        Cylinder(radius=0.0095, length=0.0120),\n        origin=Origin(xyz=(0.0, 0.0140, 0.0), rpy=(-math.pi / 2.0, 0.0, 0.0)),\n        material=wood,\n        name=\"lid_knob_stem\",\n    )\n    lid.visual(\n        Sphere(radius=0.0095),\n        origin=Origin(xyz=(0.0, 0.0200, 0.0)),\n        material=wood,\n        name=\"lid_knob_cap\",\n    )\n\n    model.articulation(\n        \"jar_to_lid\",\n        ArticulationType.PRISMATIC,\n        parent=jar,\n        child=lid,\n        origin=Origin(xyz=(0.0, 0.1450, 0.0)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(effort=8.0, velocity=0.20, lower=0.0, upper=0.050),\n    )\n\n    model = fit_to_box(model, (-0.05, 0.095, 0.55), (0.13, 0.17, 0.13))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    jar = object_model.get_part(\"jar\")\n    beans = object_model.get_part(\"coffee_beans\")\n    lid = object_model.get_part(\"lid\")\n    lift = object_model.get_articulation(\"jar_to_lid\")\n\n    # The lid disc seats flush on the rolled rim at rest.\n    ctx.expect_gap(\n        lid,\n        jar,\n        axis=\"y\",\n        min_gap=-0.0002,\n        max_gap=0.0008,\n        positive_elem=\"lid_disc\",\n        negative_elem=\"glass_shell\",\n        name=\"lid seats on the jar rim\",\n    )\n    ctx.expect_overlap(\n        lid,\n        jar,\n        axes=\"xy\",\n        min_overlap=0.070,\n        elem_a=\"lid_disc\",\n        elem_b=\"glass_shell\",\n        name=\"lid covers the jar mouth\",\n    )\n\n    # The cork plug sits inside the mouth footprint.\n    ctx.expect_within(\n        lid,\n        jar,\n        axes=\"xz\",\n        margin=0.0,\n        inner_elem=\"lid_plug\",\n        outer_elem=\"glass_shell\",\n        name=\"cork plug fits inside the mouth\",\n    )\n\n    # Beans rest on the glass base and stay inside the jar footprint.\n    ctx.expect_contact(\n        beans,\n        jar,\n        contact_tol=0.0015,\n        name=\"bean pile rests on the glass base\",\n    )\n    ctx.expect_within(\n        beans,\n        jar,\n        axes=\"xz\",\n        margin=0.001,\n        name=\"bean pile stays inside the jar\",\n    )\n    ctx.allow_overlap(\n        jar,\n        beans,\n        reason=\"Top bean layer is pressed a fraction of a millimetre into the \"\n        \"thick glass base so the loose pile reads as seated, not floating.\",\n    )\n\n    # Lid lifts straight up when the joint is driven.\n    rest = ctx.part_world_position(lid)\n    with ctx.pose({lift: 0.050}):\n        raised = ctx.part_world_position(lid)\n        ctx.expect_gap(\n            lid,\n            jar,\n            axis=\"y\",\n            min_gap=0.040,\n            positive_elem=\"lid_disc\",\n            negative_elem=\"glass_shell\",\n            name=\"lifted lid clears the rim\",\n        )\n    ctx.check(\n        \"lid rises when lifted\",\n        rest is not None and raised is not None and raised[1] > rest[1] + 0.03,\n        details=f\"rest={rest}, raised={raised}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
