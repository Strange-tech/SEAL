[round 5] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    mesh_from_geometry,\n    rounded_rect_profile,\n    tube_from_spline_points,\n    fit_to_box,\n)\n\n\n# ---------------------------------------------------------------------------\n# helpers\n# ---------------------------------------------------------------------------\n\ndef _ring(verts, loop2d, y):\n    \"\"\"Append a horizontal ring of vertices (x, y, z) and return its indices.\"\"\"\n    idx = []\n    for (u, v) in loop2d:\n        idx.append(len(verts))\n        verts.append((u, y, v))\n    return idx\n\n\ndef _stitch(faces, ring_a, ring_b, reverse=False):\n    n = len(ring_a)\n    for i in range(n):\n        j = (i + 1) % n\n        if reverse:\n            faces.append((ring_a[i], ring_b[j], ring_a[j]))\n            faces.append((ring_a[i], ring_b[i], ring_b[j]))\n        else:\n            faces.append((ring_a[i], ring_a[j], ring_b[j]))\n            faces.append((ring_a[i], ring_b[j], ring_b[i]))\n\n\ndef _cap(verts, faces, ring, center, up=True):\n    c = len(verts)\n    verts.append(center)\n    n = len(ring)\n    for i in range(n):\n        j = (i + 1) % n\n        if up:\n            faces.append((c, ring[i], ring[j]))\n        else:\n            faces.append((c, ring[j], ring[i]))\n\n\ndef _pot_mesh() -> MeshGeometry:\n    \"\"\"Hollow, tapered, rounded-square ceramic pot (y-up, base at y=0).\"\"\"\n    # (y, width, depth, corner radius)\n    outer_levels = [\n        (0.000, 0.092, 0.092, 0.014),\n        (0.008, 0.106, 0.106, 0.018),\n        (0.095, 0.142, 0.142, 0.026),\n        (0.136, 0.150, 0.150, 0.028),\n        (0.147, 0.159, 0.159, 0.030),\n        (0.163, 0.156, 0.156, 0.030),\n    ]\n    # inner cavity, from the mouth downward\n    inner_levels = [\n        (0.163, 0.136, 0.136, 0.024),\n        (0.147, 0.128, 0.128, 0.022),\n        (0.055, 0.114, 0.114, 0.020),\n        (0.034, 0.104, 0.104, 0.018),\n    ]\n\n    verts = []\n    faces = []\n\n    rings_out = [\n        _ring(verts, rounded_rect_profile(w, d, r, corner_segments=5), y)\n        for (y, w, d, r) in outer_levels\n    ]\n    for a, b in zip(rings_out, rings_out[1:]):\n        _stitch(faces, a, b)\n    _cap(verts, faces, rings_out[0], (0.0, 0.0, 0.0), up=False)\n\n    rings_in = [\n        _ring(verts, rounded_rect_profile(w, d, r, corner_segments=5), y)\n        for (y, w, d, r) in inner_levels\n    ]\n    # flat rim annulus between outer top ring and inner top ring\n    _stitch(faces, rings_out[-1], rings_in[0])\n    for a, b in zip(rings_in, rings_in[1:]):\n        _stitch(faces, a, b, reverse=True)\n    last = inner_levels[-1]\n    _cap(verts, faces, rings_in[-1], (0.0, last[0] + 0.004, 0.0), up=True)\n\n    return MeshGeometry(verts, faces)\n\n\ndef _soil_mesh() -> MeshGeometry:\n    verts = []\n    faces = []\n    levels = [\n        (0.104, 0.104, 0.104, 0.018),\n        (0.140, 0.128, 0.128, 0.022),\n        (0.150, 0.136, 0.136, 0.024),\n    ]\n    rings = [\n        _ring(verts, rounded_rect_profile(w, d, r, corner_segments=5), y)\n        for (y, w, d, r) in levels\n    ]\n    for a, b in zip(rings, rings[1:]):\n        _stitch(faces, a, b)\n    _cap(verts, faces, rings[0], (0.0, 0.104, 0.0), up=False)\n    # slightly domed soil surface\n    _cap(verts, faces, rings[-1], (0.0, 0.156, 0.0), up=True)\n    return MeshGeometry(verts, faces)\n\n\ndef _leaf_halfwidth(u: float, half_width: float, phase: float) -> float:\n    if u <= 0.0 or u >= 1.0:\n        return 0.0\n    base = math.sin(math.pi * u) ** 0.62\n    lobes = 0.80 + 0.20 * math.cos(2.0 * math.pi * 3.2 * u + phase)\n    return half_width * base * lobes\n\n\ndef _leaf_blade_mesh(\n    start_x: float,\n    length: float,\n    half_width: float,\n    droop: float,\n    cup: float,\n    thickness: float,\n    phase: float,\n    samples: int = 26,\n) -> MeshGeometry:\n    \"\"\"Lobed leaf blade: base at x=start_x, extending along +x, width along z.\"\"\"\n    verts: list[tuple[float, float, float]] = []\n    faces: list[tuple[int, int, int]] = []\n\n    t = thickness * 0.5\n    top_rows = []\n    bot_rows = []\n    for i in range(samples):\n        u = (i / (samples - 1)) * 0.985\n        x = start_x + u * length\n        hw = _leaf_halfwidth(u, half_width, phase)\n        hw = max(hw, 0.0008)\n        y_surf = -droop * u * u\n        ridge = 0.0022 * (math.sin(math.pi * u) ** 0.5)\n        row_top = []\n        row_bot = []\n        for z, lift in ((hw, y_surf), (0.0, y_surf + ridge), (-hw, y_surf)):\n            row_top.append(len(verts))\n            verts.append((x, lift + t, z))\n            row_bot.append(len(verts))\n            verts.append((x, lift - t, z))\n        top_rows.append(row_top)\n        bot_rows.append(row_bot)\n\n    for i in range(samples - 1):\n        ta, tb = top_rows[i], top_rows[i + 1]\n        ba, bb = bot_rows[i], bot_rows[i + 1]\n        for k in range(2):\n            # upper surface\n            faces.append((ta[k], ta[k + 1], tb[k + 1]))\n            faces.append((ta[k], tb[k + 1], tb[k]))\n            # lower surface (reversed winding)\n            faces.append((ba[k], bb[k + 1], ba[k + 1]))\n            faces.append((ba[k], bb[k], bb[k + 1]))\n        # side rims\n        faces.append((ta[0], ba[0], bb[0]))\n        faces.append((ta[0], bb[0], tb[0]))\n        faces.append((ta[2], tb[2], bb[2]))\n        faces.append((ta[2], bb[2], ba[2]))\n\n    # end caps\n    for rows, flip in ((top_rows[0], True), (top_rows[-1], False)):\n        loop = [rows[0], rows[1], rows[2]]\n        center_x = sum(verts[v][0] for v in loop) / 3.0\n        center_y = sum(verts[v][1] for v in loop) / 3.0\n        center_z = sum(verts[v][2] for v in loop) / 3.0\n        c = len(verts)\n        verts.append((center_x, center_y, center_z))\n        for k in range(2):\n            if flip:\n                faces.append((c, loop[k + 1], loop[k]))\n            else:\n                faces.append((c, loop[k], loop[k + 1]))\n\n    return MeshGeometry(verts, faces)\n\n\ndef _rotate_about_z(geom: MeshGeometry, angle: float) -> MeshGeometry:\n    c = math.cos(angle)\n    s = math.sin(angle)\n    geom.vertices = [\n        (x * c - y * s, x * s + y * c, z) for (x, y, z) in geom.vertices\n    ]\n    return geom\n\n\n# leaf layout: (azimuth deg, base height, elevation deg, petiole, length, half width, droop)\nLEAF_LAYOUT = [\n    (12.0, 0.282, 42.0, 0.042, 0.118, 0.050, 0.020),\n    (68.0, 0.252, 22.0, 0.048, 0.126, 0.056, 0.026),\n    (124.0, 0.298, 52.0, 0.038, 0.108, 0.047, 0.016),\n    (186.0, 0.232, 15.0, 0.052, 0.126, 0.054, 0.030),\n    (242.0, 0.288, 46.0, 0.042, 0.116, 0.050, 0.018),\n    (302.0, 0.258, 27.0, 0.048, 0.122, 0.054, 0.024),\n    (348.0, 0.312, 58.0, 0.030, 0.100, 0.043, 0.014),\n]\n\nSTEM_BASE = (0.0, 0.120, 0.0)\nSTEM_TOP = (0.010, 0.330, -0.004)\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"potted_plant\")\n\n    ceramic = model.material(\"ceramic\", rgba=(0.62, 0.58, 0.51, 1.0))\n    ceramic_rim = model.material(\"ceramic_rim\", rgba=(0.52, 0.48, 0.42, 1.0))\n    soil = model.material(\"soil\", rgba=(0.17, 0.13, 0.09, 1.0))\n    stem_mat = model.material(\"stem\", rgba=(0.34, 0.40, 0.16, 1.0))\n    leaf_dark = model.material(\"leaf_dark\", rgba=(0.20, 0.38, 0.13, 1.0))\n    leaf_light = model.material(\"leaf_light\", rgba=(0.32, 0.52, 0.17, 1.0))\n\n    # ---- root: pot with soil and stem ------------------------------------\n    pot = model.part(\"pot\")\n    pot.visual(mesh_from_geometry(_pot_mesh(), \"pot_shell\"), material=ceramic, name=\"pot_shell\")\n    pot.visual(\n        mesh_from_geometry(_soil_mesh(), \"soil_surface\"),\n        material=soil,\n        name=\"soil_surface\",\n    )\n    pot.visual(\n        mesh_from_geometry(\n            tube_from_spline_points(\n                [\n                    STEM_BASE,\n                    (0.003, 0.190, 0.001),\n                    (0.006, 0.250, 0.000),\n                    (0.009, 0.300, -0.002),\n                    STEM_TOP,\n                ],\n                radius=0.0105,\n                samples_per_segment=6,\n                radial_segments=16,\n                cap_ends=True,\n            ),\n            \"stem_trunk\",\n        ),\n        material=stem_mat,\n        name=\"stem_trunk\",\n    )\n\n    # ---- articulated leaves ----------------------------------------------\n    for index, (az_deg, base_y, elev_deg, petiole, length, half_w, droop) in enumerate(\n        LEAF_LAYOUT\n    ):\n        az = math.radians(az_deg)\n        elev = math.radians(elev_deg)\n        phase = 0.9 * index\n\n        leaf = model.part(f\"leaf_{index}\")\n\n        petiole_geom = tube_from_spline_points(\n            [\n                (0.0, 0.0, 0.0),\n                (petiole * 0.45, 0.004, 0.0),\n                (petiole * 0.85, 0.001, 0.0),\n                (petiole + 0.008, -0.001, 0.0),\n            ],\n            radius=0.0045,\n            samples_per_segment=6,\n            radial_segments=12,\n            cap_ends=True,\n        )\n        blade_geom = _leaf_blade_mesh(\n            start_x=petiole - 0.004,\n            length=length,\n            half_width=half_w,\n            droop=droop,\n            cup=0.008,\n            thickness=0.0018,\n            phase=phase,\n        )\n        # bake the elevation into the leaf geometry (leaf tips angle upward)\n        _rotate_about_z(petiole_geom, elev)\n        _rotate_about_z(blade_geom, elev)\n\n        leaf.visual(\n            mesh_from_geometry(petiole_geom, f\"leaf_{index}_petiole\"),\n            material=stem_mat,\n            name=\"petiole\",\n        )\n        leaf.visual(\n            mesh_from_geometry(blade_geom, f\"leaf_{index}_blade\"),\n            material=leaf_dark if index % 2 == 0 else leaf_light,\n            name=\"blade\",\n        )\n\n        # leaf base sits just inside the stem surface\n        bx = 0.008 * math.cos(az)\n        bz = 0.008 * math.sin(az)\n        model.articulation(\n            f\"leaf_{index}_sway\",\n            ArticulationType.REVOLUTE,\n            parent=pot,\n            child=leaf,\n            origin=Origin(xyz=(bx, base_y, bz), rpy=(0.0, -az, 0.0)),\n            axis=(0.0, 0.0, 1.0),\n            motion_limits=MotionLimits(effort=2.0, velocity=1.0, lower=-0.40, upper=0.35),\n        )\n\n    model = fit_to_box(model, (0.55, 0.245, 0.28), (0.36, 0.5, 0.36))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    pot = object_model.get_part(\"pot\")\n\n    # pot reads hollow: soil surface sits inside the shell\n    ctx.expect_within(\n        pot,\n        pot,\n        axes=\"xy\",\n        inner_elem=\"soil_surface\",\n        outer_elem=\"pot_shell\",\n        margin=0.001,\n        name=\"soil sits inside the pot mouth\",\n    )\n\n    for index in range(len(LEAF_LAYOUT)):\n        leaf = object_model.get_part(f\"leaf_{index}\")\n        joint = object_model.get_articulation(f\"leaf_{index}_sway\")\n\n        ctx.expect_contact(\n            leaf,\n            pot,\n            elem_a=\"petiole\",\n            elem_b=\"stem_trunk\",\n            name=f\"leaf_{index} petiole meets the stem\",\n        )\n\n        rest_max_y = ctx.part_world_aabb(leaf)[1][1]\n        with ctx.pose({joint: 0.30}):\n            raised_max_y = ctx.part_world_aabb(leaf)[1][1]\n        ctx.check(\n            f\"leaf_{index} lifts when swayed\",\n            rest_max_y is not None\n            and raised_max_y is not None\n            and raised_max_y > rest_max_y + 0.006,\n            details=f\"rest={rest_max_y}, raised={raised_max_y}\",\n        )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
