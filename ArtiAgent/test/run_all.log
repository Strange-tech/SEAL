[round 4] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nimport cadquery as cq\n\nfrom sdk import (\n    ArticulatedObject,\n    Material,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_cadquery,\n    rounded_rect_profile,\n    sample_catmull_rom_spline_2d,\n)\n\n\n# --------------------------------------------------------------------------\n# Slab dimensions (authored in meters, before fit_to_box).\n# The plate is built in the CadQuery XY plane (X = length, Y = plan-depth,\n# Z = thickness).  It is rotated at the end so that thickness ends up along\n# the SDK vertical (Y / up) axis.\n# --------------------------------------------------------------------------\nSLAB_W = 1.70          # plan length along X\nSLAB_D = 0.95          # plan depth along local Y (becomes world Z)\nSLAB_T = 0.038         # thickness (becomes world Y / up)\nCORNER_R = 0.03\nPLAN_ROT_DEG = 12.0    # diagonal offset in plan view\n\n\ndef _blob(cx, cy, rx, ry, lobes):\n    \"\"\"Build a smooth, irregular closed loop of 2D points.\n\n    `lobes` are per-vertex radius multipliers around an ellipse, so the\n    resulting outline is a wobbly, organic yet smooth-through edge.\n    \"\"\"\n    n = len(lobes)\n    ctrl = []\n    for i, m in enumerate(lobes):\n        a = 2.0 * math.pi * i / n\n        ctrl.append((cx + math.cos(a) * rx * m, cy + math.sin(a) * ry * m))\n    return sample_catmull_rom_spline_2d(ctrl, closed=True, samples_per_segment=10)\n\n\ndef _cutter(pts, thickness):\n    flat = [(float(x), float(y)) for x, y in pts]\n    return (\n        cq.Workplane(\"XY\")\n        .polyline(flat)\n        .close()\n        .extrude(thickness + 0.02)\n        .translate((0.0, 0.0, -0.01))\n    )\n\n\ndef _slab_shape():\n    outer = rounded_rect_profile(SLAB_W, SLAB_D, CORNER_R)\n    plate = (\n        cq.Workplane(\"XY\")\n        .polyline([(float(x), float(y)) for x, y in outer])\n        .close()\n        .extrude(SLAB_T)\n    )\n\n    # Irregular smooth-edged through cutouts.\n    holes = [\n        # large central-left opening\n        _blob(-0.44, 0.02, 0.26, 0.20,\n              [1.00, 0.82, 1.08, 0.90, 1.04, 0.86, 0.98, 1.06, 0.88, 1.02]),\n        # central opening\n        _blob(0.02, -0.11, 0.16, 0.15,\n              [1.00, 0.86, 1.10, 0.92, 1.02, 0.84, 1.06, 0.94]),\n        # right-side opening\n        _blob(0.40, 0.15, 0.19, 0.13,\n              [1.00, 0.88, 1.06, 0.90, 1.04, 0.86, 0.98, 1.02]),\n        # small lower-right opening\n        _blob(0.60, -0.22, 0.10, 0.085,\n              [1.00, 0.90, 1.08, 0.88, 1.02, 0.92]),\n        # left-edge notch (breaks the edge)\n        _blob(-0.85, 0.19, 0.15, 0.12,\n              [1.00, 0.90, 1.05, 0.88, 1.02, 0.94]),\n        # right-edge notch (breaks the edge)\n        _blob(0.86, -0.06, 0.13, 0.16,\n              [1.00, 0.88, 1.06, 0.92, 1.02, 0.90]),\n    ]\n    for hp in holes:\n        plate = plate.cut(_cutter(hp, SLAB_T))\n\n    # Lay the plate flat: thickness (CQ Z) -> SDK up (Y), plan-depth -> world Z.\n    plate = plate.rotate((0, 0, 0), (1, 0, 0), -90.0)\n    # Diagonal orientation in plan view.\n    plate = plate.rotate((0, 0, 0), (0, 1, 0), PLAN_ROT_DEG)\n    return plate\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"countertop\")\n\n    cream_marble = Material(\n        name=\"cream_marble\",\n        rgba=(0.930, 0.918, 0.878, 1.0),\n    )\n    model.material(cream_marble)\n\n    slab = model.part(\"countertop_slab\")\n    slab.visual(\n        mesh_from_cadquery(_slab_shape(), \"countertop_slab\"),\n        name=\"slab\",\n        material=cream_marble,\n    )\n\n    model = fit_to_box(model, (0.0, -0.02, 0.58), (1.88, 0.04, 1.05))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    slab = object_model.get_part(\"countertop_slab\")\n\n    ctx.check(\n        \"single rigid slab part\",\n        len(object_model.parts) == 1,\n        details=f\"parts={[p.name for p in object_model.parts]}\",\n    )\n    ctx.check(\n        \"no articulations on a flat slab\",\n        len(object_model.articulations) == 0,\n        details=f\"articulations={[a.name for a in object_model.articulations]}\",\n    )\n\n    aabb = ctx.part_world_aabb(slab)\n    if aabb is None:\n        ctx.fail(\"slab geometry present\", \"no world AABB\")\n    else:\n        lo, hi = aabb\n        dx = hi[0] - lo[0]\n        dy = hi[1] - lo[1]\n        dz = hi[2] - lo[2]\n        # Thin vertical (Y) axis, broad footprint.\n        ctx.check(\n            \"slab is a thin horizontal plate\",\n            dy <= 0.0405 and dy < dx * 0.2 and dy < dz * 0.2,\n            details=f\"dims=({dx:.3f},{dy:.3f},{dz:.3f})\",\n        )\n        ctx.check(\n            \"slab spans a broad footprint\",\n            dx >= 1.20 and dz >= 0.70,\n            details=f\"footprint=({dx:.3f},{dz:.3f})\",\n        )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
