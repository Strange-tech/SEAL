[round 6] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    LatheGeometry,\n    Material,\n    MeshGeometry,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_geometry,\n    sample_catmull_rom_spline_2d,\n)\n\n# ---------------------------------------------------------------------------\n# Ceramic cup mug, authored directly in the y-up / +z-forward world frame.\n# The body is a genuine thin-walled hollow vessel (wheel-thrown stoneware cup\n# with a flared foot ring and a rounded lip), the handle is a separate ceramic\n# piece bonded on the side of the wall.\n# ---------------------------------------------------------------------------\n\nBODY_HEIGHT = 0.0595\n\n# (radius, height) profiles of the hollow shell, built in a z-up lathe frame.\nOUTER_PROFILE = [\n    (0.0008, 0.0022),  # slightly recessed underside at the centre\n    (0.0150, 0.0022),\n    (0.0225, 0.0011),\n    (0.0244, 0.0000),  # foot ring contact with the table\n    (0.0258, 0.0012),\n    (0.0288, 0.0040),\n    (0.0304, 0.0080),  # waist just above the foot ring\n    (0.0342, 0.0150),\n    (0.0374, 0.0235),\n    (0.0391, 0.0320),\n    (0.0391, 0.0400),\n    (0.0383, 0.0475),\n    (0.0373, 0.0535),\n    (0.0372, 0.0580),\n    (0.0376, 0.0595),  # outer lip\n]\n\nINNER_PROFILE = [\n    (0.0008, 0.0108),  # cavity floor\n    (0.0140, 0.0108),\n    (0.0186, 0.0124),\n    (0.0214, 0.0160),  # inside fillet from floor into the wall\n    (0.0273, 0.0230),\n    (0.0312, 0.0310),\n    (0.0329, 0.0395),\n    (0.0331, 0.0475),\n    (0.0320, 0.0545),\n    (0.0318, 0.0595),  # inner lip, ~5.5 mm wall at the rim\n]\n\n# Handle centreline, in the world x-y plane (loop lies in the vertical plane\n# at mid depth, z = 0). End points are buried inside the wall.\nHANDLE_CONTROL_POINTS = [\n    (0.0330, 0.0498),\n    (0.0432, 0.0524),\n    (0.0508, 0.0478),\n    (0.0538, 0.0388),\n    (0.0528, 0.0288),\n    (0.0470, 0.0212),\n    (0.0372, 0.0178),\n    (0.0330, 0.0168),\n]\n\nHANDLE_END_RADIUS = 0.0074\nHANDLE_MID_RADIUS = 0.0058\n\n\ndef _to_world(geom: MeshGeometry) -> MeshGeometry:\n    \"\"\"Bake the z-up lathe frame into the world y-up frame.\"\"\"\n    geom.vertices = [(x, z, -y) for (x, y, z) in geom.vertices]\n    return geom\n\n\ndef _sub(a, b):\n    return (a[0] - b[0], a[1] - b[1], a[2] - b[2])\n\n\ndef _norm(v):\n    m = math.sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2])\n    if m < 1e-12:\n        return (0.0, 0.0, 0.0)\n    return (v[0] / m, v[1] / m, v[2] / m)\n\n\ndef _build_handle() -> MeshGeometry:\n    \"\"\"Sweep a circular section along the handle centreline (in the XY plane).\"\"\"\n    pts2d = sample_catmull_rom_spline_2d(\n        HANDLE_CONTROL_POINTS, samples_per_segment=10, closed=False\n    )\n    pts = [(x, y, 0.0) for (x, y) in pts2d]\n    n = len(pts)\n    segs = 16\n\n    geom = MeshGeometry()\n    rings: list[list[int]] = []\n    for i, p in enumerate(pts):\n        if i == 0:\n            t = _norm(_sub(pts[1], pts[0]))\n        elif i == n - 1:\n            t = _norm(_sub(pts[-1], pts[-2]))\n        else:\n            t = _norm(_sub(pts[i + 1], pts[i - 1]))\n        # in-plane perpendicular to the tangent\n        e1 = _norm((t[1], -t[0], 0.0))\n        if e1 == (0.0, 0.0, 0.0):\n            e1 = (1.0, 0.0, 0.0)\n        e2 = (0.0, 0.0, 1.0)\n\n        u = i / (n - 1)\n        # thicker where it blends into the wall\n        blend = 0.5 * (1.0 + math.cos(2.0 * math.pi * u))\n        r = HANDLE_MID_RADIUS + (HANDLE_END_RADIUS - HANDLE_MID_RADIUS) * blend\n\n        ring = []\n        for j in range(segs):\n            a = 2.0 * math.pi * j / segs\n            ca, sa = math.cos(a), math.sin(a)\n            ring.append(\n                geom.add_vertex(\n                    p[0] + r * (ca * e1[0] + sa * e2[0]),\n                    p[1] + r * (ca * e1[1] + sa * e2[1]),\n                    p[2] + r * (ca * e1[2] + sa * e2[2]),\n                )\n            )\n        rings.append(ring)\n\n    for i in range(n - 1):\n        a, b = rings[i], rings[i + 1]\n        for j in range(segs):\n            k = (j + 1) % segs\n            geom.add_face(a[j], b[j], b[k])\n            geom.add_face(a[j], b[k], a[k])\n\n    # flat end caps (buried in the wall, so they never read as open tubes)\n    for ring, flip in ((rings[0], True), (rings[-1], False)):\n        cx = sum(geom.vertices[i][0] for i in ring) / segs\n        cy = sum(geom.vertices[i][1] for i in ring) / segs\n        cz = sum(geom.vertices[i][2] for i in ring) / segs\n        c = geom.add_vertex(cx, cy, cz)\n        for j in range(segs):\n            k = (j + 1) % segs\n            if flip:\n                geom.add_face(c, ring[k], ring[j])\n            else:\n                geom.add_face(c, ring[j], ring[k])\n\n    return geom\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"ceramic_cup_mug\")\n\n    glaze = Material(\"celadon_glaze\", rgba=(0.74, 0.78, 0.72, 1.0))\n\n    body = model.part(\"mug_body\")\n    shell = LatheGeometry.from_shell_profiles(\n        OUTER_PROFILE,\n        INNER_PROFILE,\n        segments=88,\n        start_cap=\"flat\",\n        end_cap=\"round\",\n        lip_samples=8,\n    )\n    _to_world(shell)\n    body.visual(mesh_from_geometry(shell, \"mug_shell\"), material=glaze, name=\"shell\")\n\n    handle = model.part(\"handle\")\n    handle.visual(\n        mesh_from_geometry(_build_handle(), \"mug_handle\"),\n        material=glaze,\n        name=\"handle_loop\",\n    )\n\n    model.articulation(\n        \"mug_body_to_handle\",\n        ArticulationType.FIXED,\n        parent=body,\n        child=handle,\n        origin=Origin(),\n    )\n\n    model = fit_to_box(model, (0.14, 0.035, 0.62), (0.09, 0.08, 0.09))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    body = object_model.get_part(\"mug_body\")\n    handle = object_model.get_part(\"handle\")\n\n    body_aabb = ctx.part_world_aabb(body)\n    handle_aabb = ctx.part_world_aabb(handle)\n    if body_aabb is not None:\n        bmin, bmax = body_aabb\n        ctx.check(\n            \"cup is a tall open vessel\",\n            (bmax[1] - bmin[1]) > 0.045 and (bmax[1] - bmin[1]) < 0.07\n            and (bmax[0] - bmin[0]) > 0.05,\n            details=f\"body aabb={body_aabb}\",\n        )\n    ctx.check(\"handle exists and is mounted\", handle is not None)\n\n    # handle ends are socketed into the wall: retained insertion + real contact\n    ctx.allow_overlap(\n        body,\n        handle,\n        elem_a=\"shell\",\n        elem_b=\"handle_loop\",\n        reason=\"The handle ends are intentionally socketed into the hollow wall \"\n        \"of the mug body, as on a real bonded ceramic handle.\",\n    )\n    ctx.expect_contact(body, handle, elem_a=\"shell\", elem_b=\"handle_loop\",\n                       name=\"handle is bonded to the cup wall\")\n    ctx.expect_overlap(\n        body,\n        handle,\n        axes=\"x\",\n        elem_a=\"shell\",\n        elem_b=\"handle_loop\",\n        min_overlap=0.004,\n        name=\"handle root is inserted into the wall\",\n    )\n    if handle_aabb is not None and body_aabb is not None:\n        ctx.check(\n            \"handle stands proud of the cup body\",\n            handle_aabb[1][0] > body_aabb[1][0] + 0.004,\n            details=f\"handle={handle_aabb}, body={body_aabb}\",\n        )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
