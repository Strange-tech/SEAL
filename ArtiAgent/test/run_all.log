[round 4] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_geometry,\n    tube_from_spline_points,\n)\n\n\n# ---------------------------------------------------------------------------\n# Geometry helpers (authored directly in the world y-up / +z-forward frame)\n# ---------------------------------------------------------------------------\n\ndef _revolve(profile, segments=132, flute=None):\n    \"\"\"Solid of revolution about the world +Y axis.\n\n    ``profile`` is a closed, counter-clockwise loop of ``(radius, height)`` (or\n    ``(radius, height, flute_weight)``) points in the y-up frame.  Traverse the\n    material cross-section as: bottom face outward, up the outer wall, across\n    the rim, down the inner wall.  With that winding the emitted triangles face\n    outward.\n\n    ``flute`` is ``(count, amplitude)``: the outer radius of points with a\n    positive flute weight is modulated by ``amplitude * w * cos(count*theta)``,\n    which produces the vertical ribs of a glass dripper.\n    \"\"\"\n    geom = MeshGeometry()\n    rings = []\n    for point in profile:\n        r = float(point[0])\n        y = float(point[1])\n        w = float(point[2]) if len(point) > 2 else 0.0\n        if r <= 1e-9:\n            idx = geom.add_vertex(0.0, y, 0.0)\n            rings.append([idx] * segments)\n            continue\n        ring = []\n        for i in range(segments):\n            a = 2.0 * math.pi * i / segments\n            dr = 0.0\n            if flute is not None and w > 0.0:\n                dr = flute[1] * w * math.cos(flute[0] * a)\n            rad = max(r + dr, 1e-5)\n            ring.append(geom.add_vertex(rad * math.cos(a), y, rad * math.sin(a)))\n        rings.append(ring)\n\n    n = len(profile)\n    for k in range(n):\n        ra = rings[k]\n        rb = rings[(k + 1) % n]\n        for i in range(segments):\n            j = (i + 1) % segments\n            a, b, c, d = ra[i], rb[i], rb[j], ra[j]\n            for tri in ((a, b, c), (a, c, d)):\n                if tri[0] == tri[1] or tri[1] == tri[2] or tri[0] == tri[2]:\n                    continue\n                geom.add_face(*tri)\n    return geom\n\n\n# --- glass server (carafe) -------------------------------------------------\n# (radius, height) loop: outer wall bottom -> rim -> inner wall -> axis\nCARAFE_PROFILE = [\n    (0.0360, 0.0060),\n    (0.0375, 0.0160),\n    (0.0372, 0.0300),\n    (0.0368, 0.0450),\n    (0.0330, 0.0680),\n    (0.0308, 0.0765),\n    (0.0308, 0.0790),\n    (0.0355, 0.0800),\n    (0.0358, 0.0835),\n    (0.0332, 0.0835),\n    (0.0292, 0.0790),\n    (0.0314, 0.0680),\n    (0.0352, 0.0450),\n    (0.0356, 0.0300),\n    (0.0359, 0.0160),\n    (0.0344, 0.0076),\n    (0.0000, 0.0076),\n]\n\nCARAFE_COFFEE_PROFILE = [\n    (0.0000, 0.0076),\n    (0.0347, 0.0076),\n    (0.0362, 0.0160),\n    (0.0359, 0.0300),\n    (0.0355, 0.0450),\n    (0.0333, 0.0580),\n    (0.0000, 0.0580),\n]\n\nBASE_RING_PROFILE = [\n    (0.0355, 0.0000),\n    (0.0448, 0.0000),\n    (0.0452, 0.0040),\n    (0.0446, 0.0085),\n    (0.0400, 0.0092),\n    (0.0355, 0.0092),\n]\n\nHANDLE_PATH = [\n    (-0.0328, 0.0625, 0.0),\n    (-0.0480, 0.0690, 0.0),\n    (-0.0630, 0.0640, 0.0),\n    (-0.0720, 0.0500, 0.0),\n    (-0.0720, 0.0360, 0.0),\n    (-0.0640, 0.0240, 0.0),\n    (-0.0490, 0.0195, 0.0),\n    (-0.0365, 0.0205, 0.0),\n]\n\n# --- glass dripper cone ----------------------------------------------------\n# (radius, height, flute weight), 22 vertical ribs on the outer wall\nDRIPPER_PROFILE = [\n    (0.0100, 0.0835, 0.00),\n    (0.0352, 0.0835, 0.00),\n    (0.0352, 0.0857, 0.00),\n    (0.0230, 0.0860, 0.15),\n    (0.0500, 0.1230, 0.80),\n    (0.0526, 0.1268, 1.00),\n    (0.0528, 0.1285, 1.00),\n    (0.0510, 0.1285, 1.00),\n    (0.0486, 0.1230, 0.00),\n    (0.0216, 0.0860, 0.00),\n    (0.0198, 0.0857, 0.00),\n    (0.0116, 0.0857, 0.00),\n]\n\nDRIPPER_INNER_SLOPE = (0.0486 - 0.0216) / (0.1230 - 0.0860)\n\n\ndef _dripper_inner_radius(height):\n    if height <= 0.0860:\n        return 0.0216\n    return 0.0216 + (height - 0.0860) * DRIPPER_INNER_SLOPE\n\n\n_DRIP_BOTTOM = 0.0862\n_DRIP_TOP = 0.1030\nDRIPPER_COFFEE_PROFILE = [\n    (0.0000, _DRIP_BOTTOM),\n    (_dripper_inner_radius(_DRIP_BOTTOM) + 0.0003, _DRIP_BOTTOM),\n    (_dripper_inner_radius(_DRIP_TOP) + 0.0003, _DRIP_TOP),\n    (0.0000, _DRIP_TOP),\n]\n\n_DRIP_FOAM_R = _dripper_inner_radius(_DRIP_TOP) + 0.0003\nDRIPPER_FOAM_PROFILE = [\n    (0.0000, _DRIP_TOP - 0.0006),\n    (_DRIP_FOAM_R, _DRIP_TOP - 0.0006),\n    (_DRIP_FOAM_R, _DRIP_TOP + 0.0004),\n    (0.0000, _DRIP_TOP + 0.0004),\n]\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"coffee_dripper\")\n\n    glass = model.material(\"glass\", rgba=(0.86, 0.92, 0.94, 0.32))\n    coffee = model.material(\"coffee\", rgba=(0.15, 0.06, 0.02, 1.0))\n    crema = model.material(\"crema\", rgba=(0.46, 0.30, 0.16, 1.0))\n    dark_plastic = model.material(\"dark_plastic\", rgba=(0.08, 0.08, 0.09, 1.0))\n\n    # ---- server: glass carafe that receives the brewed coffee -------------\n    server = model.part(\"server\")\n    server.visual(\n        mesh_from_geometry(_revolve(CARAFE_PROFILE, 132), \"server_body\"),\n        material=glass,\n        name=\"carafe_body\",\n    )\n    server.visual(\n        mesh_from_geometry(_revolve(BASE_RING_PROFILE, 96), \"server_base_ring\"),\n        material=dark_plastic,\n        name=\"base_ring\",\n    )\n    server.visual(\n        mesh_from_geometry(_revolve(CARAFE_COFFEE_PROFILE, 96), \"server_coffee\"),\n        material=coffee,\n        name=\"carafe_coffee\",\n    )\n    server.visual(\n        mesh_from_geometry(\n            tube_from_spline_points(\n                HANDLE_PATH,\n                radius=0.0042,\n                samples_per_segment=14,\n                radial_segments=20,\n                cap_ends=True,\n                up_hint=(0.0, 1.0, 0.0),\n            ),\n            \"server_handle\",\n        ),\n        material=glass,\n        name=\"handle\",\n    )\n\n    # ---- dripper: fluted V60-style cone ----------------------------------\n    dripper = model.part(\"dripper\")\n    dripper.visual(\n        mesh_from_geometry(\n            _revolve(DRIPPER_PROFILE, 132, flute=(22, 0.0008)), \"dripper_cone\"\n        ),\n        material=glass,\n        name=\"dripper_cone\",\n    )\n    dripper.visual(\n        mesh_from_geometry(_revolve(DRIPPER_COFFEE_PROFILE, 96), \"dripper_coffee\"),\n        material=coffee,\n        name=\"dripper_coffee\",\n    )\n    dripper.visual(\n        mesh_from_geometry(_revolve(DRIPPER_FOAM_PROFILE, 96), \"dripper_crema\"),\n        material=crema,\n        name=\"dripper_crema\",\n    )\n\n    # ---- articulation: the dripper lifts vertically off the server rim ----\n    model.articulation(\n        \"server_to_dripper\",\n        ArticulationType.PRISMATIC,\n        parent=server,\n        child=dripper,\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(effort=6.0, velocity=0.08, lower=0.0, upper=0.035),\n    )\n\n    model = fit_to_box(model, (-0.3, 0.31, 0.9), (0.14, 0.13, 0.14))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    server = object_model.get_part(\"server\")\n    dripper = object_model.get_part(\"dripper\")\n    lift = object_model.get_articulation(\"server_to_dripper\")\n\n    # The dripper's base flange rests on the carafe rim when seated.\n    ctx.expect_contact(\n        dripper,\n        server,\n        contact_tol=0.0006,\n        name=\"dripper base flange rests on the carafe rim\",\n    )\n    ctx.expect_gap(\n        dripper,\n        server,\n        axis=\"y\",\n        max_gap=0.0015,\n        max_penetration=0.0002,\n        name=\"seated dripper sits on, not inside, the server rim\",\n    )\n    ctx.expect_overlap(\n        dripper,\n        server,\n        axes=\"xy\",\n        min_overlap=0.05,\n        name=\"dripper is centred over the server mouth\",\n    )\n\n    # Coffee inside the carafe stays within the glass body.\n    coffee_aabb = ctx.part_element_world_aabb(server, elem=\"carafe_coffee\")\n    body_aabb = ctx.part_element_world_aabb(server, elem=\"carafe_body\")\n    contained = False\n    if coffee_aabb is not None and body_aabb is not None:\n        (cmin, cmax), (bmin, bmax) = coffee_aabb, body_aabb\n        contained = (\n            cmin[0] >= bmin[0] - 1e-5\n            and cmax[0] <= bmax[0] + 1e-5\n            and cmin[2] >= bmin[2] - 1e-5\n            and cmax[2] <= bmax[2] + 1e-5\n            and cmin[1] >= bmin[1] - 1e-5\n            and cmax[1] <= bmax[1] + 1e-5\n        )\n    ctx.check(\n        \"carafe coffee is contained in the glass body\",\n        contained,\n        details=f\"coffee={coffee_aabb} body={body_aabb}\",\n    )\n\n    # Raising the dripper clears the server rim.\n    rest_pos = ctx.part_world_position(dripper)\n    with ctx.pose({lift: 0.035}):\n        ctx.expect_gap(\n            dripper,\n            server,\n            axis=\"y\",\n            min_gap=0.025,\n            name=\"lifted dripper clears the server rim\",\n        )\n        lifted_pos = ctx.part_world_position(dripper)\n\n    ctx.check(\n        \"dripper rises when the lift joint is driven positive\",\n        rest_pos is not None\n        and lifted_pos is not None\n        and lifted_pos[1] > rest_pos[1] + 0.025,\n        details=f\"rest={rest_pos} lifted={lifted_pos}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
