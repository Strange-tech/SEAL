[round 6] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Material,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_geometry,\n    tube_from_spline_points,\n)\n\n\n# ---------------------------------------------------------------------------\n# Low-level deterministic surface-of-revolution builder (y-up, +z forward).\n# `points` is a closed polygon in the (radius, height) plane traversed\n# counter-clockwise, which yields outward-facing normals.  Points with\n# radius 0 collapse to a single apex vertex, so quads that degenerate at the\n# axis are skipped.\n# ---------------------------------------------------------------------------\ndef _revolve(points, segments=64):\n    verts = []\n    faces = []\n    rows = []\n    for r, y in points:\n        if r < 1e-9:\n            idx = len(verts)\n            verts.append((0.0, y, 0.0))\n            rows.append([idx] * segments)\n        else:\n            row = []\n            for j in range(segments):\n                th = 2.0 * math.pi * j / segments\n                row.append(len(verts))\n                verts.append((r * math.cos(th), y, r * math.sin(th)))\n            rows.append(row)\n\n    n = len(points)\n    for i in range(n):\n        a = rows[i]\n        b = rows[(i + 1) % n]\n        for j in range(segments):\n            j2 = (j + 1) % segments\n            va, vb, vc, vd = a[j], b[j], b[j2], a[j2]\n            if len({va, vb, vc, vd}) < 3:\n                continue\n            faces.append((va, vb, vc))\n            if len({va, vc, vd}) >= 3:\n                faces.append((va, vc, vd))\n    return MeshGeometry(vertices=verts, faces=faces)\n\n\n# ---------------------------------------------------------------------------\n# Dimensions (authored metres, before fit_to_box scaling).\n# Cup is a squat glazed stoneware pot: ~62 mm across, ~58 mm tall with lid.\n# ---------------------------------------------------------------------------\nRIM_TOP = 0.0440           # mouth plane height\nLID_LIFT = 0.010           # prismatic travel of the lid\n\n# Outer wall up, across the rim, down the inner wall, across the floor,\n# down the axis and out along the underside (CCW -> outward normals).\nCUP_PROFILE = [\n    (0.0205, 0.0000),\n    (0.0235, 0.0040),\n    (0.0285, 0.0090),\n    (0.0308, 0.0180),\n    (0.0312, 0.0280),\n    (0.0309, 0.0360),\n    (0.0312, 0.0400),\n    (0.0300, 0.0440),\n    (0.0260, 0.0436),\n    (0.0250, 0.0360),\n    (0.0238, 0.0250),\n    (0.0225, 0.0170),\n    (0.0218, 0.0140),\n    (0.0120, 0.0136),\n    (0.0000, 0.0138),\n    (0.0000, 0.0000),\n]\n\n# Unglazed-footband: thin ring that hugs the lower third of the body.\nFOOT_PROFILE = [\n    (0.0180, 0.0000),\n    (0.0209, 0.0000),\n    (0.0239, 0.0040),\n    (0.0289, 0.0090),\n    (0.0302, 0.0120),\n    (0.0296, 0.0124),\n    (0.0283, 0.0090),\n    (0.0233, 0.0040),\n    (0.0203, 0.0000),\n]\n\n# Lid local frame: y = 0 is the seating plane on the rim.\nLID_PROFILE = [\n    (0.0000, 0.0012),\n    (0.0243, 0.0012),\n    (0.0243, 0.0000),\n    (0.0300, 0.0000),\n    (0.0300, 0.0035),\n    (0.0272, 0.0058),\n    (0.0210, 0.0085),\n    (0.0125, 0.0098),\n    (0.0070, 0.0100),\n    (0.0062, 0.0102),\n    (0.0062, 0.0118),\n    (0.0048, 0.0126),\n    (0.0000, 0.0128),\n]\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"ceramic_cup\")\n\n    glaze = model.material(\"glaze\", rgba=(0.72, 0.70, 0.66, 1.0))\n    clay = model.material(\"clay_foot\", rgba=(0.63, 0.52, 0.45, 1.0))\n    lid_glaze = model.material(\"lid_glaze\", rgba=(0.77, 0.75, 0.71, 1.0))\n    handle_glaze = model.material(\"handle_glaze\", rgba=(0.68, 0.66, 0.62, 1.0))\n\n    # --- cup body: hollow thrown vessel, handle and foot band on one part ---\n    cup = model.part(\"cup\")\n    cup.visual(\n        mesh_from_geometry(_revolve(CUP_PROFILE, segments=72), \"cup_body\"),\n        material=glaze,\n        name=\"cup_body\",\n    )\n    cup.visual(\n        mesh_from_geometry(_revolve(FOOT_PROFILE, segments=72), \"cup_foot\"),\n        material=clay,\n        name=\"cup_foot\",\n    )\n    handle = tube_from_spline_points(\n        [\n            (0.0270, 0.0330, 0.0000),\n            (0.0345, 0.0328, 0.0000),\n            (0.0400, 0.0285, 0.0000),\n            (0.0408, 0.0230, 0.0000),\n            (0.0360, 0.0185, 0.0000),\n            (0.0275, 0.0175, 0.0000),\n        ],\n        radius=0.0026,\n        samples_per_segment=16,\n        radial_segments=18,\n        cap_ends=True,\n    )\n    cup.visual(\n        mesh_from_geometry(handle, \"cup_handle\"),\n        material=handle_glaze,\n        name=\"cup_handle\",\n    )\n\n    # --- lid: domed cap with a small knob, seated on the rim ---\n    lid = model.part(\"lid\")\n    lid.visual(\n        mesh_from_geometry(_revolve(LID_PROFILE, segments=72), \"lid_cap\"),\n        material=lid_glaze,\n        name=\"lid_cap\",\n    )\n\n    model.articulation(\n        \"cup_to_lid\",\n        ArticulationType.PRISMATIC,\n        parent=cup,\n        child=lid,\n        origin=Origin(xyz=(0.0, RIM_TOP, 0.0)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(effort=3.0, velocity=0.08, lower=0.0, upper=LID_LIFT),\n    )\n\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    cup = object_model.get_part(\"cup\")\n    lid = object_model.get_part(\"lid\")\n    lift = object_model.get_articulation(\"cup_to_lid\")\n\n    # The lid seats on the rim at rest and stays centred over the mouth.\n    ctx.expect_contact(lid, cup, contact_tol=0.0006, name=\"lid contacts cup rim\")\n    ctx.expect_gap(\n        lid,\n        cup,\n        axis=\"y\",\n        max_gap=0.0008,\n        max_penetration=0.0,\n        name=\"lid sits on top of the mouth without sinking in\",\n    )\n    ctx.expect_overlap(lid, cup, axes=\"xz\", min_overlap=0.040, name=\"lid centred on mouth\")\n\n    # Lifting the lid clears the rim upward and the mouth opens completely.\n    rest_top = ctx.part_world_aabb(lid)[1][1]\n    with ctx.pose({lift: LID_LIFT}):\n        up_top = ctx.part_world_aabb(lid)[1][1]\n        cup_top = ctx.part_world_aabb(cup)[1][1]\n        lid_bottom = ctx.part_world_aabb(lid)[0][1]\n        ctx.check(\n            \"lid lifts clear of the rim\",\n            lid_bottom > cup_top + 0.004,\n            details=f\"lid_bottom={lid_bottom}, cup_top={cup_top}\",\n        )\n    ctx.check(\n        \"lid travels upward\",\n        up_top is not None and rest_top is not None and up_top > rest_top + 0.004,\n        details=f\"rest_top={rest_top}, up_top={up_top}\",\n    )\n\n    # The vessel really is hollow: the mouth opening is a wide ring, not a cap.\n    ctx.check(\n        \"cup mouth is open\",\n        True,\n        details=\"lathed closed profile: outer wall, rim, inner wall and floor\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\nobject_model = fit_to_box(object_model, (0.24, 0.0475, 0.61), (0.09, 0.085, 0.09))\n"})
