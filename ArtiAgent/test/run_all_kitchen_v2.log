[round 18] edit_file({"path": "model.py", "old_string": "def _build_glaze_panel():\n    \"\"\"Dark glazed decorative plaque on the front face of the pot (world +z).\"\"\"\n    # cq frame: front face is -y, so the plaque sits on the -y side.\n    panel = cq.Solid.makeBox(0.104, 0.011, 0.082, cq.Vector(-0.052, -0.086, 0.046))\n    return _to_y_up(panel)", "new_string": "def _pot_outer_half_width(y_cq: float) -> float:\n    \"\"\"Outer half width of the pot wall at a given cq height (in the tapered body).\"\"\"\n    return 0.072 + 0.021 * (y_cq - 0.018) / 0.132\n\n\ndef _build_glaze_panel():\n    \"\"\"Dark glazed decorative plaque hugging the tapered front face (world +z).\n\n    The plaque is a thin curved patch that follows the pot's superellipse wall,\n    standing ~2 mm proud of it, then trimmed to a rectangular window.\n    \"\"\"\n    zs = [0.044, 0.070, 0.096, 0.122, 0.134]\n    band = cq.Solid.makeLoft(\n        [_sq_wire(_pot_outer_half_width(z) + 0.0018, z, segments=96) for z in zs],\n        ruled=True,\n    )\n    window = cq.Solid.makeBox(0.092, 0.120, 0.090, cq.Vector(-0.046, -0.200, 0.048))\n    patch = band.intersect(window)\n    return _to_y_up(patch)"})
