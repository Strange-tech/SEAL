[round 5] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nimport cadquery as cq\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Box,\n    Cylinder,\n    Material,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_cadquery,\n)\n\n# ---------------------------------------------------------------------------\n# Authoring frame: y-up, +z forward (front of the scale faces +z).\n# CadQuery is built in its native z-up frame, where cq +y == world -z and\n# cq +z == world +y.  A single -90 deg rotation about X converts to y-up.\n# ---------------------------------------------------------------------------\n\n# Body envelope (pre fit_to_box).\nW = 0.280  # x width\nD = 0.220  # z depth\nHT = 0.024  # body height\n\n# Front display pocket (world coords).\nDISP_CX = 0.0\nDISP_CZ = 0.0625\nDISP_W = 0.124\nDISP_D = 0.065\nDISP_FLOOR = 0.0205\n\n# Weighing platform (world coords).\nPLAT_W = 0.250\nPLAT_D = 0.123\nPLAT_CX = 0.0\nPLAT_CZ = -0.0435\n\n\ndef _to_y_up(shape):\n    \"\"\"Rotate a cq z-up shape into the y-up / +z-forward world frame.\"\"\"\n    return shape.rotate(cq.Vector(0, 0, 0), cq.Vector(1, 0, 0), -90)\n\n\ndef _rounded_slab(w, d, t, fillet, cx, cy, z):\n    \"\"\"A rounded-rectangle prism in the cq z-up frame (world: cx, -cy, z).\"\"\"\n    sk = cq.Sketch().rect(w, d).vertices().fillet(fillet)\n    solid = cq.Workplane(\"XY\").placeSketch(sk).extrude(t).val()\n    return solid.translate(cq.Vector(cx, cy, z))\n\n\ndef _box_solid(dx, dy, dz, xmin, ymin, zmin):\n    return cq.Solid.makeBox(dx, dy, dz, cq.Vector(xmin, ymin, zmin))\n\n\ndef _build_body_shape():\n    # Main housing: rounded slab, front deck level.\n    body = _rounded_slab(W, D, HT, 0.016, 0.0, 0.0, 0.0)\n\n    # Front display well: shallow step + deeper window pocket.\n    step = _box_solid(0.138, 0.079, 0.02, -0.069, -DISP_CZ - 0.0395, HT - 0.0018)\n    body = body.cut(step)\n    pocket = _box_solid(\n        DISP_W, DISP_D, 0.02, -DISP_W / 2, -DISP_CZ - DISP_D / 2, DISP_FLOOR\n    )\n    body = body.cut(pocket)\n\n    # Seam groove around the weighing platform footprint.\n    groove_outer = _rounded_slab(0.266, 0.139, 0.004, 0.017, 0.0, -PLAT_CZ, HT - 0.0016)\n    groove_inner = _rounded_slab(\n        0.254, 0.127, 0.006, 0.015, 0.0, -PLAT_CZ, HT - 0.0026\n    )\n    body = body.cut(groove_outer.cut(groove_inner))\n\n    # Underside clearance pocket: leaves a perimeter rim that reads as feet.\n    under = _box_solid(0.244, 0.184, 0.008, -0.122, -0.092, -0.002)\n    body = body.cut(under)\n\n    return _to_y_up(body)\n\n\ndef _build_platform_shape():\n    plate = _rounded_slab(\n        PLAT_W, PLAT_D, 0.007, 0.014, 0.0, -PLAT_CZ, HT\n    )\n    dish = _rounded_slab(\n        PLAT_W - 0.016, PLAT_D - 0.016, 0.004, 0.012, 0.0, -PLAT_CZ, HT + 0.0055\n    )\n    plate = plate.cut(dish)\n    # Move into the platform part frame (bottom face centre at world 0.024).\n    plate = plate.translate(cq.Vector(0.0, PLAT_CZ * -1.0 * 0.0 + 0.0435, -HT))\n    return _to_y_up(plate)\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"digital_scale\")\n\n    body_mat = Material(name=\"scale_housing\", rgba=(0.255, 0.265, 0.285, 1.0))\n    plat_mat = Material(name=\"weighing_plate\", rgba=(0.60, 0.62, 0.65, 1.0))\n    lcd_mat = Material(name=\"lcd_glass\", rgba=(0.30, 0.44, 0.40, 1.0))\n    btn_mat = Material(name=\"rubber_key\", rgba=(0.13, 0.14, 0.15, 1.0))\n\n    # ----- root housing -----------------------------------------------------\n    body = model.part(\"scale_housing\")\n    body.visual(\n        mesh_from_cadquery(_build_body_shape(), \"scale_housing_shell\"),\n        origin=Origin(),\n        material=body_mat,\n        name=\"housing_shell\",\n    )\n\n    # ----- weighing platform (moves down under load) ------------------------\n    platform = model.part(\"weighing_platform\")\n    platform.visual(\n        mesh_from_cadquery(_build_platform_shape(), \"weighing_platform_plate\"),\n        origin=Origin(),\n        material=plat_mat,\n        name=\"platform_plate\",\n    )\n\n    # ----- display glass (seated in the housing window) ---------------------\n    lcd = model.part(\"display_lcd\")\n    lcd.visual(\n        Box((0.106, 0.0035, 0.052)),\n        origin=Origin(),\n        material=lcd_mat,\n        name=\"lcd_glass\",\n    )\n\n    # ----- key caps ---------------------------------------------------------\n    power_btn = model.part(\"power_button\")\n    power_btn.visual(\n        Cylinder(radius=0.0100, length=0.0040),\n        origin=Origin(xyz=(0.0, 0.0020, 0.0), rpy=(-math.pi / 2, 0.0, 0.0)),\n        material=btn_mat,\n        name=\"power_cap\",\n    )\n\n    unit_btn = model.part(\"unit_button\")\n    unit_btn.visual(\n        Cylinder(radius=0.0075, length=0.0035),\n        origin=Origin(xyz=(0.0, 0.00175, 0.0), rpy=(-math.pi / 2, 0.0, 0.0)),\n        material=btn_mat,\n        name=\"unit_cap\",\n    )\n\n    # ----- articulations ----------------------------------------------------\n    model.articulation(\n        \"housing_to_platform\",\n        ArticulationType.PRISMATIC,\n        parent=body,\n        child=platform,\n        origin=Origin(xyz=(PLAT_CX, HT, PLAT_CZ)),\n        axis=(0.0, -1.0, 0.0),\n        motion_limits=MotionLimits(effort=30.0, velocity=0.01, lower=0.0, upper=0.0028),\n    )\n\n    model.articulation(\n        \"housing_to_display_lcd\",\n        ArticulationType.FIXED,\n        parent=body,\n        child=lcd,\n        origin=Origin(xyz=(DISP_CX, DISP_FLOOR + 0.00175, DISP_CZ)),\n        axis=(0.0, 1.0, 0.0),\n    )\n\n    model.articulation(\n        \"housing_to_power_button\",\n        ArticulationType.PRISMATIC,\n        parent=body,\n        child=power_btn,\n        origin=Origin(xyz=(-0.100, HT, 0.062)),\n        axis=(0.0, -1.0, 0.0),\n        motion_limits=MotionLimits(effort=2.0, velocity=0.02, lower=0.0, upper=0.0014),\n    )\n\n    model.articulation(\n        \"housing_to_unit_button\",\n        ArticulationType.PRISMATIC,\n        parent=body,\n        child=unit_btn,\n        origin=Origin(xyz=(0.098, HT, 0.090)),\n        axis=(0.0, -1.0, 0.0),\n        motion_limits=MotionLimits(effort=2.0, velocity=0.02, lower=0.0, upper=0.0012),\n    )\n\n    model = fit_to_box(model, (-0.17, 0.0225, 1.01), (0.3, 0.035, 0.24))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    body = object_model.get_part(\"scale_housing\")\n    platform = object_model.get_part(\"weighing_platform\")\n    lcd = object_model.get_part(\"display_lcd\")\n    power = object_model.get_part(\"power_button\")\n    unit = object_model.get_part(\"unit_button\")\n\n    plat_joint = object_model.get_articulation(\"housing_to_platform\")\n    power_joint = object_model.get_articulation(\"housing_to_power_button\")\n    unit_joint = object_model.get_articulation(\"housing_to_unit_button\")\n\n    # Platform seats flush on the housing rim and covers most of the deck.\n    ctx.expect_gap(\n        platform,\n        body,\n        axis=\"y\",\n        max_gap=2e-4,\n        max_penetration=1e-4,\n        name=\"platform seats on housing deck\",\n    )\n    ctx.expect_overlap(\n        platform, body, axes=\"xz\", min_overlap=0.09, name=\"platform footprint on deck\"\n    )\n    ctx.expect_within(\n        platform,\n        body,\n        axes=\"xz\",\n        margin=0.004,\n        inner_elem=\"platform_plate\",\n        outer_elem=\"housing_shell\",\n        name=\"platform stays inside housing outline\",\n    )\n\n    # Display glass is seated in the front window and inside its pocket walls.\n    ctx.expect_contact(lcd, body, contact_tol=2e-4, name=\"lcd seated in housing window\")\n    ctx.expect_within(\n        lcd,\n        body,\n        axes=\"xz\",\n        margin=0.02,\n        inner_elem=\"lcd_glass\",\n        outer_elem=\"housing_shell\",\n        name=\"lcd inside housing footprint\",\n    )\n\n    # Both key caps rest on the housing top surface.\n    ctx.expect_contact(power, body, contact_tol=2e-4, name=\"power key rests on housing\")\n    ctx.expect_contact(unit, body, contact_tol=2e-4, name=\"unit key rests on housing\")\n\n    # Pressing the keys and loading the pan must move each part downward.\n    rest_plat = ctx.part_world_aabb(platform)\n    rest_power = ctx.part_world_aabb(power)\n    rest_unit = ctx.part_world_aabb(unit)\n\n    with ctx.pose({plat_joint: 0.0028}):\n        low_plat = ctx.part_world_aabb(platform)\n    with ctx.pose({power_joint: 0.0014}):\n        low_power = ctx.part_world_aabb(power)\n    with ctx.pose({unit_joint: 0.0012}):\n        low_unit = ctx.part_world_aabb(unit)\n\n    ctx.check(\n        \"platform deflects downward under load\",\n        rest_plat is not None\n        and low_plat is not None\n        and low_plat[0][1] < rest_plat[0][1] - 5e-4,\n        details=f\"rest={rest_plat}, loaded={low_plat}\",\n    )\n    ctx.check(\n        \"power key depresses into housing\",\n        rest_power is not None\n        and low_power is not None\n        and low_power[0][1] < rest_power[0][1] - 3e-4,\n        details=f\"rest={rest_power}, pressed={low_power}\",\n    )\n    ctx.check(\n        \"unit key depresses into housing\",\n        rest_unit is not None\n        and low_unit is not None\n        and low_unit[0][1] < rest_unit[0][1] - 3e-4,\n        details=f\"rest={rest_unit}, pressed={low_unit}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
