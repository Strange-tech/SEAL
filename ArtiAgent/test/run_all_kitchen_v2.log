[round 4] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Cylinder,\n    Inertial,\n    LatheGeometry,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    Box,\n    fit_to_box,\n    mesh_from_geometry,\n    tube_from_spline_points,\n)\n\n# ---------------------------------------------------------------------------\n# small vector helpers\n# ---------------------------------------------------------------------------\nVec = tuple[float, float, float]\nUP: Vec = (0.0, 1.0, 0.0)\n\n\ndef _add(a: Vec, b: Vec) -> Vec:\n    return (a[0] + b[0], a[1] + b[1], a[2] + b[2])\n\n\ndef _sub(a: Vec, b: Vec) -> Vec:\n    return (a[0] - b[0], a[1] - b[1], a[2] - b[2])\n\n\ndef _mul(a: Vec, s: float) -> Vec:\n    return (a[0] * s, a[1] * s, a[2] * s)\n\n\ndef _dot(a: Vec, b: Vec) -> float:\n    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]\n\n\ndef _cross(a: Vec, b: Vec) -> Vec:\n    return (\n        a[1] * b[2] - a[2] * b[1],\n        a[2] * b[0] - a[0] * b[2],\n        a[0] * b[1] - a[1] * b[0],\n    )\n\n\ndef _norm(a: Vec) -> Vec:\n    length = math.sqrt(_dot(a, a))\n    if length < 1e-12:\n        return (0.0, 1.0, 0.0)\n    return _mul(a, 1.0 / length)\n\n\ndef _quad(geom: MeshGeometry, a: int, b: int, c: int, d: int) -> None:\n    geom.add_face(a, b, c)\n    geom.add_face(a, c, d)\n\n\ndef _zup_to_yup(geom: MeshGeometry) -> MeshGeometry:\n    \"\"\"Bake a z-up lathe/revolve mesh into the y-up world frame.\"\"\"\n    geom.vertices = [(x, z, -y) for (x, y, z) in geom.vertices]\n    return geom\n\n\n# ---------------------------------------------------------------------------\n# leaf mesh\n# ---------------------------------------------------------------------------\ndef _leaf_mesh(\n    base: Vec,\n    tip_dir: Vec,\n    normal_hint: Vec,\n    length: float,\n    width: float,\n    *,\n    curl: float = 0.004,\n    cup: float = 0.38,\n    thickness: float = 0.0011,\n) -> MeshGeometry:\n    \"\"\"Oval, pointed, slightly cupped leaf with real thickness.\"\"\"\n    el = _norm(tip_dir)\n    n = _norm(_sub(normal_hint, _mul(el, _dot(normal_hint, el))))\n    ew = _cross(n, el)  # el x ew == n  -> top faces wound CCW from +n\n\n    geom = MeshGeometry()\n    nu, nv = 8, 4\n    top: list[list[int]] = []\n    bot: list[list[int]] = []\n    for i in range(nu + 1):\n        u = i / nu\n        half_width = 0.5 * width * (math.sin(math.pi * (u ** 0.85)) ** 0.62) * (1.0 - 0.28 * u)\n        half_width = max(half_width, 0.0007)\n        centre = _add(base, _mul(el, length * u))\n        centre = _add(centre, _mul(n, curl * math.sin(math.pi * u)))\n        th = thickness * (0.35 + 0.65 * math.sin(math.pi * u))\n        row_top: list[int] = []\n        row_bot: list[int] = []\n        for j in range(nv + 1):\n            v = -1.0 + 2.0 * j / nv\n            p = _add(centre, _mul(ew, half_width * v))\n            p = _add(p, _mul(n, cup * half_width * v * v * 1.1))\n            row_top.append(geom.add_vertex(*_add(p, _mul(n, th * 0.5))))\n            row_bot.append(geom.add_vertex(*_sub(p, _mul(n, th * 0.5))))\n        top.append(row_top)\n        bot.append(row_bot)\n\n    for i in range(nu):\n        for j in range(nv):\n            _quad(geom, top[i][j], top[i + 1][j], top[i + 1][j + 1], top[i][j + 1])\n            _quad(geom, bot[i][j], bot[i][j + 1], bot[i + 1][j + 1], bot[i + 1][j])\n    for i in range(nu):\n        _quad(geom, top[i][0], bot[i][0], bot[i + 1][0], top[i + 1][0])\n        _quad(geom, top[i][nv], top[i + 1][nv], bot[i + 1][nv], bot[i][nv])\n    for j in range(nv):\n        _quad(geom, top[0][j], top[0][j + 1], bot[0][j + 1], bot[0][j])\n        _quad(geom, top[nu][j], bot[nu][j], bot[nu][j + 1], top[nu][j + 1])\n    return geom\n\n\ndef _merge(items: list[MeshGeometry]) -> MeshGeometry:\n    merged = MeshGeometry()\n    for item in items:\n        merged.merge(item)\n    return merged\n\n\ndef _merge_by_tint(items: list[tuple[str, MeshGeometry]]) -> dict[str, MeshGeometry]:\n    groups: dict[str, list[MeshGeometry]] = {}\n    for tint, geom in items:\n        groups.setdefault(tint, []).append(geom)\n    return {tint: _merge(geoms) for tint, geoms in groups.items()}\n\n\n# ---------------------------------------------------------------------------\n# pot shell\n# ---------------------------------------------------------------------------\nPOT_RIM_Y = 0.161\nSTEM_ROOT_Y = 0.150\n\n\ndef _pot_shell_mesh() -> MeshGeometry:\n    outer = [\n        (0.0600, 0.000),\n        (0.0605, 0.020),\n        (0.0655, 0.080),\n        (0.0715, 0.145),\n        (0.0735, 0.158),\n        (0.0740, 0.161),\n    ]\n    inner = [\n        (0.0500, 0.014),\n        (0.0505, 0.020),\n        (0.0575, 0.080),\n        (0.0630, 0.145),\n        (0.0650, 0.158),\n        (0.0655, 0.161),\n    ]\n    geom = LatheGeometry.from_shell_profiles(\n        outer,\n        inner,\n        segments=64,\n        start_cap=\"flat\",\n        end_cap=\"flat\",\n        lip_samples=6,\n    )\n    return _zup_to_yup(geom)\n\n\ndef _soil_mesh() -> MeshGeometry:\n    profile = [(0.0, 0.131), (0.0598, 0.131), (0.0612, 0.157), (0.0, 0.157)]\n    geom = LatheGeometry(profile, segments=48, closed=True)\n    return _zup_to_yup(geom)\n\n\n# ---------------------------------------------------------------------------\n# foliage builders\n# ---------------------------------------------------------------------------\ndef _spray_point(branch: Vec, d: Vec, f: float) -> Vec:\n    return _add(_add(branch, _mul(d, 0.0015 + 0.046 * f)), _mul(UP, 0.034 * (f ** 1.7)))\n\n\ndef _spray_geometry(branch: Vec, direction: Vec, leaf_plan, stem_radius: float = 0.0020):\n    \"\"\"Thin curved side stem plus its leaves, authored in world coordinates.\"\"\"\n    d = _norm((direction[0], 0.0, direction[2]))\n    perp = _norm(_cross(UP, d))\n\n    path = [\n        _spray_point(branch, d, 0.0),\n        _spray_point(branch, d, 0.35),\n        _spray_point(branch, d, 0.70),\n        _spray_point(branch, d, 1.0),\n    ]\n    stem = tube_from_spline_points(\n        path,\n        radius=stem_radius,\n        samples_per_segment=10,\n        radial_segments=9,\n        cap_ends=True,\n    )\n    foliage: list[tuple[str, MeshGeometry]] = []\n    for (f, side, length, tint, lift) in leaf_plan:\n        base = _spray_point(branch, d, f)\n        base = _add(base, _mul(d, 0.0012))\n        tip_dir = _norm(\n            _add(_add(_mul(d, 0.80), _mul(perp, side * 0.60)), _mul(UP, lift))\n        )\n        normal = _norm(_add(_add(UP, _mul(perp, side * 0.28)), _mul(d, -0.12)))\n        foliage.append(\n            (\n                tint,\n                _leaf_mesh(base, tip_dir, normal, length, length * 0.56, curl=length * 0.10),\n            )\n        )\n    return stem, foliage\n\n\ndef _main_stem_geometry():\n    stem_path = [\n        (0.000, 0.146, 0.000),\n        (0.006, 0.185, 0.004),\n        (-0.004, 0.222, 0.006),\n        (0.006, 0.255, -0.004),\n        (0.014, 0.282, 0.004),\n    ]\n    stem = tube_from_spline_points(\n        stem_path,\n        radius=0.0032,\n        samples_per_segment=12,\n        radial_segments=10,\n        cap_ends=True,\n    )\n    # (base point, tip direction, normal hint, length, tint)\n    plan = [\n        ((0.004, 0.196, 0.004), (0.90, 0.34, -0.24), (0.0, 1.0, 0.2), 0.042, \"dark\"),\n        ((0.000, 0.216, 0.006), (-0.72, 0.40, 0.55), (0.1, 1.0, -0.1), 0.040, \"light\"),\n        ((0.004, 0.240, -0.002), (0.22, 0.48, -0.85), (-0.2, 1.0, 0.2), 0.044, \"dark\"),\n        ((0.009, 0.259, 0.000), (-0.55, 0.52, -0.55), (0.0, 1.0, 0.1), 0.038, \"light\"),\n        ((0.013, 0.280, 0.003), (0.62, 0.58, 0.24), (-0.1, 1.0, -0.2), 0.040, \"dark\"),\n    ]\n    foliage: list[tuple[str, MeshGeometry]] = []\n    for base, tip, normal, length, tint in plan:\n        foliage.append(\n            (\n                tint,\n                _leaf_mesh(base, tip, normal, length, length * 0.58, curl=length * 0.09),\n            )\n        )\n    return stem, foliage\n\n\nSPRAYS = [\n    {\n        \"name\": \"leaf_spray_0\",\n        \"branch\": (0.001, 0.205, 0.005),\n        \"direction\": (0.96, 0.0, 0.28),\n        \"plan\": [\n            (0.34, 0.85, 0.038, \"dark\", 0.42),\n            (0.62, -0.70, 0.042, \"light\", 0.38),\n            (0.95, 0.15, 0.036, \"dark\", 0.52),\n            (0.62, 1.00, 0.031, \"light\", 0.22),\n        ],\n    },\n    {\n        \"name\": \"leaf_spray_1\",\n        \"branch\": (0.003, 0.245, -0.001),\n        \"direction\": (-0.60, 0.0, 0.80),\n        \"plan\": [\n            (0.32, -0.80, 0.036, \"light\", 0.40),\n            (0.64, 0.75, 0.044, \"dark\", 0.36),\n            (0.97, -0.12, 0.035, \"light\", 0.55),\n            (0.64, -1.00, 0.030, \"dark\", 0.20),\n        ],\n    },\n    {\n        \"name\": \"leaf_spray_2\",\n        \"branch\": (0.010, 0.268, 0.000),\n        \"direction\": (-0.40, 0.0, -0.92),\n        \"plan\": [\n            (0.35, 0.80, 0.039, \"dark\", 0.44),\n            (0.62, -0.75, 0.037, \"light\", 0.40),\n            (0.96, 0.10, 0.033, \"dark\", 0.50),\n            (0.60, 1.00, 0.029, \"light\", 0.24),\n        ],\n    },\n    {\n        \"name\": \"leaf_spray_3\",\n        \"branch\": (-0.001, 0.190, 0.004),\n        \"direction\": (-0.88, 0.0, 0.47),\n        \"plan\": [\n            (0.33, 0.82, 0.041, \"light\", 0.38),\n            (0.63, -0.72, 0.040, \"dark\", 0.42),\n            (0.95, 0.18, 0.035, \"light\", 0.52),\n            (0.58, 1.00, 0.032, \"dark\", 0.26),\n        ],\n    },\n]\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"potted_plant\")\n\n    concrete = model.material(\"concrete_pot\", rgba=(0.74, 0.72, 0.67, 1.0))\n    concrete_inner = model.material(\"concrete_inner\", rgba=(0.62, 0.60, 0.56, 1.0))\n    soil = model.material(\"potting_soil\", rgba=(0.17, 0.13, 0.10, 1.0))\n    stem_mat = model.material(\"stem_green\", rgba=(0.32, 0.40, 0.19, 1.0))\n    leaf_dark_mat = model.material(\"leaf_dark\", rgba=(0.11, 0.29, 0.13, 1.0))\n    leaf_light_mat = model.material(\"leaf_light\", rgba=(0.27, 0.49, 0.20, 1.0))\n\n    tint_material = {\"dark\": leaf_dark_mat, \"light\": leaf_light_mat}\n\n    # ---- pot (root) ------------------------------------------------------\n    pot = model.part(\"pot\")\n    pot.visual(\n        mesh_from_geometry(_pot_shell_mesh(), \"pot_shell\"),\n        material=concrete,\n        name=\"pot_shell\",\n    )\n    pot.visual(\n        mesh_from_geometry(_soil_mesh(), \"pot_soil\"),\n        material=soil,\n        name=\"soil\",\n    )\n    pot.inertial = Inertial.from_geometry(\n        Cylinder(radius=0.074, length=0.161),\n        mass=1.6,\n        origin=Origin(xyz=(0.0, 0.0805, 0.0), rpy=(-math.pi / 2.0, 0.0, 0.0)),\n    )\n\n    # ---- main stem ------------------------------------------------------\n    stem_core, stem_foliage = _main_stem_geometry()\n    stem_origin = (0.0, STEM_ROOT_Y, 0.0)\n    stem_core = stem_core.translate(-stem_origin[0], -stem_origin[1], -stem_origin[2])\n    stem_part = model.part(\"plant_stem\")\n    stem_part.visual(\n        mesh_from_geometry(stem_core, \"plant_stem_core\"),\n        material=stem_mat,\n        name=\"stem_core\",\n    )\n    for tint, geom in _merge_by_tint(stem_foliage).items():\n        stem_part.visual(\n            mesh_from_geometry(\n                geom.translate(-stem_origin[0], -stem_origin[1], -stem_origin[2]),\n                f\"plant_stem_leaves_{tint}\",\n            ),\n            material=tint_material[tint],\n            name=f\"leaves_{tint}\",\n        )\n\n    model.articulation(\n        \"pot_to_plant_stem\",\n        ArticulationType.REVOLUTE,\n        parent=pot,\n        child=stem_part,\n        origin=Origin(xyz=stem_origin),\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=0.6, velocity=0.8, lower=-0.07, upper=0.07),\n    )\n\n    # ---- side leaf sprays ----------------------------------------------\n    for spec in SPRAYS:\n        branch: Vec = spec[\"branch\"]\n        direction: Vec = spec[\"direction\"]\n        stem_geom, foliage = _spray_geometry(branch, direction, spec[\"plan\"])\n        part = model.part(spec[\"name\"])\n        part.visual(\n            mesh_from_geometry(\n                stem_geom.translate(-branch[0], -branch[1], -branch[2]),\n                f\"{spec['name']}_stem\",\n            ),\n            material=stem_mat,\n            name=\"stem\",\n        )\n        for tint, geom in _merge_by_tint(foliage).items():\n            part.visual(\n                mesh_from_geometry(\n                    geom.translate(-branch[0], -branch[1], -branch[2]),\n                    f\"{spec['name']}_leaves_{tint}\",\n                ),\n                material=tint_material[tint],\n                name=f\"leaves_{tint}\",\n            )\n        d = _norm((direction[0], 0.0, direction[2]))\n        swing_axis = _norm(_cross(UP, d))\n        model.articulation(\n            f\"pot_to_{spec['name']}\",\n            ArticulationType.REVOLUTE,\n            parent=pot,\n            child=part,\n            origin=Origin(xyz=branch),\n            axis=swing_axis,\n            motion_limits=MotionLimits(effort=0.15, velocity=0.8, lower=-0.14, upper=0.14),\n        )\n\n    model = fit_to_box(model, (-0.45, 0.28, 0.89), (0.38, 0.3, 0.36))\n    return model\n\n\ndef run_tests():\n    from sdk import TestContext\n\n    ctx = TestContext(object_model)\n    pot = object_model.get_part(\"pot\")\n    stem = object_model.get_part(\"plant_stem\")\n\n    sprays = [object_model.get_part(spec[\"name\"]) for spec in SPRAYS]\n\n    # pot is a real open vessel: the soil sits inside the rim\n    ctx.expect_within(\n        \"soil\",\n        \"pot_shell\",\n        axes=\"xy\",\n        margin=0.0,\n        inner_elem=\"soil\",\n        outer_elem=\"pot_shell\",\n        name=\"soil is contained inside the pot wall\",\n    )\n    soil_top = ctx.part_element_world_aabb(pot, elem=\"soil\")\n    shell_top = ctx.part_element_world_aabb(pot, elem=\"pot_shell\")\n    ctx.check(\n        \"soil surface sits just below the rim\",\n        soil_top is not None\n        and shell_top is not None\n        and 0.0 < shell_top[1][1] - soil_top[1][1] < 0.02,\n        details=f\"soil_top={soil_top}, shell_top={shell_top}\",\n    )\n\n    # foliage stands above the pot and is rooted in it\n    ctx.expect_overlap(\n        stem, pot, axes=\"xy\", min_overlap=0.02, name=\"main stem footprint overlaps the pot\"\n    )\n    ctx.expect_contact(stem, pot, contact_tol=0.004, name=\"main stem is seated in the pot\")\n\n    for spray in sprays:\n        ctx.expect_contact(\n            spray,\n            stem,\n            contact_tol=0.006,\n            name=f\"{spray.name} attaches to the main stem\",\n        )\n\n    pot_aabb = ctx.part_world_aabb(pot)\n    foliage_aabb = ctx.part_element_world_aabb(stem, elem=\"leaves_dark\")\n    ctx.check(\n        \"foliage rises well above the pot rim\",\n        pot_aabb is not None\n        and foliage_aabb is not None\n        and foliage_aabb[1][1] > pot_aabb[1][1] + 0.06,\n        details=f\"pot={pot_aabb}, leaves={foliage_aabb}\",\n    )\n\n    # a light sideways sway moves the foliage in depth\n    sway = object_model.get_articulation(\"pot_to_plant_stem\")\n    rest = ctx.part_element_world_aabb(stem, elem=\"leaves_light\")\n    with ctx.pose({sway: 0.07}):\n        swung = ctx.part_element_world_aabb(stem, elem=\"leaves_light\")\n    if rest is not None and swung is not None:\n        rest_cz = 0.5 * (rest[0][2] + rest[1][2])\n        swung_cz = 0.5 * (swung[0][2] + swung[1][2])\n        ctx.check(\n            \"positive sway tilts the plant forward\",\n            abs(swung_cz - rest_cz) > 0.003,\n            details=f\"rest_cz={rest_cz}, swung_cz={swung_cz}\",\n        )\n    else:\n        ctx.fail(\"positive sway tilts the plant forward\", \"missing foliage AABB\")\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
