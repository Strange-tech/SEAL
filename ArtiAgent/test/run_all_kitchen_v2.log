[round 3] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\nimport random\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Material,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_geometry,\n)\n\n# ---------------------------------------------------------------------------\n# Dimensions (metres, authored in y-up / +z-forward frame before fit_to_box)\n# ---------------------------------------------------------------------------\nOUTER_R = 0.045      # glass outer radius\nINNER_R = 0.041      # glass inner radius (wall ~4 mm)\nBASE_T = 0.010       # solid glass base thickness\nHEIGHT = 0.100       # jar rim height\n\nBEAN_RX = 0.0055     # bean half length\nBEAN_RY = 0.0026     # bean half height (thickness)\nBEAN_RZ = 0.0036     # bean half width\nFILL_H = 0.052       # height of the bean fill\n\nLID_OUTER = 0.047\nLID_CAV = 0.0455     # lid inner cavity radius (> OUTER_R -> clearance over rim)\nLID_SKIRT = 0.006    # skirt drop below rim\nLID_TOP_T = 0.008    # lid top thickness\n\n\n# ---------------------------------------------------------------------------\n# Mesh helpers (build in z-up then convert to y-up)\n# ---------------------------------------------------------------------------\ndef _revolve(profile, segments=72):\n    \"\"\"Revolve a closed (r, z) polygon around the z axis into a watertight mesh.\"\"\"\n    geom = MeshGeometry()\n    ring_pts = []\n    for (r, z) in profile:\n        if r <= 1e-9:\n            ring_pts.append([geom.add_vertex(0.0, 0.0, z)])\n        else:\n            row = []\n            for s in range(segments):\n                ang = 2.0 * math.pi * s / segments\n                row.append(geom.add_vertex(r * math.cos(ang), r * math.sin(ang), z))\n            ring_pts.append(row)\n    n = len(profile)\n    for i in range(n):\n        a = ring_pts[i]\n        b = ring_pts[(i + 1) % n]\n        if len(a) == 1 and len(b) == 1:\n            continue\n        if len(a) == 1:\n            for s in range(segments):\n                s2 = (s + 1) % segments\n                geom.add_face(a[0], b[s], b[s2])\n        elif len(b) == 1:\n            for s in range(segments):\n                s2 = (s + 1) % segments\n                geom.add_face(a[s], a[s2], b[0])\n        else:\n            for s in range(segments):\n                s2 = (s + 1) % segments\n                geom.add_face(a[s], b[s], b[s2])\n                geom.add_face(a[s], b[s2], a[s2])\n    return geom\n\n\ndef _to_yup(geom):\n    geom.vertices = [(x, z, -y) for (x, y, z) in geom.vertices]\n    return geom\n\n\ndef _ellipsoid(rx, ry, rz, ws=10, hr=6):\n    \"\"\"UV-sphere ellipsoid centred at origin, half-extents rx, ry, rz.\"\"\"\n    g = MeshGeometry()\n    rows = []\n    for i in range(1, hr):\n        theta = math.pi * i / hr\n        y = ry * math.cos(theta)\n        rr = math.sin(theta)\n        row = []\n        for j in range(ws):\n            phi = 2.0 * math.pi * j / ws\n            x = rx * rr * math.cos(phi)\n            z = rz * rr * math.sin(phi)\n            row.append(g.add_vertex(x, y, z))\n        rows.append(row)\n    top = g.add_vertex(0.0, ry, 0.0)\n    bot = g.add_vertex(0.0, -ry, 0.0)\n    first = rows[0]\n    for j in range(ws):\n        j2 = (j + 1) % ws\n        g.add_face(top, first[j], first[j2])\n    for i in range(len(rows) - 1):\n        a = rows[i]\n        b = rows[i + 1]\n        for j in range(ws):\n            j2 = (j + 1) % ws\n            g.add_face(a[j], b[j], b[j2])\n            g.add_face(a[j], b[j2], a[j2])\n    last = rows[-1]\n    for j in range(ws):\n        j2 = (j + 1) % ws\n        g.add_face(bot, last[j2], last[j])\n\n\n        g.add_face  # no-op to keep linters quiet\n    return g\n\n\ndef _build_beans():\n    \"\"\"Packed, jittered coffee beans filling the lower part of the jar.\"\"\"\n    rng = random.Random(7)\n    geom = MeshGeometry()\n    t = BASE_T\n    fill_r = INNER_R - 0.007\n    spacing = 0.0092\n    y = t + BEAN_RY\n    layer = 0\n    while y < t + FILL_H - BEAN_RY * 0.5:\n        frac = (y - t) / FILL_H\n        rr = fill_r * (1.0 - 0.30 * max(0.0, (frac - 0.62)) / 0.38)\n        n = int(rr / spacing) + 1\n        for ix in range(-n, n + 1):\n            for iz in range(-n, n + 1):\n                cx = ix * spacing + (spacing * 0.5 if layer % 2 else 0.0)\n                cz = iz * spacing\n                cx += rng.uniform(-0.0014, 0.0014)\n                cz += rng.uniform(-0.0014, 0.0014)\n                if cx * cx + cz * cz > rr * rr:\n                    continue\n                bean = _ellipsoid(BEAN_RX, BEAN_RY, BEAN_RZ, ws=10, hr=6)\n                bean.rotate((0.0, 1.0, 0.0), rng.uniform(0.0, math.pi * 2.0))\n                if layer > 0:\n                    tilt = math.radians(rng.uniform(-9.0, 9.0))\n                    bean.rotate((1.0, 0.0, 0.0), tilt)\n                if layer == 0:\n                    bean.translate(cx, t + BEAN_RY, cz)\n                else:\n                    bean.translate(cx, y, cz)\n                geom.merge(bean)\n        y += BEAN_RY * 2.0 * 0.90\n        layer += 1\n    return geom\n\n\n# ---------------------------------------------------------------------------\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"coffee_bean_jar\")\n\n    glass_mat = Material(name=\"glass\", rgba=(0.74, 0.82, 0.82, 0.42))\n    bean_mat = Material(name=\"coffee_bean\", rgba=(0.22, 0.12, 0.06, 1.0))\n    lid_mat = Material(name=\"lid_plastic\", rgba=(0.10, 0.09, 0.08, 1.0))\n\n    # --- glass jar body (root) ---\n    jar = model.part(\"jar\")\n    jar_profile = [\n        (0.0, 0.0),\n        (OUTER_R, 0.0),\n        (OUTER_R, HEIGHT),\n        (INNER_R, HEIGHT),\n        (INNER_R, BASE_T),\n        (0.0, BASE_T),\n    ]\n    jar_geom = _to_yup(_revolve(jar_profile, segments=72))\n    jar.visual(\n        mesh_from_geometry(jar_geom, \"jar_glass\"),\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        material=glass_mat,\n        name=\"glass_body\",\n    )\n\n    # --- coffee beans (fixed inside jar) ---\n    beans = model.part(\"coffee_beans\")\n    beans.visual(\n        mesh_from_geometry(_build_beans(), \"coffee_bean_mass\"),\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        material=bean_mat,\n        name=\"bean_mass\",\n    )\n\n    # --- screw lid (local frame: rim-top plane at y = 0) ---\n    lid = model.part(\"lid\")\n    lid_profile = [\n        (0.0, 0.0),\n        (LID_CAV, 0.0),\n        (LID_CAV, -LID_SKIRT),\n        (LID_OUTER, -LID_SKIRT),\n        (LID_OUTER, LID_TOP_T),\n        (0.0, LID_TOP_T),\n    ]\n    lid_geom = _to_yup(_revolve(lid_profile, segments=72))\n    lid.visual(\n        mesh_from_geometry(lid_geom, \"lid_shell\"),\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        material=lid_mat,\n        name=\"lid_shell\",\n    )\n\n    # --- articulations ---\n    model.articulation(\n        \"jar_to_beans\",\n        ArticulationType.FIXED,\n        parent=jar,\n        child=beans,\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n    )\n\n    model.articulation(\n        \"jar_to_lid\",\n        ArticulationType.REVOLUTE,\n        parent=jar,\n        child=lid,\n        origin=Origin(xyz=(0.0, HEIGHT, 0.0)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(effort=2.0, velocity=3.0, lower=0.0, upper=4.71),\n    )\n\n    model = fit_to_box(model, (0.02, 0.113, 0.62), (0.115, 0.15, 0.115))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    jar = object_model.get_part(\"jar\")\n    beans = object_model.get_part(\"coffee_beans\")\n    lid = object_model.get_part(\"lid\")\n    lid_joint = object_model.get_articulation(\"jar_to_lid\")\n\n    # lid seats on the rim and covers the mouth\n    ctx.expect_contact(lid, jar, contact_tol=0.001, name=\"lid seats on jar rim\")\n    ctx.expect_overlap(lid, jar, axes=\"xy\", min_overlap=0.05, name=\"lid covers mouth\")\n\n    # beans rest on the jar floor and stay within the wall footprint\n    ctx.expect_contact(beans, jar, contact_tol=0.001, name=\"beans rest on jar floor\")\n    ctx.expect_within(beans, jar, axes=\"xy\", margin=0.0, name=\"beans inside jar wall\")\n\n    # unscrewing the lid rotates it without lifting off the assembly\n    with ctx.pose({lid_joint: 1.2}):\n        ctx.expect_overlap(lid, jar, axes=\"xy\", min_overlap=0.05,\n                           name=\"lid stays over mouth while turning\")\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
