[round 4] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Box,\n    Cylinder,\n    ExtrudeWithHolesGeometry,\n    KnobBore,\n    KnobGeometry,\n    KnobGrip,\n    LatheGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_geometry,\n    rounded_rect_profile,\n    superellipse_side_loft,\n)\n\n\n# ---------------------------------------------------------------------------\n# Geometry helpers\n#\n# All authoring is done in the y-up / +z-forward world frame.  LatheGeometry\n# builds around local +Z, so the vertex list is rebaked to make the lathe axis\n# point along world +Y (world = (x, z, -y)).\n# ---------------------------------------------------------------------------\n\n\ndef _lathe_solid(profile, segments=64):\n    geom = LatheGeometry(profile, segments=segments, closed=True)\n    geom.vertices = [(x, z, -y) for (x, y, z) in geom.vertices]\n    return geom\n\n\ndef _lathe_shell(outer, inner, segments=72, start_cap=\"flat\", end_cap=\"flat\"):\n    geom = LatheGeometry.from_shell_profiles(\n        outer,\n        inner,\n        segments=segments,\n        start_cap=start_cap,\n        end_cap=end_cap,\n        lip_samples=6,\n    )\n    geom.vertices = [(x, z, -y) for (x, y, z) in geom.vertices]\n    return geom\n\n\n# ---------------------------------------------------------------------------\n# Vertical stack (authored metres, will be uniformly rescaled by fit_to_box)\n#   base housing : 0.014 .. 0.190\n#   neck         : 0.185 .. 0.214\n#   grind collar : 0.212 .. 0.241\n#   hopper       : 0.241 .. 0.344\n#   lid          : 0.344 .. ~0.379\n# ---------------------------------------------------------------------------\n\nNECK_BASE_Y = 0.185\nCOLLAR_BASE_Y = 0.212\nCOLLAR_H = 0.029\nHOPPER_BASE_Y = 0.241\nHOPPER_H = 0.103\nLID_BASE_Y = HOPPER_BASE_Y + HOPPER_H  # 0.344\nDIAL_ORIGIN = (0.0, 0.115, 0.077)\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"coffee_grinder\")\n\n    mat_body = model.material(\"body_black\", rgba=(0.105, 0.105, 0.115, 1.0))\n    mat_base = model.material(\"base_black\", rgba=(0.045, 0.045, 0.050, 1.0))\n    mat_collar = model.material(\"collar_metal\", rgba=(0.235, 0.235, 0.255, 1.0))\n    mat_hopper = model.material(\"hopper_smoke\", rgba=(0.135, 0.115, 0.100, 1.0))\n    mat_lid = model.material(\"lid_black\", rgba=(0.075, 0.075, 0.085, 1.0))\n    mat_steel = model.material(\"brushed_steel\", rgba=(0.460, 0.470, 0.490, 1.0))\n    mat_knob = model.material(\"knob_black\", rgba=(0.095, 0.095, 0.105, 1.0))\n\n    # ------------------------------------------------------------------\n    # Root body: base, housing shell, neck, dispenser front, spout, fork\n    # ------------------------------------------------------------------\n    body = model.part(\"body\")\n\n    body.visual(\n        Box((0.142, 0.018, 0.162)),\n        origin=Origin(xyz=(0.0, 0.009, 0.010)),\n        material=mat_base,\n        name=\"base_plate\",\n    )\n    body.visual(\n        Box((0.100, 0.012, 0.052)),\n        origin=Origin(xyz=(0.0, 0.006, 0.108)),\n        material=mat_base,\n        name=\"front_tray\",\n    )\n\n    # Tapered housing (rounded superellipse cross sections lofted along +Y).\n    housing_sections = [\n        (0.014, -0.060, 0.068, 0.120),\n        (0.055, -0.062, 0.070, 0.126),\n        (0.120, -0.060, 0.068, 0.126),\n        (0.165, -0.054, 0.062, 0.116),\n        (0.190, -0.046, 0.052, 0.094),\n    ]\n    housing = superellipse_side_loft(\n        housing_sections, exponents=3.4, segments=52, cap=True, closed=True\n    )\n    body.visual(\n        mesh_from_geometry(housing, \"body_housing\"),\n        material=mat_body,\n        name=\"housing\",\n    )\n\n    # Narrowing neck between body and grind collar.\n    neck = _lathe_solid(\n        [(0.0, 0.0), (0.050, 0.0), (0.043, COLLAR_BASE_Y - NECK_BASE_Y), (0.0, COLLAR_BASE_Y - NECK_BASE_Y)],\n        segments=56,\n    )\n    neck.translate(0.0, NECK_BASE_Y, 0.0)\n    body.visual(\n        mesh_from_geometry(neck, \"neck\"),\n        material=mat_body,\n        name=\"neck\",\n    )\n\n    # Recessed dispenser block on the front (frame with a through opening).\n    outer = rounded_rect_profile(0.100, 0.078, 0.010, corner_segments=4)\n    opening = rounded_rect_profile(0.066, 0.054, 0.008, corner_segments=4)\n    frame = ExtrudeWithHolesGeometry(outer, [opening], 0.038, center=False)\n    frame.translate(0.0, 0.128, 0.050)\n    body.visual(\n        mesh_from_geometry(frame, \"dispenser_frame\"),\n        material=mat_body,\n        name=\"dispenser_frame\",\n    )\n\n    # Grounds spout hanging inside the opening.\n    spout = _lathe_solid(\n        [(0.0, 0.0), (0.006, 0.0), (0.016, 0.022), (0.017, 0.028), (0.0, 0.028)],\n        segments=40,\n    )\n    spout.translate(0.0, 0.125, 0.072)\n    body.visual(\n        mesh_from_geometry(spout, \"spout\"),\n        material=mat_steel,\n        name=\"spout\",\n    )\n\n    # Portafilter fork prongs.\n    for i, x in enumerate((0.024, -0.024)):\n        body.visual(\n            Box((0.010, 0.010, 0.075)),\n            origin=Origin(xyz=(x, 0.100, 0.0975)),\n            material=mat_steel,\n            name=f\"fork_prong_{i}\",\n        )\n\n    # Boss the dosing dial mounts onto (flat front face at z = 0.077).\n    body.visual(\n        Cylinder(radius=0.016, length=0.030),\n        origin=Origin(xyz=(0.0, DIAL_ORIGIN[1], 0.062)),\n        material=mat_body,\n        name=\"dial_boss\",\n    )\n\n    # ------------------------------------------------------------------\n    # Grind adjustment collar (rotates about the vertical axis)\n    # ------------------------------------------------------------------\n    collar = model.part(\"grind_collar\")\n    collar_outer = [\n        (0.053, 0.000),\n        (0.055, 0.005),\n        (0.052, 0.010),\n        (0.055, 0.015),\n        (0.052, 0.020),\n        (0.054, 0.025),\n        (0.052, 0.029),\n    ]\n    collar_inner = [\n        (0.043, 0.000),\n        (0.043, 0.005),\n        (0.043, 0.010),\n        (0.043, 0.015),\n        (0.043, 0.020),\n        (0.043, 0.025),\n        (0.043, 0.029),\n    ]\n    collar_mesh = _lathe_shell(collar_outer, collar_inner, segments=64)\n    collar.visual(\n        mesh_from_geometry(collar_mesh, \"grind_collar\"),\n        material=mat_collar,\n        name=\"collar_ring\",\n    )\n    collar.visual(\n        Box((0.008, 0.007, 0.018)),\n        origin=Origin(xyz=(0.0, 0.0145, 0.055)),\n        material=mat_steel,\n        name=\"collar_pointer\",\n    )\n\n    # ------------------------------------------------------------------\n    # Hopper (hollow, translucent smoke plastic) + metal rim band\n    # ------------------------------------------------------------------\n    hopper = model.part(\"hopper\")\n    hop_outer = [\n        (0.050, 0.000),\n        (0.052, 0.012),\n        (0.058, 0.035),\n        (0.068, 0.070),\n        (0.075, 0.095),\n        (0.075, 0.103),\n    ]\n    hop_inner = [\n        (0.044, 0.000),\n        (0.047, 0.012),\n        (0.054, 0.035),\n        (0.064, 0.070),\n        (0.071, 0.095),\n        (0.071, 0.103),\n    ]\n    hopper_mesh = _lathe_shell(hop_outer, hop_inner, segments=72)\n    hopper.visual(\n        mesh_from_geometry(hopper_mesh, \"hopper_shell\"),\n        material=mat_hopper,\n        name=\"hopper_shell\",\n    )\n    rim_band = _lathe_shell(\n        [(0.078, 0.086), (0.078, 0.094)],\n        [(0.073, 0.086), (0.073, 0.094)],\n        segments=72,\n    )\n    hopper.visual(\n        mesh_from_geometry(rim_band, \"hopper_rim\"),\n        material=mat_steel,\n        name=\"hopper_rim\",\n    )\n\n    # ------------------------------------------------------------------\n    # Lid (domed disc with a knob) - lifts straight up\n    # ------------------------------------------------------------------\n    lid = model.part(\"lid\")\n    lid_profile = [\n        (0.000, 0.000),\n        (0.078, 0.000),\n        (0.080, 0.003),\n        (0.080, 0.008),\n        (0.062, 0.012),\n        (0.032, 0.017),\n        (0.014, 0.020),\n        (0.000, 0.021),\n    ]\n    lid_mesh = _lathe_solid(lid_profile, segments=64)\n    knob = _lathe_solid(\n        [(0.0, 0.0), (0.011, 0.0), (0.011, 0.010), (0.008, 0.013), (0.0, 0.014)],\n        segments=40,\n    )\n    knob.translate(0.0, 0.021, 0.0)\n    lid_mesh.merge(knob)\n    lid.visual(\n        mesh_from_geometry(lid_mesh, \"lid_shell\"),\n        material=mat_lid,\n        name=\"lid_shell\",\n    )\n\n    # ------------------------------------------------------------------\n    # Dosing dial on the front face (rotates about +z)\n    # ------------------------------------------------------------------\n    dial = model.part(\"dose_knob\")\n    dial_geom = KnobGeometry(\n        0.028,\n        0.020,\n        body_style=\"cylindrical\",\n        grip=KnobGrip(style=\"knurled\", count=28, depth=0.0006),\n        bore=KnobBore(style=\"round\", diameter=0.006),\n        center=False,\n    )\n    dial.visual(\n        mesh_from_geometry(dial_geom, \"dose_knob\"),\n        material=mat_knob,\n        name=\"dial_cap\",\n    )\n\n    # ------------------------------------------------------------------\n    # Articulations (all parented directly to the root body)\n    # ------------------------------------------------------------------\n    collar_joint = model.articulation(\n        \"body_to_grind_collar\",\n        ArticulationType.REVOLUTE,\n        parent=body,\n        child=collar,\n        origin=Origin(xyz=(0.0, COLLAR_BASE_Y, 0.0)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(effort=3.0, velocity=2.0, lower=-0.5, upper=0.5),\n    )\n\n    model.articulation(\n        \"body_to_hopper\",\n        ArticulationType.FIXED,\n        parent=body,\n        child=hopper,\n        origin=Origin(xyz=(0.0, HOPPER_BASE_Y, 0.0)),\n    )\n\n    lid_joint = model.articulation(\n        \"body_to_lid\",\n        ArticulationType.PRISMATIC,\n        parent=body,\n        child=lid,\n        origin=Origin(xyz=(0.0, LID_BASE_Y, 0.0)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(effort=20.0, velocity=0.3, lower=0.0, upper=0.010),\n    )\n\n    dial_joint = model.articulation(\n        \"body_to_dose_knob\",\n        ArticulationType.REVOLUTE,\n        parent=body,\n        child=dial,\n        origin=Origin(xyz=DIAL_ORIGIN),\n        axis=(0.0, 0.0, 1.0),\n        motion_limits=MotionLimits(effort=0.5, velocity=5.0, lower=-1.2, upper=1.2),\n    )\n\n    model = fit_to_box(model, (0.22, 0.205, 0.28), (0.17, 0.4, 0.2))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n\n    body = object_model.get_part(\"body\")\n    collar = object_model.get_part(\"grind_collar\")\n    hopper = object_model.get_part(\"hopper\")\n    lid = object_model.get_part(\"lid\")\n    dial = object_model.get_part(\"dose_knob\")\n\n    collar_joint = object_model.get_articulation(\"body_to_grind_collar\")\n    lid_joint = object_model.get_articulation(\"body_to_lid\")\n\n    # Support / seating interfaces.\n    ctx.expect_contact(collar, body, contact_tol=1e-3, name=\"grind collar seats on neck\")\n    ctx.expect_contact(hopper, collar, contact_tol=1e-3, name=\"hopper seats on collar\")\n    ctx.expect_contact(lid, hopper, contact_tol=2e-3, name=\"lid seats on hopper rim\")\n    ctx.expect_contact(dial, body, contact_tol=1e-3, name=\"dose dial mounts on boss\")\n\n    # Hopper sits centred above the body and below the lid.\n    ctx.expect_overlap(hopper, body, axes=\"xy\", min_overlap=0.02, name=\"hopper centred over body\")\n\n    # Lid lifts upward when actuated.\n    with ctx.pose({lid_joint: 0.0}):\n        rest_lid = ctx.part_world_position(lid)\n    with ctx.pose({lid_joint: lid_joint.motion_limits.upper}):\n        lifted_lid = ctx.part_world_position(lid)\n    ctx.check(\n        \"lid lifts upward\",\n        rest_lid is not None\n        and lifted_lid is not None\n        and lifted_lid[1] > rest_lid[1] + 0.005,\n        details=f\"rest={rest_lid}, lifted={lifted_lid}\",\n    )\n\n    # Grind collar rotates about the vertical axis (pointer swings sideways).\n    rest_box = ctx.part_element_world_aabb(collar, elem=\"collar_pointer\")\n    with ctx.pose({collar_joint: 0.4}):\n        turned_box = ctx.part_element_world_aabb(collar, elem=\"collar_pointer\")\n    moved = False\n    if rest_box is not None and turned_box is not None:\n        rest_cx = 0.5 * (rest_box[0][0] + rest_box[1][0])\n        turned_cx = 0.5 * (turned_box[0][0] + turned_box[1][0])\n        moved = abs(turned_cx - rest_cx) > 0.005\n    ctx.check(\"grind collar rotates\", moved, details=f\"rest={rest_box}, turned={turned_box}\")\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
