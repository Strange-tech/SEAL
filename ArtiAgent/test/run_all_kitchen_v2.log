[round 4] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Material,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_geometry,\n    tube_from_spline_points,\n)\n\nTAU = 2.0 * math.pi\n\n\n# ----------------------------------------------------------------------------\n# helpers\n# ----------------------------------------------------------------------------\ndef _revolve(points, segments=128) -> MeshGeometry:\n    \"\"\"Revolve a closed (radius, height) polygon around the +Y axis.\n\n    The polygon must be authored clockwise in the (r, h) plane so the generated\n    normals point outward (outer wall traversed bottom -> top, top rim inward,\n    inner wall top -> bottom, bottom face outward).  Points on the axis (r == 0)\n    are collapsed into a single shared apex vertex.\n    \"\"\"\n    verts: list[tuple[float, float, float]] = []\n    faces: list[tuple[int, int, int]] = []\n    rings: list[list[int]] = []\n\n    for (r, h) in points:\n        if r <= 1e-9:\n            idx = len(verts)\n            verts.append((0.0, float(h), 0.0))\n            rings.append([idx] * segments)\n        else:\n            ring = []\n            for k in range(segments):\n                a = TAU * k / segments\n                ring.append(len(verts))\n                verts.append((r * math.cos(a), float(h), r * math.sin(a)))\n            rings.append(ring)\n\n    n = len(rings)\n    for i in range(n):\n        A = rings[i]\n        B = rings[(i + 1) % n]\n        for k in range(segments):\n            k2 = (k + 1) % segments\n            a0, a1 = A[k], A[k2]\n            b0, b1 = B[k], B[k2]\n            if a0 == a1 and b0 == b1:\n                continue\n            if a0 == a1:\n                faces.append((a0, b0, b1))\n            elif b0 == b1:\n                faces.append((a0, b0, a1))\n            else:\n                faces.append((a0, b0, b1))\n                faces.append((a0, b1, a1))\n\n    return MeshGeometry(vertices=verts, faces=faces)\n\n\n# ----------------------------------------------------------------------------\n# profiles\n# ----------------------------------------------------------------------------\n# Carafe: 0.140 m tall tapered glass server, ~0.110 m max diameter, narrow\n# neck with a collar and a flared flat lipped mouth.\nCARAFE_PROFILE = [\n    # outer wall, bottom -> rim\n    (0.0500, 0.0000),\n    (0.0522, 0.0018),\n    (0.0542, 0.0080),\n    (0.0550, 0.0300),\n    (0.0545, 0.0550),\n    (0.0512, 0.0750),\n    (0.0458, 0.0920),\n    (0.0402, 0.1040),\n    (0.0396, 0.1120),\n    (0.0412, 0.1165),\n    (0.0398, 0.1230),\n    (0.0400, 0.1310),\n    (0.0430, 0.1350),\n    (0.0448, 0.1380),\n    (0.0448, 0.1395),\n    # flat rim, inward\n    (0.0415, 0.1395),\n    # inner wall, rim -> bottom\n    (0.0385, 0.1370),\n    (0.0370, 0.1310),\n    (0.0368, 0.1230),\n    (0.0382, 0.1165),\n    (0.0366, 0.1120),\n    (0.0372, 0.1040),\n    (0.0425, 0.0920),\n    (0.0480, 0.0750),\n    (0.0515, 0.0550),\n    (0.0520, 0.0300),\n    (0.0510, 0.0080),\n    (0.0470, 0.0055),\n    # inner floor to the axis, then underside punt back out\n    (0.0000, 0.0020),\n]\n\n# coffee inside the carafe (dark), slightly proud of the inner glass wall so it\n# reads as a filled body of liquid in contact with the glass\nCOFFEE_PROFILE = [\n    (0.0000, 0.0040),\n    (0.0457, 0.0080),\n    (0.0523, 0.0300),\n    (0.0518, 0.0550),\n    (0.0483, 0.0750),\n    (0.0428, 0.0920),\n    (0.0392, 0.1010),\n    (0.0000, 0.1010),\n]\n\n# Dripper (V60-style cone): flat seating flange at the bottom of the cone.\nFLANGE_PROFILE = [\n    (0.0578, 0.1395),\n    (0.0586, 0.1420),\n    (0.0572, 0.1434),\n    (0.0128, 0.1434),\n    (0.0128, 0.1395),\n]\n\n# cone shell with a short stem dropping through the flange into the neck\nCONE_PROFILE = [\n    (0.0080, 0.1148),\n    (0.0126, 0.1350),\n    (0.0142, 0.1432),\n    (0.0512, 0.2115),\n    (0.0486, 0.2122),\n    (0.0484, 0.2092),\n    (0.0116, 0.1438),\n    (0.0100, 0.1350),\n    (0.0054, 0.1148),\n]\n\n# white paper filter inside the cone, draping over the rim\nFILTER_PROFILE = [\n    (0.0045, 0.1560),\n    (0.0470, 0.2100),\n    (0.0562, 0.2262),\n    (0.0572, 0.2332),\n    (0.0556, 0.2332),\n    (0.0540, 0.2262),\n    (0.0456, 0.2100),\n    (0.0030, 0.1560),\n]\n\n# wet coffee bed sitting in the paper filter\nBED_PROFILE = [\n    (0.0000, 0.1565),\n    (0.0085, 0.1565),\n    (0.0325, 0.1950),\n    (0.0000, 0.1950),\n]\n\n# glass loop handle on the -X side, anchored into the body wall and the neck\nHANDLE_PATH = [\n    (-0.0495, 0.0480, 0.0),\n    (-0.0640, 0.0520, 0.0),\n    (-0.0765, 0.0640, 0.0),\n    (-0.0815, 0.0800, 0.0),\n    (-0.0790, 0.0960, 0.0),\n    (-0.0680, 0.1080, 0.0),\n    (-0.0510, 0.1140, 0.0),\n    (-0.0355, 0.1160, 0.0),\n]\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"coffee_carafe_with_dripper\")\n\n    glass = Material(name=\"clear_glass\", rgba=(0.82, 0.88, 0.90, 0.42))\n    coffee = Material(name=\"coffee\", rgba=(0.13, 0.06, 0.03, 1.0))\n    paper = Material(name=\"filter_paper\", rgba=(0.95, 0.94, 0.89, 1.0))\n    wet_grounds = Material(name=\"coffee_bed\", rgba=(0.24, 0.14, 0.08, 1.0))\n\n    # ---------------- carafe (root) ----------------\n    carafe = model.part(\"carafe\")\n    carafe.visual(\n        mesh_from_geometry(_revolve(CARAFE_PROFILE), \"carafe_body\"),\n        origin=Origin(),\n        material=glass,\n        name=\"carafe_body\",\n    )\n    carafe.visual(\n        mesh_from_geometry(_revolve(COFFEE_PROFILE), \"carafe_coffee\"),\n        origin=Origin(),\n        material=coffee,\n        name=\"carafe_coffee\",\n    )\n    handle = tube_from_spline_points(\n        HANDLE_PATH,\n        radius=0.0043,\n        samples_per_segment=10,\n        radial_segments=14,\n        cap_ends=True,\n    )\n    carafe.visual(\n        mesh_from_geometry(handle, \"carafe_handle\"),\n        origin=Origin(),\n        material=glass,\n        name=\"carafe_handle\",\n    )\n\n    # ---------------- dripper (lifts off the carafe) ----------------\n    dripper = model.part(\"dripper\")\n    dripper.visual(\n        mesh_from_geometry(_revolve(FLANGE_PROFILE), \"dripper_flange\"),\n        origin=Origin(),\n        material=glass,\n        name=\"dripper_flange\",\n    )\n    dripper.visual(\n        mesh_from_geometry(_revolve(CONE_PROFILE), \"dripper_cone\"),\n        origin=Origin(),\n        material=glass,\n        name=\"dripper_cone\",\n    )\n    dripper.visual(\n        mesh_from_geometry(_revolve(FILTER_PROFILE), \"paper_filter\"),\n        origin=Origin(),\n        material=paper,\n        name=\"paper_filter\",\n    )\n    dripper.visual(\n        mesh_from_geometry(_revolve(BED_PROFILE), \"coffee_bed\"),\n        origin=Origin(),\n        material=wet_grounds,\n        name=\"coffee_bed\",\n    )\n\n    model.articulation(\n        \"carafe_to_dripper\",\n        ArticulationType.PRISMATIC,\n        parent=carafe,\n        child=dripper,\n        origin=Origin(xyz=(0.0, 0.1395, 0.0)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(effort=30.0, velocity=0.2, lower=0.0, upper=0.055),\n    )\n\n    model = fit_to_box(model, (-0.17, 0.1135, 0.99), (0.15, 0.145, 0.15))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    carafe = object_model.get_part(\"carafe\")\n    dripper = object_model.get_part(\"dripper\")\n    lift = object_model.get_articulation(\"carafe_to_dripper\")\n\n    # the dripper's flange seats on the carafe's lipped mouth\n    ctx.expect_contact(\n        dripper,\n        carafe,\n        elem_a=\"dripper_flange\",\n        elem_b=\"carafe_body\",\n        contact_tol=5e-4,\n        name=\"dripper flange seats on carafe mouth\",\n    )\n    ctx.expect_gap(\n        dripper,\n        carafe,\n        axis=\"y\",\n        min_gap=-1e-4,\n        max_gap=1e-3,\n        positive_elem=\"dripper_flange\",\n        negative_elem=\"carafe_body\",\n        name=\"dripper flange sits flush on the rim\",\n    )\n    # the dripper is centred over the carafe mouth\n    ctx.expect_overlap(\n        dripper,\n        carafe,\n        axes=\"xz\",\n        elem_a=\"dripper_flange\",\n        elem_b=\"carafe_body\",\n        min_overlap=0.05,\n        name=\"dripper is centred over the carafe\",\n    )\n\n    # lifting the dripper carries it straight up off the neck\n    rest_min_y = ctx.part_element_world_aabb(dripper, elem=\"dripper_flange\")\n    with ctx.pose({lift: 0.03}):\n        lifted = ctx.part_element_world_aabb(dripper, elem=\"dripper_flange\")\n    ctx.check(\n        \"dripper lifts vertically off the carafe\",\n        rest_min_y is not None\n        and lifted is not None\n        and lifted[0][1] > rest_min_y[0][1] + 0.01,\n        details=f\"rest={rest_min_y}, lifted={lifted}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
