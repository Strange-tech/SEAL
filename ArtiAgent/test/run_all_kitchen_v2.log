[round 5] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Material,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_geometry,\n)\n\n# ---------------------------------------------------------------------------\n# Cloth napkin lying on a surface (y-up, +z forward).\n#   * napkin_body  : a thin wavy sheet of cloth (the laid-out napkin).\n#   * folded_corner: the +x/+z corner folded back over the cloth, hinged along\n#     the diagonal crease so it can be lifted / opened.\n# Everything is authored around the origin then fit_to_box recenters + scales.\n# ---------------------------------------------------------------------------\n\nHX = 0.10   # half width  (x)\nHZ = 0.08   # half depth  (z)\nCLOTH_T = 0.0022  # sheet thickness\n\n# crease endpoints for the folded corner (on the +x edge and the +z edge)\nCREASE_A = (HX, 0.0, 0.03)     # on +x edge\nCREASE_B = (0.05, 0.0, HZ)     # on +z edge\nCREASE_M = ((CREASE_A[0] + CREASE_B[0]) * 0.5 + 0.0,\n            0.002,\n            (CREASE_A[2] + CREASE_B[2]) * 0.5 + 0.0)  # hinge midpoint, y set below\n\n\ndef body_h(x: float, z: float) -> float:\n    \"\"\"Height field of the crumpled cloth top surface (bare cloth, no thickness).\"\"\"\n    wx = max(0.0, 1.0 - (x / HX) ** 2)\n    wz = max(0.0, 1.0 - (z / HZ) ** 2)\n    p = wx * wz\n    h = (\n        0.012 * p\n        + 0.0040 * p * math.cos(2.0 * math.pi * z / (2.0 * HZ) + 0.8)\n        + 0.0035 * p * math.cos(2.0 * math.pi * x / (2.0 * HX) + 2.0)\n        + 0.0020 * p * math.sin(3.0 * math.pi * z / (2.0 * HZ) + 1.0)\n        + 0.0016 * p * math.sin(2.0 * math.pi * x / (2.0 * HX) - 0.4) * math.cos(2.0 * math.pi * z / (2.0 * HZ) + 1.7)\n    )\n    return max(0.0, h)\n\n\ndef build_body_geometry() -> MeshGeometry:\n    nx, nz = 52, 44\n    geom = MeshGeometry()\n    top = [[0] * (nz + 1) for _ in range(nx + 1)]\n    bot = [[0] * (nz + 1) for _ in range(nx + 1)]\n    for i in range(nx + 1):\n        x = -HX + 2.0 * HX * i / nx\n        for j in range(nz + 1):\n            z = -HZ + 2.0 * HZ * j / nz\n            h = body_h(x, z)\n            top[i][j] = geom.add_vertex(x, h + CLOTH_T, z)\n            bot[i][j] = geom.add_vertex(x, h, z)\n\n    # top surface (+y)\n    for i in range(nx):\n        for j in range(nz):\n            geom.add_face(top[i][j], top[i + 1][j], top[i + 1][j + 1])\n            geom.add_face(top[i][j], top[i + 1][j + 1], top[i][j + 1])\n    # bottom surface (-y)\n    for i in range(nx):\n        for j in range(nz):\n            geom.add_face(bot[i][j], bot[i][j + 1], bot[i + 1][j + 1])\n            geom.add_face(bot[i][j], bot[i + 1][j + 1], bot[i + 1][j])\n    # perimeter walls\n    for i in range(nx):\n        geom.add_face(top[i][0], bot[i][0], bot[i + 1][0])\n        geom.add_face(top[i][0], bot[i + 1][0], top[i + 1][0])\n        geom.add_face(top[i][nz], top[i + 1][nz], bot[i + 1][nz])\n        geom.add_face(top[i][nz], bot[i + 1][nz], bot[i][nz])\n    for j in range(nz):\n        geom.add_face(top[0][j], top[0][j + 1], bot[0][j + 1])\n        geom.add_face(top[0][j], bot[0][j + 1], bot[0][j])\n        geom.add_face(top[nx][j], bot[nx][j], bot[nx][j + 1])\n        geom.add_face(top[nx][j], bot[nx][j + 1], top[nx][j + 1])\n    return geom\n\n\ndef build_flap_geometry() -> MeshGeometry:\n    \"\"\"Rounded triangular corner cloth, built in the child-local frame.\n\n    Local frame: hinge edge lies along local z (x=0), the free apex points to\n    local -x and is pre-tilted up so the corner reads as a lifted fold.\n    \"\"\"\n    outline = [\n        (0.0, -0.033),\n        (-0.011, -0.026),\n        (-0.024, -0.011),\n        (-0.031, 0.0),\n        (-0.024, 0.011),\n        (-0.011, 0.026),\n        (0.0, 0.033),\n    ]\n    t2 = 0.0009\n    geom = MeshGeometry()\n    n = len(outline)\n    vtop = [geom.add_vertex(x, t2, z) for (x, z) in outline]\n    vbot = [geom.add_vertex(x, -t2, z) for (x, z) in outline]\n    cx = sum(p[0] for p in outline) / n\n    cz = sum(p[1] for p in outline) / n\n    ct = geom.add_vertex(cx, t2, cz)\n    cb = geom.add_vertex(cx, -t2, cz)\n    for k in range(n):\n        k2 = (k + 1) % n\n        geom.add_face(ct, vtop[k], vtop[k2])\n        geom.add_face(cb, vbot[k2], vbot[k])\n        geom.add_face(vtop[k], vbot[k], vbot[k2])\n        geom.add_face(vtop[k], vbot[k2], vtop[k2])\n\n    # bake a lift about the local z (crease) axis; negative angle raises the apex\n    alpha0 = -0.42\n    ca, sa = math.cos(alpha0), math.sin(alpha0)\n    geom.vertices = [\n        (x * ca - y * sa, x * sa + y * ca, z) for (x, y, z) in geom.vertices\n    ]\n    return geom\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"cloth_napkin\")\n    cloth = Material(name=\"napkin_cloth\", rgba=(0.88, 0.86, 0.81, 1.0))\n    crease_shade = Material(name=\"crease_shadow\", rgba=(0.80, 0.78, 0.73, 1.0))\n\n    body = model.part(\"napkin_body\")\n    body.visual(\n        mesh_from_geometry(build_body_geometry(), \"napkin_sheet\"),\n        origin=Origin(),\n        material=cloth,\n        name=\"napkin_sheet\",\n    )\n\n    flap = model.part(\"folded_corner\")\n    flap.visual(\n        mesh_from_geometry(build_flap_geometry(), \"corner_cloth\"),\n        origin=Origin(),\n        material=crease_shade,\n        name=\"corner_cloth\",\n    )\n\n    model.articulation(\n        \"body_to_corner\",\n        ArticulationType.REVOLUTE,\n        parent=body,\n        child=flap,\n        origin=Origin(xyz=CREASE_M, rpy=(0.0, -math.pi / 4.0, 0.0)),\n        axis=(0.0, 0.0, -1.0),\n        motion_limits=MotionLimits(effort=1.0, velocity=1.0, lower=0.0, upper=0.55),\n    )\n\n    model = fit_to_box(model, (0.53, 0.017, 0.5), (0.22, 0.024, 0.16))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    body = object_model.get_part(\"napkin_body\")\n    flap = object_model.get_part(\"folded_corner\")\n    joint = object_model.get_articulation(\"body_to_corner\")\n\n    # The folded corner layers touch the sheet along the crease (cloth on cloth).\n    ctx.allow_overlap(\n        body,\n        flap,\n        reason=\"Folded corner is joined to the napkin along the diagonal crease and the cloth layers touch.\",\n    )\n\n    # The corner is genuinely part of the napkin: its footprint sits over the sheet.\n    ctx.expect_overlap(body, flap, axes=\"xz\", min_overlap=0.02,\n                       name=\"folded corner lies over the napkin\")\n\n    # Positive joint motion lifts the free corner further up off the cloth.\n    rest_aabb = ctx.part_element_world_aabb(flap, elem=\"corner_cloth\")\n    rest_top = rest_aabb[1][1] if rest_aabb is not None else None\n    with ctx.pose({joint: 0.5}):\n        posed_aabb = ctx.part_element_world_aabb(flap, elem=\"corner_cloth\")\n        posed_top = posed_aabb[1][1] if posed_aabb is not None else None\n\n    ctx.check(\n        \"opening the fold lifts the corner upward\",\n        rest_top is not None and posed_top is not None and posed_top > rest_top + 0.002,\n        details=f\"rest_top={rest_top}, posed_top={posed_top}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
