[round 3] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    Material,\n    MeshGeometry,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_geometry,\n)\n\n# ---------------------------------------------------------------------------\n# Authoring parameters (metres, pre fit_to_box).  Y-up, +Z forward convention.\nLENGTH = 0.240      # board span along X\nWIDTH = 0.055       # plank width along Z (front-back)\nTHICK = 0.013       # plank thickness along Y\nEND_RISE = 0.014    # how far the centreline curls up at each end (along +Y)\nROUND_LEN = 0.045   # length of the rounded (domed) end taper at each tip\nEXPONENT = 3.0      # superellipse cross-section exponent (rounded rect)\n\n\ndef _swept_board(\n    length: float,\n    width: float,\n    thick: float,\n    end_rise: float,\n    round_len: float,\n    exponent: float,\n    n_along: int = 96,\n    n_ring: int = 40,\n) -> MeshGeometry:\n    \"\"\"A rounded-rectangular plank swept along X with a parabolic sag and\n    domed (rounded) ends.  Front faces +Z, up is +Y.\"\"\"\n\n    hw = width * 0.5\n    ht = thick * 0.5\n    half_len = length * 0.5\n    p = 2.0 / exponent\n\n    def center_y(x: float) -> float:\n        # dips in the middle, rises toward both ends\n        return end_rise * (2.0 * x / length) ** 2\n\n    def end_factor(x: float) -> float:\n        # 1 in the middle, smoothly domed to 0 at either extreme tip\n        dist = half_len - abs(x)\n        d = min(max(dist / round_len, 0.0), 1.0)\n        return math.sqrt(max(0.0, 1.0 - (1.0 - d) ** 2))\n\n    def shr(c: float) -> float:\n        return math.copysign(abs(c) ** p, c)\n\n    # ring of cross-section offsets (z, y) in the local cross plane\n    ring = []\n    for j in range(n_ring):\n        theta = 2.0 * math.pi * j / n_ring\n        z = hw * shr(math.cos(theta))\n        y = ht * shr(math.sin(theta))\n        ring.append((z, y))\n\n    xs = [-half_len + length * (i / n_along) for i in range(n_along + 1)]\n\n    geom = MeshGeometry()\n    # vertex grid: [i][j]\n    grid = []\n    for x in xs:\n        f = end_factor(x)\n        cy = center_y(x)\n        row = []\n        if f <= 1e-6:\n            # collapse to a single tip vertex\n            idx = geom.add_vertex(x, cy, 0.0)\n            row = [idx] * n_ring\n        else:\n            for (z, y) in ring:\n                idx = geom.add_vertex(x, cy + y * f, z * f)\n                row.append(idx)\n        grid.append(row)\n\n    # side surface\n    for i in range(n_along):\n        row0 = grid[i]\n        row1 = grid[i + 1]\n        if len(set(row0)) == 1 and len(set(row1)) == 1:\n            continue\n        for j in range(n_ring):\n            jn = (j + 1) % n_ring\n            a = row0[j]\n            b = row1[j]\n            c = row1[jn]\n            d = row0[jn]\n            if a != b and c != d:\n                geom.add_face(a, b, c)\n                geom.add_face(a, c, d)\n            elif a == b:  # degenerate first tip\n                geom.add_face(a, c, d)\n            elif c == d:  # degenerate last tip\n                geom.add_face(a, b, c)\n\n    # flat-ish caps at the two ends if the tip did not fully collapse\n    for cap_row, flip in ((grid[0], True), (grid[-1], False)):\n        if len(set(cap_row)) == 1:\n            continue\n        cx = xs[0] if flip else xs[-1]\n        cy = center_y(cx)\n        c = geom.add_vertex(cx, cy, 0.0)\n        for j in range(n_ring):\n            jn = (j + 1) % n_ring\n            if flip:\n                geom.add_face(c, cap_row[j], cap_row[jn])\n            else:\n                geom.add_face(c, cap_row[jn], cap_row[j])\n\n    return geom\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"wooden_board\")\n\n    wood = Material(name=\"warm_wood\", rgba=(0.80, 0.62, 0.42, 1.0))\n\n    board = model.part(\"wooden_board\")\n    geom = _swept_board(LENGTH, WIDTH, THICK, END_RISE, ROUND_LEN, EXPONENT)\n    board.visual(\n        mesh_from_geometry(geom, \"board_body\"),\n        origin=Origin(),\n        material=wood,\n        name=\"board_body\",\n    )\n\n    model = fit_to_box(model, (0.01, 0.019, 0.67), (0.26, 0.028, 0.24))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    board = object_model.get_part(\"wooden_board\")\n\n    aabb = ctx.part_world_aabb(board)\n    if aabb is not None:\n        mn, mx = aabb\n        dx, dy, dz = mx[0] - mn[0], mx[1] - mn[1], mx[2] - mn[2]\n        ctx.check(\n            \"board spans the intended width\",\n            0.20 <= dx <= 0.261,\n            details=f\"width={dx:.4f}\",\n        )\n        ctx.check(\n            \"board is low / thin\",\n            dy <= 0.0281,\n            details=f\"height={dy:.4f}\",\n        )\n        ctx.check(\n            \"board has plausible plank depth\",\n            0.02 <= dz <= 0.09,\n            details=f\"depth={dz:.4f}\",\n        )\n        # ends curl upward: top of the board should reach near the box ceiling\n        # while the mid-board underside sits lower than the ends.\n        ctx.check(\n            \"board seated inside box height range\",\n            mn[1] > 0.0 and mx[1] < 0.035,\n            details=f\"ymin={mn[1]:.4f} ymax={mx[1]:.4f}\",\n        )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
