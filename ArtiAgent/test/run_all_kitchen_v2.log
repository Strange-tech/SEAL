[round 13] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nimport cadquery as cq\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Material,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_cadquery,\n    mesh_from_geometry,\n    superellipse_profile,\n)\n\n# ----------------------------------------------------------------------------\n# Real-world dimensions (metres, authored y-up / +z forward).\n# Planter: square-ish glazed ceramic pot, ~0.20 m tall, ~0.20 m across the rim.\n# ----------------------------------------------------------------------------\nPOT_TOP_Y = 0.196\nSOIL_TOP_Y = 0.168\nSOIL_AXIS_Y = 0.174\n\n\ndef _sq_wire(half_width: float, y_cq: float, segments: int = 64, exponent: float = 3.1):\n    \"\"\"Squarish (superellipse) horizontal loop at a given height, cq z-up frame.\"\"\"\n    profile = superellipse_profile(2.0 * half_width, 2.0 * half_width, exponent, segments=segments)\n    pts = [cq.Vector(x, y, y_cq) for (x, y) in profile]\n    return cq.Wire.makePolygon(pts, close=True)\n\n\ndef _to_y_up(shape):\n    \"\"\"cq z-up -> world y-up (world +y = cq +z, world +z = cq -y).\"\"\"\n    return shape.rotate((0, 0, 0), (1, 0, 0), -90)\n\n\ndef _build_pot_shell():\n    \"\"\"Hollow tapered ceramic pot with a foot ring and a flared lip.\"\"\"\n    outer = cq.Solid.makeLoft(\n        [\n            _sq_wire(0.058, 0.000),\n            _sq_wire(0.072, 0.018),\n            _sq_wire(0.093, 0.150),\n            _sq_wire(0.097, 0.173),\n            _sq_wire(0.102, 0.187),\n            _sq_wire(0.100, 0.196),\n        ],\n        ruled=True,\n    )\n    cavity = cq.Solid.makeLoft(\n        [\n            _sq_wire(0.050, 0.026),\n            _sq_wire(0.078, 0.120),\n            _sq_wire(0.088, 0.190),\n            _sq_wire(0.091, 0.250),\n        ],\n        ruled=True,\n    )\n    shell = outer.cut(cavity)\n    return _to_y_up(shell)\n\n\ndef _build_soil():\n    \"\"\"Soil surface: a low mound inside the rim.\"\"\"\n    soil = cq.Solid.makeLoft(\n        [\n            _sq_wire(0.086, 0.136),\n            _sq_wire(0.081, 0.154),\n            _sq_wire(0.066, SOIL_TOP_Y),\n            _sq_wire(0.040, SOIL_AXIS_Y),\n        ],\n        ruled=False,\n    )\n    return _to_y_up(soil)\n\n\ndef _build_glaze_panel():\n    \"\"\"Dark glazed decorative plaque on the front face of the pot (world +z).\"\"\"\n    # cq frame: front face is -y, so the plaque sits on the -y side.\n    panel = cq.Solid.makeBox(0.104, 0.011, 0.082, cq.Vector(-0.052, -0.086, 0.046))\n    return _to_y_up(panel)\n\n\n# ----------------------------------------------------------------------------\n# Foliage: a leaning stem plus broad, ruffled leaves.\n# Authored in the foliage part frame (origin at the crown, on the soil mound).\n# ----------------------------------------------------------------------------\nSTEM_RINGS = [\n    (-0.030, 0.0135),\n    (0.000, 0.0125),\n    (0.030, 0.0115),\n    (0.062, 0.0105),\n    (0.092, 0.0094),\n    (0.120, 0.0081),\n    (0.144, 0.0066),\n    (0.162, 0.0048),\n    (0.172, 0.0022),\n]\n\n\ndef _stem_axis(y: float) -> tuple[float, float]:\n    \"\"\"Gentle organic lean of the stem centreline.\"\"\"\n    t = max(0.0, min(1.0, (y + 0.030) / 0.202))\n    return (0.014 * t ** 1.8, -0.009 * t ** 1.5)\n\n\ndef _stem_at(y: float) -> tuple[tuple[float, float, float], float]:\n    \"\"\"Interpolated stem centre and radius at local height y.\"\"\"\n    rings = STEM_RINGS\n    if y <= rings[0][0]:\n        r = rings[0][1]\n    elif y >= rings[-1][0]:\n        r = rings[-1][1]\n    else:\n        r = rings[-1][1]\n        for (y0, r0), (y1, r1) in zip(rings, rings[1:]):\n            if y0 <= y <= y1:\n                f = (y - y0) / (y1 - y0)\n                r = r0 + (r1 - r0) * f\n                break\n    cx, cz = _stem_axis(y)\n    return (cx, y, cz), r\n\n\ndef _build_stem_mesh(segments: int = 12) -> MeshGeometry:\n    geom = MeshGeometry()\n    rings_idx = []\n    for y, radius in STEM_RINGS:\n        cx, cz = _stem_axis(y)\n        ring = []\n        for k in range(segments):\n            a = 2.0 * math.pi * k / segments\n            ring.append(geom.add_vertex(cx + radius * math.cos(a), y, cz + radius * math.sin(a)))\n        rings_idx.append(ring)\n\n    for lower, upper in zip(rings_idx, rings_idx[1:]):\n        for k in range(segments):\n            k2 = (k + 1) % segments\n            a, b = lower[k], lower[k2]\n            c, d = upper[k2], upper[k]\n            geom.add_face(a, b, c)\n            geom.add_face(a, c, d)\n\n    # root end cap (buried) and tip cap\n    bottom_c = geom.add_vertex(*_stem_at(STEM_RINGS[0][0])[0])\n    for k in range(segments):\n        k2 = (k + 1) % segments\n        geom.add_face(bottom_c, rings_idx[0][k2], rings_idx[0][k])\n    top_c = geom.add_vertex(*_stem_at(STEM_RINGS[-1][0])[0])\n    for k in range(segments):\n        k2 = (k + 1) % segments\n        geom.add_face(top_c, rings_idx[-1][k], rings_idx[-1][k2])\n    return geom\n\n\ndef _leaf_surface(base, theta, length, width, rise, phase, thick, nu, nv):\n    \"\"\"Build a thin ruffled leaf blade attached at ``base`` pointing at ``theta``.\"\"\"\n    dx, dz = math.cos(theta), math.sin(theta)\n    lx, lz = math.sin(theta), -math.cos(theta)\n    bx, by, bz = base\n    verts: list[tuple[float, float, float]] = []\n    faces: list[tuple[int, int, int]] = []\n\n    def add(p):\n        verts.append(p)\n        return len(verts) - 1\n\n    def point(t, v, off):\n        c_y = by + rise * math.sin(math.pi * 0.5 * t) - 0.030 * rise * t * t\n        c_x = bx + dx * (length * t)\n        c_z = bz + dz * (length * t)\n        w = max(width * math.sin(math.pi * t ** 0.8) ** 0.75, 0.004)\n        cup = -0.34 * (v * v) * w\n        ripple = 0.42 * (v ** 6) * w * math.sin(2.0 * math.pi * 2.2 * t + phase)\n        side = 0.16 * (v ** 3) * w * math.sin(2.0 * math.pi * 1.7 * t + phase * 1.4)\n        px = c_x + lx * (v * w + side)\n        pz = c_z + lz * (v * w + side)\n        py = c_y + cup + ripple + off\n        return (px, py, pz)\n\n    base_idx = add(base)\n    top = [[base_idx] * (nv + 1) for _ in range(nu + 1)]\n    bot = [[base_idx] * (nv + 1) for _ in range(nu + 1)]\n    for i in range(1, nu + 1):\n        t = i / nu\n        for j in range(nv + 1):\n            v = -1.0 + 2.0 * j / nv\n            top[i][j] = add(point(t, v, 0.0))\n            bot[i][j] = add(point(t, v, -thick))\n\n    def quad(a, b, c, d):\n        if a == d:\n            faces.append((a, b, c))\n        elif a == b:\n            faces.append((a, c, d))\n        elif b == c:\n            faces.append((a, b, d))\n        else:\n            faces.append((a, b, c))\n            faces.append((a, c, d))\n\n    for i in range(nu):\n        for j in range(nv):\n            quad(top[i][j], top[i + 1][j], top[i + 1][j + 1], top[i][j + 1])\n            quad(bot[i][j], bot[i][j + 1], bot[i + 1][j + 1], bot[i + 1][j])\n    for i in range(nu):\n        quad(top[i][0], top[i + 1][0], bot[i + 1][0], bot[i][0])\n        quad(top[i][nv], bot[i][nv], bot[i + 1][nv], top[i + 1][nv])\n    for j in range(nv):\n        quad(top[nu][j], top[nu][j + 1], bot[nu][j + 1], bot[nu][j])\n\n    geom = MeshGeometry(vertices=verts, faces=faces)\n    return geom\n\n\n# (azimuth deg, attach height, length, width, rise, phase, thickness)\nLEAVES = [\n    (18.0, 0.098, 0.185, 0.086, 0.095, 0.0, 0.0032),\n    (96.0, 0.128, 0.168, 0.079, 0.108, 1.1, 0.0030),\n    (162.0, 0.075, 0.176, 0.089, 0.078, 2.3, 0.0034),\n    (214.0, 0.120, 0.160, 0.075, 0.104, 3.4, 0.0030),\n    (289.0, 0.055, 0.170, 0.083, 0.068, 4.2, 0.0033),\n    (338.0, 0.145, 0.140, 0.066, 0.120, 5.1, 0.0028),\n    (58.0, 0.158, 0.126, 0.058, 0.128, 0.7, 0.0026),\n]\n\n\ndef _leaf_attach(theta: float, y: float):\n    center, radius = _stem_at(y)\n    return (\n        center[0] + (radius - 0.0025) * math.cos(theta),\n        center[1],\n        center[2] + (radius - 0.0025) * math.sin(theta),\n    )\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"potted_plant\")\n\n    ceramic = model.material(\"glazed_ceramic\", rgba=(0.90, 0.88, 0.81, 1.0))\n    dark_glaze = model.material(\"dark_glaze\", rgba=(0.17, 0.16, 0.13, 1.0))\n    soil_mat = model.material(\"potting_soil\", rgba=(0.17, 0.12, 0.09, 1.0))\n    stem_mat = model.material(\"stem_green\", rgba=(0.33, 0.42, 0.17, 1.0))\n    leaf_dark = model.material(\"leaf_deep\", rgba=(0.18, 0.36, 0.12, 1.0))\n    leaf_mid = model.material(\"leaf_mid\", rgba=(0.27, 0.48, 0.16, 1.0))\n    leaf_light = model.material(\"leaf_light\", rgba=(0.40, 0.62, 0.24, 1.0))\n    leaf_mats = [leaf_mid, leaf_dark, leaf_light, leaf_mid, leaf_dark, leaf_light, leaf_mid]\n\n    planter = model.part(\"planter\")\n    planter.visual(\n        mesh_from_cadquery(_build_pot_shell(), \"pot_shell\", tolerance=0.0004, angular_tolerance=0.2),\n        material=ceramic,\n        name=\"pot_shell\",\n    )\n    planter.visual(\n        mesh_from_cadquery(_build_soil(), \"soil_mound\", tolerance=0.0005, angular_tolerance=0.2),\n        material=soil_mat,\n        name=\"soil_mound\",\n    )\n    planter.visual(\n        mesh_from_cadquery(_build_glaze_panel(), \"glaze_panel\", tolerance=0.0004, angular_tolerance=0.2),\n        material=dark_glaze,\n        name=\"glaze_panel\",\n    )\n\n    foliage = model.part(\"foliage\")\n    foliage.visual(\n        mesh_from_geometry(_build_stem_mesh(), \"plant_stem\"),\n        material=stem_mat,\n        name=\"stem\",\n    )\n    for idx, (az, y, length, width, rise, phase, thick) in enumerate(LEAVES):\n        theta = math.radians(az)\n        blade = _leaf_surface(\n            _leaf_attach(theta, y), theta, length, width, rise, phase, thick, nu=18, nv=5\n        )\n        foliage.visual(\n            mesh_from_geometry(blade, f\"leaf_{idx}\"),\n            material=leaf_mats[idx],\n            name=f\"leaf_{idx}\",\n        )\n\n    model.articulation(\n        \"planter_to_foliage\",\n        ArticulationType.REVOLUTE,\n        parent=planter,\n        child=foliage,\n        # Joint sits at the crown, where the stem emerges from the soil mound.\n        origin=Origin(xyz=(0.0, SOIL_TOP_Y, 0.0)),\n        # Positive q bends the plant forward (+z), like the stalk flexing.\n        axis=(1.0, 0.0, 0.0),\n        motion_limits=MotionLimits(effort=4.0, velocity=0.8, lower=-0.13, upper=0.13),\n    )\n\n    model = fit_to_box(model, (0.55, 0.285, 0.23), (0.42, 0.56, 0.36))\n    return model\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    planter = object_model.get_part(\"planter\")\n    foliage = object_model.get_part(\"foliage\")\n    sway = object_model.get_articulation(\"planter_to_foliage\")\n\n    ctx.allow_overlap(\n        planter,\n        foliage,\n        elem_a=\"soil_mound\",\n        elem_b=\"stem\",\n        reason=\"The stem is rooted inside the soil mound, so the lower stem is intentionally buried.\",\n    )\n\n    # Root / support: the plant is seated in the soil and centred in the pot.\n    ctx.expect_contact(planter, foliage, elem_a=\"soil_mound\", elem_b=\"stem\", contact_tol=1e-6,\n                       name=\"stem is rooted in the soil mound\")\n    ctx.expect_overlap(planter, foliage, axes=\"xy\", min_overlap=0.10,\n                       name=\"foliage sits over the planter footprint\")\n    ctx.expect_gap(foliage, planter, axis=\"y\", min_gap=0.20,\n                   name=\"foliage rises well above the planter\")\n\n    rest_aabb = ctx.part_world_aabb(foliage)\n    with ctx.pose({sway: 0.13}):\n        posed_aabb = ctx.part_world_aabb(foliage)\n    ctx.check(\n        \"sway joint bends the plant forward\",\n        rest_aabb is not None and posed_aabb is not None and posed_aabb[1][2] > rest_aabb[1][2] + 0.01,\n        details=f\"rest={rest_aabb}, posed={posed_aabb}\",\n    )\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
