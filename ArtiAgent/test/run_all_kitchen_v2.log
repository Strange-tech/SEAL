[round 4] write_file({"path": "model.py", "content": "from __future__ import annotations\n\nimport math\n\nfrom sdk import (\n    ArticulatedObject,\n    ArticulationType,\n    Box,\n    MeshGeometry,\n    MotionLimits,\n    Origin,\n    TestContext,\n    TestReport,\n    fit_to_box,\n    mesh_from_geometry,\n)\n\nTAU = 2.0 * math.pi\n\n# ---- Dripper cone dimensions (metres, authored in y-up frame) --------------\nH = 0.088          # cone height from seating plane (y=0) to rim (y=H)\nR0 = 0.011         # outer radius at the seating plane\nR1 = 0.061         # outer radius at the rim\nWALL = 0.0022      # wall thickness\nAMP = 0.0015       # flute (rib) radial amplitude\nNFL = 22           # number of ribs\nTWIST = 0.75       # rib spiral twist over the height (radians)\n\nCOFFEE_TOP = 0.065  # fill line of the coffee bed\nCREMA_BOT = 0.056   # bottom of the pale crema band\n\n\ndef _base_r(y: float) -> float:\n    \"\"\"Smooth (un-fluted) outer radius of the cone at height y.\"\"\"\n    return R0 + (R1 - R0) * (y / H)\n\n\ndef _inner_r(y: float) -> float:\n    return _base_r(y) - WALL\n\n\ndef _build_cone_shell() -> MeshGeometry:\n    \"\"\"Hollow, ribbed/fluted cone shell built directly in the y-up frame.\"\"\"\n    ntheta = 144\n    nz = 44\n    verts: list[tuple[float, float, float]] = []\n    faces: list[tuple[int, int, int]] = []\n\n    def addv(x: float, y: float, z: float) -> int:\n        verts.append((x, y, z))\n        return len(verts) - 1\n\n    def quad(a: int, b: int, c: int, d: int) -> None:\n        faces.append((a, b, c))\n        faces.append((a, c, d))\n\n    ys = [H * j / nz for j in range(nz + 1)]\n    OUT = [[None] * ntheta for _ in range(nz + 1)]\n    IN = [[None] * ntheta for _ in range(nz + 1)]\n    for j, y in enumerate(ys):\n        br = _base_r(y)\n        for i in range(ntheta):\n            th = TAU * i / ntheta\n            c, s = math.cos(th), math.sin(th)\n            ro = br + AMP * math.cos(NFL * th + TWIST * (y / H))\n            ri = br - WALL\n            OUT[j][i] = addv(ro * c, y, ro * s)\n            IN[j][i] = addv(ri * c, y, ri * s)\n\n    # outer wall (normal points outward)\n    for j in range(nz):\n        for i in range(ntheta):\n            i1 = (i + 1) % ntheta\n            quad(OUT[j][i], OUT[j + 1][i], OUT[j + 1][i1], OUT[j][i1])\n    # inner wall\n    for j in range(nz):\n        for i in range(ntheta):\n            i1 = (i + 1) % ntheta\n            quad(IN[j][i], IN[j][i1], IN[j + 1][i1], IN[j + 1][i])\n    # top rim band (y = H): joins outer and inner walls\n    j = nz\n    for i in range(ntheta):\n        i1 = (i + 1) % ntheta\n        quad(OUT[j][i], IN[j][i], IN[j][i1], OUT[j][i1])\n    # bottom annulus (y = 0) leaving a central drip hole\n    j = 0\n    for i in range(ntheta):\n        i1 = (i + 1) % ntheta\n        quad(OUT[j][i], OUT[j][i1], IN[j][i1], IN[j][i])\n\n    return MeshGeometry(vertices=verts, faces=faces)\n\n\ndef _build_solid(rfun, y0: float, y1: float, ntheta: int = 96, nlev: int = 18) -> MeshGeometry:\n    \"\"\"Closed solid of revolution (side wall + top/bottom caps) in y-up.\"\"\"\n    verts: list[tuple[float, float, float]] = []\n    faces: list[tuple[int, int, int]] = []\n\n    def addv(x: float, y: float, z: float) -> int:\n        verts.append((x, y, z))\n        return len(verts) - 1\n\n    def tri(a: int, b: int, c: int) -> None:\n        faces.append((a, b, c))\n\n    ys = [y0 + (y1 - y0) * k / nlev for k in range(nlev + 1)]\n    SIDE = [[None] * ntheta for _ in range(nlev + 1)]\n    for k, y in enumerate(ys):\n        r = rfun(y)\n        for i in range(ntheta):\n            th = TAU * i / ntheta\n            SIDE[k][i] = addv(r * math.cos(th), y, r * math.sin(th))\n    ctop = addv(0.0, y1, 0.0)\n    cbot = addv(0.0, y0, 0.0)\n    for k in range(nlev):\n        for i in range(ntheta):\n            i1 = (i + 1) % ntheta\n            tri(SIDE[k][i], SIDE[k][i1], SIDE[k + 1][i1])\n            tri(SIDE[k][i], SIDE[k + 1][i1], SIDE[k + 1][i])\n    for i in range(ntheta):\n        i1 = (i + 1) % ntheta\n        tri(SIDE[nlev][i], ctop, SIDE[nlev][i1])\n        tri(SIDE[0][i1], cbot, SIDE[0][i])\n    return MeshGeometry(vertices=verts, faces=faces)\n\n\ndef _build_ring(ro: float, ri: float, y0: float, y1: float, ntheta: int = 72) -> MeshGeometry:\n    \"\"\"Hollow ring / short tube (annulus caps + inner & outer walls).\"\"\"\n    verts: list[tuple[float, float, float]] = []\n    faces: list[tuple[int, int, int]] = []\n\n    def addv(x: float, y: float, z: float) -> int:\n        verts.append((x, y, z))\n        return len(verts) - 1\n\n    def quad(a: int, b: int, c: int, d: int) -> None:\n        faces.append((a, b, c))\n        faces.append((a, c, d))\n\n    OT, OB, IT, IB = [], [], [], []\n    for i in range(ntheta):\n        th = TAU * i / ntheta\n        c, s = math.cos(th), math.sin(th)\n        OT.append(addv(ro * c, y1, ro * s))\n        OB.append(addv(ro * c, y0, ro * s))\n        IT.append(addv(ri * c, y1, ri * s))\n        IB.append(addv(ri * c, y0, ri * s))\n    for i in range(ntheta):\n        j = (i + 1) % ntheta\n        quad(OT[i], IT[i], IT[j], OT[j])   # top annulus\n        quad(OB[i], OB[j], IB[j], IB[i])   # bottom annulus\n        quad(OB[i], OT[i], OT[j], OB[j])   # outer wall\n        quad(IB[i], IB[j], IT[j], IT[i])   # inner wall\n    return MeshGeometry(vertices=verts, faces=faces)\n\n\ndef build_object_model() -> ArticulatedObject:\n    model = ArticulatedObject(name=\"pour_over_dripper\")\n\n    glass = model.material(\"clear_glass\", rgba=(0.86, 0.90, 0.92, 0.45))\n    grounds_mat = model.material(\"coffee_grounds\", rgba=(0.13, 0.08, 0.05, 1.0))\n    crema_mat = model.material(\"coffee_crema\", rgba=(0.68, 0.54, 0.38, 1.0))\n    base_mat = model.material(\"dripper_base\", rgba=(0.80, 0.80, 0.78, 1.0))\n\n    # --- Root: base foot the whole cone swivels on -------------------------\n    base_foot = model.part(\"base_foot\")\n    base_foot.visual(\n        mesh_from_geometry(_build_ring(ro=0.0135, ri=0.009, y0=-0.007, y1=0.0), \"base_foot\"),\n        material=base_mat,\n        name=\"foot_ring\",\n    )\n\n    # --- Child: the ribbed transparent cone dripper ------------------------\n    cone = model.part(\"dripper_cone\")\n    cone.visual(\n        mesh_from_geometry(_build_cone_shell(), \"dripper_cone_shell\"),\n        material=glass,\n        name=\"cone_shell\",\n    )\n    cone.visual(\n        mesh_from_geometry(\n            _build_solid(lambda y: _inner_r(y) - 0.0003, y0=0.004, y1=CREMA_BOT),\n            \"coffee_grounds\",\n        ),\n        material=grounds_mat,\n        name=\"coffee_grounds\",\n    )\n    cone.visual(\n        mesh_from_geometry(\n            _build_solid(lambda y: _inner_r(y) - 0.0003, y0=CREMA_BOT, y1=COFFEE_TOP),\n            \"coffee_crema\",\n        ),\n        material=crema_mat,\n        name=\"coffee_crema\",\n    )\n    # Small pouring lip / spout on the front (+z) of the rim.\n    cone.visual(\n        Box((0.022, 0.0035, 0.013)),\n        origin=Origin(xyz=(0.0, H - 0.001, R1 + 0.002)),\n        material=glass,\n        name=\"pour_spout\",\n    )\n\n    # Cone swivels on the base foot about the vertical (y) axis.\n    model.articulation(\n        \"foot_to_cone\",\n        ArticulationType.REVOLUTE,\n        parent=base_foot,\n        child=cone,\n        origin=Origin(xyz=(0.0, 0.0, 0.0)),\n        axis=(0.0, 1.0, 0.0),\n        motion_limits=MotionLimits(effort=0.5, velocity=1.0, lower=-math.pi, upper=math.pi),\n    )\n\n    model = fit_to_box(model, (-0.17, 0.2375, 0.99), (0.145, 0.1, 0.145))\n    return model\n\n\ndef _aabb_center(bb):\n    (x0, y0, z0), (x1, y1, z1) = bb\n    return ((x0 + x1) / 2.0, (y0 + y1) / 2.0, (z0 + z1) / 2.0)\n\n\ndef run_tests() -> TestReport:\n    ctx = TestContext(object_model)\n    foot = object_model.get_part(\"base_foot\")\n    cone = object_model.get_part(\"dripper_cone\")\n    swivel = object_model.get_articulation(\"foot_to_cone\")\n\n    with ctx.pose({swivel: 0.0}):\n        ctx.expect_contact(\n            cone, foot, contact_tol=1e-4, name=\"cone seats on base foot\"\n        )\n        ctx.expect_overlap(\n            cone, foot, axes=\"xy\", min_overlap=0.012,\n            name=\"cone is centred over the base foot footprint\",\n        )\n\n    # Prove the swivel actually rotates the cone about the vertical axis.\n    spout_rest = ctx.part_element_world_aabb(cone, elem=\"pour_spout\")\n    with ctx.pose({swivel: math.pi / 2.0}):\n        spout_turn = ctx.part_element_world_aabb(cone, elem=\"pour_spout\")\n        ctx.expect_contact(\n            cone, foot, contact_tol=1e-4, name=\"cone stays seated while swivelled\"\n        )\n    ok = spout_rest is not None and spout_turn is not None\n    if ok:\n        c0 = _aabb_center(spout_rest)\n        c1 = _aabb_center(spout_turn)\n        moved = math.hypot(c0[0] - c1[0], c0[2] - c1[2])\n        ctx.check(\n            \"swivel rotates cone about vertical axis\",\n            moved > 0.02,\n            details=f\"spout rest={c0} turned={c1} moved={moved:.4f}\",\n        )\n    else:\n        ctx.fail(\"swivel rotates cone about vertical axis\", \"missing pour_spout element\")\n\n    return ctx.report()\n\n\nobject_model = build_object_model()\n"})
